+def test_final_identity_loader_accepts_exact_frozen_governance_file() -> None:
+    """Real-artifact regression: the unpatched loader must accept the frozen file."""
+
+    root = Path(__file__).resolve().parents[1]
+    path = root / "governance" / execution.FINAL_IDENTITIES_FILENAME
+    frozen_config = json.loads((root / "config" / "frozen_config.json").read_text())
+    identities = execution.load_frozen_final_identities(path)
+    assert len(identities) == execution.FINAL_IDENTITIES_COUNT == 630
+    assert identities[0] == date(2022, 6, 22)
+    assert identities[-1] == date(2024, 12, 31)
+    assert (
+        session_identity_sha256(identities)
+        == execution.FINAL_IDENTITIES_ORDERED_SHA256
+        == frozen_config["historical_final_session_identities_sha256"]
+        == "423f3ad6a8b398b12700710cdb37584ded4beac091d985118a7ebebf159bf429"
+    )
