+    scientific_config_sha256,
+    verify_protocol_bytes,
+)
+from nexus_nme001.contract import (
+    CANDIDATE_ID,
+    CANDIDATE_VERSION,
+    DWO04_CANDIDATE_ID,
+    DWO04_CANDIDATE_VERSION,
+    DWO04_WORK_ORDER,
+    DWO04_WORK_ORDER_SHA256,
+    PROTOCOL_FILENAME,
+    PROTOCOL_SHA256,
+    PROTOCOL_VERSION,
+    V1_2_1_PROTOCOL_FILENAME,
+    V1_2_1_PROTOCOL_SHA256,
+    V1_2_1_PROTOCOL_VERSION,
+    WORK_ORDER,
+    WORK_ORDER_SHA256,
+)
+from nexus_nme001.final import _run_authorized_final_pipeline
+from nexus_nme001.pipeline import (
+    PipelineError,
+    _run_licensed_fixture_regression_pipeline,
+    run_pipeline,
+)
+from nexus_nme001.report import (
+    AUTHORITY,
+    development_report_identity_for_protocol,
+)
+from nexus_nme001.traceability import (
+    TRACEABILITY,
+    V1_2_1_TRACEABILITY,
+    V1_2_2_TRACEABILITY,
+    traceability_for_protocol,
+    validate_traceability,
+)
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ACTIVE_CONFIG = ROOT / "config" / "frozen_config.json"
+V121_CONFIG = ROOT / "config" / "frozen_config_v1_2_1.json"
+ACTIVE_PROTOCOL = ROOT / "governance" / PROTOCOL_FILENAME
+V121_PROTOCOL = ROOT / "governance" / V1_2_1_PROTOCOL_FILENAME
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def test_v122_active_and_v121_historical_identities_are_exact() -> None:
+    assert nexus_nme001.WORK_ORDER == WORK_ORDER == "NME-001-DWO-05"
+    assert WORK_ORDER_SHA256 == (
+        "38de0b5f369c15c524657ca5052b73d9ce7d9525d7e3c8cfc31d4ea7e503699c"
+    )
+    assert CANDIDATE_ID == "NME001-DWO-05-CANDIDATE"
+    assert CANDIDATE_VERSION == nexus_nme001.__version__ == "0.3.2"
+    assert PROTOCOL_VERSION == "1.2.2"
+    assert PROTOCOL_FILENAME == "NEXUS_MARKET_EXPERIMENT_001_v1_2_2.md"
+    assert PROTOCOL_SHA256 == (
+        "3e2ba3ef02fcf105eac2abd32248db694c3a22f9f43841f6dbf3cf06f9922d50"
+    )
+
+    assert DWO04_WORK_ORDER == "NME-001-DWO-04"
+    assert DWO04_WORK_ORDER_SHA256 == (
+        "f5feb728d513c9bb827bb436000ac68d56f0fea395fd6593c778a21cafc54cba"
+    )
+    assert DWO04_CANDIDATE_ID == "NME001-DWO-04-CANDIDATE"
+    assert DWO04_CANDIDATE_VERSION == "0.3.1"
+    assert V1_2_1_PROTOCOL_VERSION == "1.2.1"
+    assert V1_2_1_PROTOCOL_FILENAME == "NEXUS_MARKET_EXPERIMENT_001_v1_2_1.md"
+    assert V1_2_1_PROTOCOL_SHA256 == (
+        "df1b7f3eec85f8d0e0f6c8f9c2237713a3bf6207987e65195e42ac881e1060cb"
+    )
+
+    active_identity = development_report_identity_for_protocol(PROTOCOL_SHA256)
+    historical_identity = development_report_identity_for_protocol(
+        V1_2_1_PROTOCOL_SHA256
+    )
+    assert (
+        active_identity.work_order,
+        active_identity.candidate_id,
+        active_identity.candidate_version,
+    ) == (WORK_ORDER, CANDIDATE_ID, CANDIDATE_VERSION)
+    assert (
+        historical_identity.work_order,
+        historical_identity.candidate_id,
+        historical_identity.candidate_version,
+    ) == (DWO04_WORK_ORDER, DWO04_CANDIDATE_ID, DWO04_CANDIDATE_VERSION)
+
+
+def test_v122_and_v121_configs_select_exact_protocol_bytes() -> None:
+    active_raw = json.loads(ACTIVE_CONFIG.read_text(encoding="utf-8"))
+    historical_raw = json.loads(V121_CONFIG.read_text(encoding="utf-8"))
+    assert set(active_raw) == set(historical_raw)
+    assert {
+        key
+        for key in active_raw
+        if active_raw[key] != historical_raw[key]
+    } == {"protocol_sha256"}
+
+    assert _sha256(ACTIVE_PROTOCOL) == PROTOCOL_SHA256
+    assert _sha256(V121_PROTOCOL) == V1_2_1_PROTOCOL_SHA256
+    assert _sha256(V121_CONFIG) == (
+        "a0a0b8a644c5b960a8d9ac548da75e4da47836b4d44f297160cf992ac8daac14"
+    )
+
+    active = load_config(ACTIVE_CONFIG)
+    historical = load_config(V121_CONFIG)
+    assert protocol_filename_for_config(active) == PROTOCOL_FILENAME
+    assert protocol_filename_for_config(historical) == V1_2_1_PROTOCOL_FILENAME
+    assert verify_protocol_bytes(ACTIVE_PROTOCOL) == PROTOCOL_SHA256
+    assert (
+        verify_protocol_bytes(
+            V121_PROTOCOL, expected_sha256=V1_2_1_PROTOCOL_SHA256
+        )
+        == V1_2_1_PROTOCOL_SHA256
+    )
+    assert scientific_config_sha256(active) == (
+        "2bb55a38889c1b5563cd6d6bf7cba3a514fe132b0d1122726a59bf7294340f7e"
+    )
+    assert scientific_config_sha256(historical) == (
+        "f7142dbdf3c31e903785ae602405def5ab609de365357f3115f0df5cb7b43044"
+    )
