+def _verify_archived_governance_and_configs(
+    archive: zipfile.ZipFile,
+    records: Mapping[str, Mapping[str, object]],
+) -> None:
+    exact = {
+        DWO04_PROTOCOL_PATH: DWO04_PROTOCOL_SHA256,
+        DWO04_CONFIG_PATH: DWO04_CONFIG_SHA256,
+        DWO04_LEDGER_PATH: DWO04_LEDGER_SHA256,
+        DWO04_CANDIDATE_PATCH_ARCHIVE_PATH: DWO04_PATCH_SHA256,
+    }
+    for name, expected_sha256 in exact.items():
+        record = records.get(name)
+        if not isinstance(record, Mapping) or record.get("sha256") != expected_sha256:
+            raise ReleaseError(f"accepted DWO-04 foundation identity changed: {name}")
+    try:
+        prior = archive.read(DWO04_PROTOCOL_PATH).decode("utf-8")
+        diff = archive.read(PROTOCOL_DIFF_ARCHIVE_PATH).decode("utf-8")
+        active = archive.read(ACTIVE_PROTOCOL_PATH).decode("utf-8")
+        active_config = json.loads(archive.read("config/frozen_config.json").decode("utf-8"))
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise ReleaseError("DWO-05 protocol/configuration is unreadable") from exc
+    if _apply_unified_diff(prior, diff) != active:
+        raise ReleaseError("v1.2.1-to-v1.2.2 diff does not reconstruct active protocol")
+    if _sha256_bytes(active.encode("utf-8")) != _protocol_sha256():
+        raise ReleaseError("active protocol content hash is invalid")
+    if not isinstance(active_config, dict) or (
+        active_config.get("protocol_sha256") != _protocol_sha256()
+        or active_config.get("stage") != "development"
+        or active_config.get("final_authorization_token_sha256") is not None
+    ):
+        raise ReleaseError("active DWO-05 configuration identity/hold is invalid")
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo05-config-") as temporary:
+        path = Path(temporary) / "frozen_config.json"
+        path.write_bytes(archive.read("config/frozen_config.json"))
+        try:
+            load_config(path)
+        except (ContractError, KeyError, TypeError, ValueError) as exc:
+            raise ReleaseError("active DWO-05 configuration fails contract validation") from exc
