+)
+def test_v122_and_v121_real_development_holds_precede_source(
+    tmp_path: Path, config_path: Path, version: str
+) -> None:
+    arguments = {
+        "stage": "development",
+        "config_path": config_path,
+        "receipt_path": tmp_path / "must_not_read_receipt.json",
+        "raw_path": tmp_path / "must_not_read_raw.csv",
+        "output_dir": tmp_path / f"out-{version}",
+    }
+    with pytest.raises(
+        PipelineError,
+        match=rf"v{version} real-data development authority is HOLD",
+    ):
+        run_pipeline(**arguments)
+    with pytest.raises(
+        PipelineError,
+        match=rf"v{version} real-data development authority is HOLD",
+    ):
+        _run_licensed_fixture_regression_pipeline(**arguments)
+
+
+@pytest.mark.parametrize(
+    ("config_path", "version"),
+    ((ACTIVE_CONFIG, "1.2.2"), (V121_CONFIG, "1.2.1")),
+)
+def test_v122_and_v121_final_holds_precede_source(
+    tmp_path: Path, config_path: Path, version: str
+) -> None:
+    with pytest.raises(
+        PipelineError,
+        match=rf"v{version} final authority is HOLD",
+    ):
+        run_pipeline(
+            stage="final",
+            config_path=config_path,
+            receipt_path=tmp_path / "must_not_read_receipt.json",
+            raw_path=tmp_path / "must_not_read_raw.csv",
+            output_dir=tmp_path / f"public-final-{version}",
+            final_authorization_path=tmp_path / "must_not_read_token",
+        )
+
+    with pytest.raises(
+        ValueError,
+        match=rf"v{version} final authority is HOLD",
+    ):
+        _run_authorized_final_pipeline(
+            config_path=config_path,
+            authorization_token_path=tmp_path / "must_not_read_token",
+            receipt_path=tmp_path / "must_not_read_receipt.json",
+            raw_path=tmp_path / "must_not_read_raw.csv",
+            output_dir=tmp_path / f"internal-final-{version}",
+        )
+
+
+def test_v122_authority_surface_retains_every_reserved_hold() -> None:
+    expected = {
+        "development_evidence_authority": "NONE",
+        "formal_evidence_authority": "NONE",
+        "predictive_authority": "NONE",
+        "trading_authority": "NONE",
+        "alerting_authority": "NONE",
+        "automated_action_authority": "NONE",
+        "stage_final": "HOLD",
+        "real_v1_2_1_development": "HOLD",
+        "real_v1_2_2_development": "HOLD",
+        "new_confirmation_data_authority": "HOLD",
+        "kibot_inquiry": "PREPARED_NOT_SENT",
+        "external_provider_contact_during_dwo05": "NONE_AUTHORIZED",
+        "massive_contact_any_form": "NOT_AUTHORIZED",
+        "account_trial_purchase_credentials_download_ingestion": "HOLD",
+    }
+    assert {key: AUTHORITY[key] for key in expected} == expected
+
+    assert TRACEABILITY is V1_2_2_TRACEABILITY
+    assert traceability_for_protocol(PROTOCOL_SHA256) is V1_2_2_TRACEABILITY
+    assert (
+        traceability_for_protocol(V1_2_1_PROTOCOL_SHA256)
+        is V1_2_1_TRACEABILITY
+    )
+    assert len(V1_2_2_TRACEABILITY) > len(V1_2_1_TRACEABILITY)
+    validate_traceability(V1_2_2_TRACEABILITY)
