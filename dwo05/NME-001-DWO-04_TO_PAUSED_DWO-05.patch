+        "source_tree_prefiltered": False,
+        "actual_project_root_build": True,
+        "command": list(BUILD_COMMAND),
+        "environment": dict(BUILD_ENVIRONMENT),
+        "hatch_policy": policy,
+        "forbidden_sources": records,
+        "scan_methods": list(SCAN_METHODS),
+        "fragment_bytes": FRAGMENT_BYTES,
+        "complete_raw_row_minimum_bytes": RAW_LINE_MIN_BYTES,
+        "distributions": distributions,
