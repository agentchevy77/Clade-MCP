+def _deterministic_distribution_build_evidence(project: Path) -> dict[str, object]:
+    """Retain DWO-04 sanitized two-build proof as an additional check."""
+
+    entries = _collect_release_entries(project)
+    before = {name: _file_record(path) for name, path in sorted(entries.items())}
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo05-sanitized-builds-") as temporary:
+        root = Path(temporary)
+        sources: list[Path] = []
+        for label in ("source-a", "source-b"):
+            source_root = root / label
+            source_root.mkdir()
+            for name, source in entries.items():
+                target = source_root / name
+                target.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copyfile(source, target)
+            sources.append(source_root)
+        first_root = root / "first"
+        second_root = root / "second"
+        first = _build_distribution_once(sources[0], first_root)
+        second = _build_distribution_once(sources[1], second_root)
+        if first != second:
+            raise ReleaseError("sanitized wheel/sdist records are not identical")
+        for name in first:
+            if (first_root / name).read_bytes() != (second_root / name).read_bytes():
+                raise ReleaseError("sanitized wheel/sdist bytes are not identical")
+    if {name: _file_record(path) for name, path in sorted(_collect_release_entries(project).items())} != before:
+        raise ReleaseError("project bytes changed during sanitized builds")
+    return {
+        "status": "PASS",
+        "scope": "ADDITIONAL_SANITIZED_RELEASE_INVENTORY_BUILD",
+        "command": list(DISTRIBUTION_BUILD_COMMAND),
+        "environment": dict(DISTRIBUTION_BUILD_ENVIRONMENT),
+        "fresh_build_count": 2,
+        "artifacts": first,
+        "independent_builds_byte_identical": True,
+        "authority": "NONE",
+    }
+
