+def _validate_order_and_protocol(project: Path) -> dict[str, dict[str, object]]:
+    _validate_release_identity()
+    order = _file_record(project / ORDER_ARCHIVE_PATH)
+    if order["sha256"] != WORK_ORDER_SHA256:
+        raise ReleaseError("DWO-05 order bytes do not match authorized order")
+    protocol = _file_record(project / ACTIVE_PROTOCOL_PATH)
+    if protocol["sha256"] != _protocol_sha256():
+        raise ReleaseError("active protocol bytes disagree with DWO-05 contract")
+    return {"order": order, "protocol": protocol}
