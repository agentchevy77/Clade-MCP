+def _archived_distribution_policy(
+    archive: zipfile.ZipFile,
+    records: Mapping[str, Mapping[str, object]],
+) -> dict[str, object]:
+    """Parse and bind the candidate's archived Hatch exclusion policy."""
+
+    record = records.get("pyproject.toml")
+    if not isinstance(record, Mapping) or set(record) != {"sha256", "size_bytes"}:
+        raise ReleaseError("candidate pyproject record is missing or malformed")
+    digest = record.get("sha256")
+    size = record.get("size_bytes")
+    if (
+        not isinstance(digest, str)
+        or re.fullmatch(r"[0-9a-f]{64}", digest) is None
+        or type(size) is not int
+        or size <= 0
+    ):
+        raise ReleaseError("candidate pyproject record identity is invalid")
+    try:
+        payload = archive.read("pyproject.toml")
+    except (KeyError, RuntimeError, zipfile.BadZipFile) as exc:
+        raise ReleaseError("candidate pyproject payload is unavailable") from exc
+    if len(payload) != size or _sha256_bytes(payload) != digest:
+        raise ReleaseError("candidate pyproject bytes disagree with its record")
+    with tempfile.TemporaryDirectory(
+        prefix="nme001-dwo05-archived-distribution-policy-"
+    ) as temporary:
+        project = Path(temporary)
+        (project / "pyproject.toml").write_bytes(payload)
+        try:
+            policy = validate_hatch_distribution_policy(project)
+        except DistributionSafetyError as exc:
+            raise ReleaseError(
+                "candidate pyproject Hatch exclusion policy is unsafe"
+            ) from exc
+    if policy.get("pyproject_sha256") != digest:
+        raise ReleaseError("candidate Hatch policy is not bound to pyproject bytes")
+    return policy
+
