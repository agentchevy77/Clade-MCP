+
+def canonical_candidate_patch_bytes(project: str | Path) -> bytes:
+    """Regenerate the complete DWO-04-to-DWO-05 scoped patch."""
+
+    root = Path(project).absolute()
+    baseline_payload = _read_regular_file(
+        root / DWO04_PACKAGE_ARCHIVE_PATH,
+        purpose="canonical DWO-05 patch baseline",
+    )
+    expected_size, expected_sha256 = _PRESERVED_DWO04_RECORDS[
+        DWO04_PACKAGE_ARCHIVE_PATH
+    ]
+    if len(baseline_payload) != expected_size or _sha256_bytes(baseline_payload) != expected_sha256:
+        raise ReleaseError("canonical patch baseline is not exact DWO-04")
+    target_entries = _candidate_source_entries(root)
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo05-canonical-patch-") as temporary:
+        baseline = Path(temporary) / "baseline"
+        baseline.mkdir()
+        with zipfile.ZipFile(io.BytesIO(baseline_payload)) as archive:
+            archive.extractall(baseline)
+        _run_git_bytes(["git", "init", "--quiet"], cwd=baseline, purpose="initialize DWO-05 patch repository")
+        for key, value in (
+            ("user.name", "NME001 deterministic release"),
+            ("user.email", "nme001-release.invalid"),
+            ("core.autocrlf", "false"),
+            ("core.filemode", "false"),
+            ("core.hooksPath", os.devnull),
+            ("core.quotePath", "true"),
+        ):
+            _run_git_bytes(["git", "config", key, value], cwd=baseline, purpose="configure DWO-05 patch repository")
+        _run_git_bytes(["git", "add", "-f", "-A"], cwd=baseline, purpose="stage exact DWO-04 baseline")
+        _run_git_bytes(
+            ["git", "commit", "--quiet", "--no-gpg-sign", "--no-verify", "-m", "exact DWO-04 baseline"],
+            cwd=baseline,
+            purpose="commit exact DWO-04 baseline",
+        )
+        for relative in _CANDIDATE_SNAPSHOT_PATHS:
+            target = baseline / relative
+            if target.is_symlink():
+                raise ReleaseError("exact DWO-04 scoped baseline contains a symlink")
+            if target.is_dir():
+                shutil.rmtree(target)
+            elif target.exists():
+                target.unlink()
+        for name, source in target_entries.items():
+            target = baseline / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(source, target)
+        _run_git_bytes(
+            ["git", "add", "-f", "-A", "--", *_CANDIDATE_SNAPSHOT_PATHS],
+            cwd=baseline,
+            purpose="stage complete DWO-05 target",
+        )
+        patch = _run_git_bytes(
+            [
+                "git", "diff", "--cached", "--binary", "--full-index",
+                "--no-ext-diff", "--no-renames", "--no-color", "--unified=3",
+                "--src-prefix=a/", "--dst-prefix=b/", "HEAD", "--",
+                *_CANDIDATE_SNAPSHOT_PATHS,
+            ],
+            cwd=baseline,
+            purpose="regenerate complete canonical DWO-05 patch",
+        )
+    if not patch.startswith(b"diff --git ") or not patch.endswith(b"\n"):
+        raise ReleaseError("canonical DWO-05 candidate patch is empty or malformed")
+    return patch
+
+
+def write_canonical_candidate_patch(
+    *, project_root: str | Path, output_path: str | Path
+) -> dict[str, object]:
+    root = Path(project_root).absolute()
+    output = Path(output_path).absolute()
+    if output != root / CANDIDATE_DIFF_ARCHIVE_PATH:
+        raise ReleaseError(f"candidate patch output must be {CANDIDATE_DIFF_ARCHIVE_PATH}")
+    if output.exists() or output.is_symlink():
+        raise ReleaseError("candidate patch output must be absent")
+    payload = canonical_candidate_patch_bytes(root)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_bytes(payload)
+    output.chmod(0o644)
+    return {
+        "status": "PASS",
+        "path": CANDIDATE_DIFF_ARCHIVE_PATH,
+        "size_bytes": len(payload),
+        "sha256": _sha256_bytes(payload),
+    }
+
+
+def _candidate_diff_reconstruction_evidence(project: Path) -> dict[str, object]:
+    baseline_payload = _read_regular_file(
+        project / DWO04_PACKAGE_ARCHIVE_PATH,
+        purpose="exact DWO-04 candidate-diff baseline",
+    )
+    expected_size, expected_sha256 = _PRESERVED_DWO04_RECORDS[DWO04_PACKAGE_ARCHIVE_PATH]
+    if len(baseline_payload) != expected_size or _sha256_bytes(baseline_payload) != expected_sha256:
+        raise ReleaseError("candidate diff baseline is not exact DWO-04")
+    patch_path = project / CANDIDATE_DIFF_ARCHIVE_PATH
+    patch_payload = _read_regular_file(patch_path, purpose="DWO-04-to-DWO-05 patch")
+    try:
+        patch_text = patch_payload.decode("utf-8")
+    except UnicodeError as exc:
+        raise ReleaseError("DWO-04-to-DWO-05 patch is not UTF-8") from exc
+    if patch_payload != canonical_candidate_patch_bytes(project):
+        raise ReleaseError("DWO-04-to-DWO-05 patch is not the complete canonical diff")
+    if any(
+        line.startswith(("rename from ", "rename to ", "copy from ", "copy to "))
+        for line in patch_text.splitlines()
+    ):
+        raise ReleaseError("DWO-05 patch contains rename/copy headers")
+    if f" b/{CANDIDATE_DIFF_ARCHIVE_PATH}" in patch_text:
+        raise ReleaseError("DWO-05 candidate diff must exclude itself")
+    target_snapshot = _candidate_source_snapshot(project)
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo05-diff-") as temporary:
+        baseline = Path(temporary) / "baseline"
+        baseline.mkdir()
+        with zipfile.ZipFile(io.BytesIO(baseline_payload)) as archive:
+            archive.extractall(baseline)
+        for check_only in (True, False):
+            command = ["git", "apply", "--whitespace=nowarn"]
+            if check_only:
+                command.append("--check")
+            command.append(str(patch_path))
+            completed = subprocess.run(
+                command,
+                cwd=baseline,
+                env=_dwo04._subprocess_environment({
+                    "GIT_ATTR_NOSYSTEM": "1",
+                    "GIT_CONFIG_GLOBAL": os.devnull,
+                    "GIT_CONFIG_NOSYSTEM": "1",
+                    "GIT_CONFIG_SYSTEM": os.devnull,
+                    "GIT_TERMINAL_PROMPT": "0",
+                    "LC_ALL": "C",
+                    "TZ": "UTC",
+                }),
+                check=False,
+                capture_output=True,
+                text=True,
+                timeout=120,
+            )
+            if completed.returncode != 0:
+                raise ReleaseError(
+                    "DWO-05 patch does not apply to exact DWO-04 baseline: "
+                    f"{completed.stderr[-2000:]!r}"
+                )
+        reconstructed_snapshot = _candidate_source_snapshot(baseline)
+    if reconstructed_snapshot != target_snapshot:
+        raise ReleaseError("DWO-05 patch reconstruction is not byte-identical")
+    snapshot_payload = canonical_json_bytes(target_snapshot)
+    return {
+        "status": "PASS",
+        "baseline": {
+            "archive_path": DWO04_PACKAGE_ARCHIVE_PATH,
+            "size_bytes": len(baseline_payload),
+            "sha256": expected_sha256,
+        },
+        "patch": {
+            "archive_path": CANDIDATE_DIFF_ARCHIVE_PATH,
+            "size_bytes": len(patch_payload),
+            "sha256": _sha256_bytes(patch_payload),
+        },
+        "snapshot_scope": [
+            "README.md", "pyproject.toml", "uv.lock", "src/", "tests/",
+            "config/", "governance/", "docs/", "data/receipts/",
+        ],
+        "excluded_self_referential_path": CANDIDATE_DIFF_ARCHIVE_PATH,
+        "reconstructed_file_count": len(target_snapshot),
+        "reconstructed_snapshot_sha256": _sha256_bytes(snapshot_payload),
+        "byte_for_byte_identical": True,
+        "authority": "NONE",
+    }
+
