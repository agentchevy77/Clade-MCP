+def test_dwo05_controlled_raw_restore_failure_preserves_recovery_bytes(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    project = tmp_path / "project"
+    raw = project / "data/raw"
+    raw.mkdir(parents=True)
+    original = raw / "licensed.csv"
+    original.write_bytes(b"licensed-original\n")
+    real_replace = os.replace
+    calls: list[tuple[Path, Path]] = []
+
+    def fail_restore(source: str | Path, destination: str | Path) -> None:
+        source_path = Path(source)
+        destination_path = Path(destination)
+        calls.append((source_path, destination_path))
+        if len(calls) == 3:
+            raise OSError("injected restore failure")
+        real_replace(source_path, destination_path)
+
+    monkeypatch.setattr(release_dwo05.os, "replace", fail_restore)
+    with pytest.raises(ReleaseError, match="remain recoverable at"):
+        with release_dwo05._controlled_actual_root_raw_state(project):
+            raw.mkdir(parents=True)
+            (raw / "sentinel.csv").write_bytes(b"sentinel\n")
+
+    held = calls[0][1]
+    assert (held / "licensed.csv").read_bytes() == b"licensed-original\n"
+    real_replace(held, raw)
+    recovery_root = held.parent
+    if recovery_root.exists():
+        shutil.rmtree(recovery_root)
+    assert original.read_bytes() == b"licensed-original\n"
+
