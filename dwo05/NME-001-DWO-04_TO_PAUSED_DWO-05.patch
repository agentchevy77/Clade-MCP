+from nexus_nme001.artifacts import write_csv, write_json
+from nexus_nme001.contract import CLASS_ORDER, CLASS_PROBABILITY_COLUMNS
+from nexus_nme001.development import MODEL_ORDER
+
+
+BASELINES = tuple(model for model in MODEL_ORDER if model != "MODEL_FULL")
+THRESHOLDS = CapacityGateThresholds(200, 30, 50, 5)
+VALID_PROBABILITIES = (0.1, 0.2, 0.3, 0.4)
+
+
+def _probability_payload(
+    status: str,
+    values: tuple[object, ...] = VALID_PROBABILITIES,
+) -> dict[str, object]:
+    return {
+        column: value if status == "ISSUED" else None
+        for column, value in zip(
+            CLASS_PROBABILITY_COLUMNS,
+            values,
+            strict=True,
+        )
+    }
+
+
+def _complete_relation(
+    *,
+    candidate_status: str = "TECHNICAL_NOT_ISSUED",
+    baseline_statuses: dict[str, str] | None = None,
+    candidate_fit_status: str = "FIT",
+) -> dict[str, list[dict[str, object]]]:
+    identifier = "real-event-001"
+    session = "2026-01-05"
+    label = "DEFEND_OR_REJECT"
+    eligibility = {
+        "opportunity_id": identifier,
+        "session_date": session,
+        "partition": "DEVELOPMENT_TEST",
+        "outer_fold": "1",
+        "cohort": "REAL",
+        "origin_disposition": "EVENT_SEALED",
+        "forecast_status": candidate_status,
+        "outcome_evaluation_status": "EVALUATED",
+        "feature_status": "AVAILABLE",
+    }
+    event = {
+        **eligibility,
+        "outcome_only.evaluation_status": "EVALUATED",
+        "outcome_only.label": label,
+    }
+    statuses = {
+        baseline: "TECHNICAL_NOT_ISSUED" for baseline in BASELINES
+    }
+    statuses.update(baseline_statuses or {})
+    statuses["MODEL_FULL"] = candidate_status
+    predictions = [
+        {
+            "opportunity_id": identifier,
+            "session_date": session,
+            "cohort": "REAL",
+            "outer_fold": "1",
+            "model_id": model_id,
+            "forecast_status": statuses[model_id],
+            "outcome_only.evaluation_status": "EVALUATED",
+            "outcome_only.label": label,
+            **_probability_payload(statuses[model_id]),
+        }
+        for model_id in MODEL_ORDER
+    ]
+    fits = [
+        {
