+def _run_licensed_regression(
+    project: Path,
+    junit_output: Path,
+) -> dict[str, Any]:
+    """Run the DWO-05 licensed lane and bind its exact DWO-05 JUnit path."""
+
+    command = list(LICENSED_COMMAND)
+    actual_output = project / "pytest_dwo05_licensed.xml"
+    if actual_output.is_symlink():
+        raise ReleaseError("licensed rerun JUnit destination must not be a symlink")
+    previous_identity = None
+    if actual_output.is_file():
+        previous_identity = (
+            actual_output.stat().st_mtime_ns,
+            actual_output.stat().st_size,
+            _sha256_bytes(actual_output.read_bytes()),
+        )
+    environment = _dwo04._subprocess_environment(LOCKED_TEST_ENVIRONMENT)
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=project,
+            env=environment,
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=900,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise ReleaseError("licensed regression rerun could not complete") from exc
+    if completed.returncode != 0:
+        raise ReleaseError(
+            "licensed regression rerun failed: "
+            f"exit={completed.returncode}; stdout={completed.stdout[-2000:]!r}; "
+            f"stderr={completed.stderr[-2000:]!r}"
+        )
+    if actual_output.is_symlink() or not actual_output.is_file():
+        raise ReleaseError("licensed regression did not produce its exact JUnit output")
+    current_identity = (
+        actual_output.stat().st_mtime_ns,
+        actual_output.stat().st_size,
+        _sha256_bytes(actual_output.read_bytes()),
+    )
+    if previous_identity is not None and current_identity == previous_identity:
+        raise ReleaseError("licensed regression left a stale pre-existing JUnit output")
+    evidence = _junit_evidence(actual_output)
+    junit_output.write_bytes(actual_output.read_bytes())
+    return evidence
+
