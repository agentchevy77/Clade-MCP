index 0000000000000000000000000000000000000000..d41c016f6672814f3af05370e5bc494f537d4f31
--- /dev/null
+++ b/src/nexus_nme001/distribution_safety_dwo05.py
@@ -0,0 +1,1053 @@
+"""Fail-closed ordinary-build raw-data exclusion proof for DWO-05.
+
+This module deliberately builds from the supplied project root.  It does not
+stage or prefilter the source tree.  Wheel and source-distribution outputs live
+only in a temporary directory, are inspected there, and are removed before an
+evidence record is returned.
+"""
+
+from __future__ import annotations
+
+from array import array
+import base64
+import bz2
+import gzip
+import hashlib
+import io
+import json
+import lzma
+import os
+from pathlib import Path, PurePosixPath
+import re
+import stat
+import subprocess
+import tarfile
+import tempfile
+import tomllib
+from typing import Iterable, Mapping
+import zipfile
+
+
+class DistributionSafetyError(RuntimeError):
+    """An ordinary distribution build or raw-exclusion proof failed."""
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        residue_inventory: Mapping[str, object] | None = None,
+    ) -> None:
+        super().__init__(message)
+        self.residue_inventory = residue_inventory
+
+
+SDIST_RAW_EXCLUSION = "/data/raw/**"
+WHEEL_PACKAGE_ALLOWLIST = ("src/nexus_nme001",)
+BYTECODE_EXCLUSIONS = (
+    "**/__pycache__/**",
+    "**/*.pyc",
+    "**/*.pyo",
+)
+BUILD_COMMAND: tuple[str, ...] = (
+    "uv",
+    "build",
+    "--offline",
+    "--wheel",
+    "--sdist",
+    "--no-create-gitignore",
+    "--out-dir",
+    "{out_dir}",
+    ".",
+)
+BUILD_ENVIRONMENT: dict[str, str] = {
+    "SOURCE_DATE_EPOCH": "315532800",
+    "UV_OFFLINE": "1",
+    "UV_NO_CONFIG": "1",
+    "PYTHONDONTWRITEBYTECODE": "1",
+    "PYTHONHASHSEED": "0",
+    "PYTHONUTF8": "1",
+    "TZ": "UTC",
+}
+SCHEMA_VERSION = "NME001_DWO05_ORDINARY_DISTRIBUTION_SAFETY_V1"
+BUILD_CONDITIONS = frozenset(
+    {
+        "NO_RAW_DIRECTORY",
+        "HERMETIC_SENTINEL_PRESENT",
+        "THREE_EXACT_LICENSED_FIXTURES_PRESENT",
+    }
+)
+FRAGMENT_BYTES = 256
+RAW_LINE_MIN_BYTES = 24
+MAX_DISTRIBUTION_BYTES = 25_000_000
+MAX_MEMBER_BYTES = 12_000_000
+MAX_MEMBER_COUNT = 5_000
+MAX_TOTAL_EXPANDED_BYTES = 100_000_000
+MAX_NESTED_DEPTH = 4
+RAW_RESIDUE_MAX_ENTRY_COUNT = 512
+RAW_RESIDUE_MAX_RELATIVE_PATH_BYTES = 1_024
+RAW_RESIDUE_MAX_REGULAR_FILE_BYTES = 12_000_000
+RAW_RESIDUE_MAX_TOTAL_REGULAR_BYTES = 25_000_000
+SCAN_METHODS: tuple[str, ...] = (
+    "ROOT_RELATIVE_DATA_RAW_MEMBER_REJECTION",
+    "FORBIDDEN_SOURCE_BASENAME_MEMBER_REJECTION",
+    "EXACT_SOURCE_PAYLOAD_REJECTION",
+    "RAW_CONTIGUOUS_ROLLING_HASH_MIN_256_BYTES",
+    "RAW_COMPLETE_LINE_SUBSTRING_MIN_24_BYTES",
+    "BASE64_ASCII_WHITESPACE_NORMALIZED_ROLLING_HASH_MIN_256_BYTES",
+    "BASE64_ALL_THREE_RAW_BYTE_PHASES",
+    "HEX_NON_HEXDIGIT_REMOVED_ROLLING_HASH_MIN_256_BYTES",
+    "SORTED_MEMBER_CONCATENATION_BOUNDARY_SCAN",
+    "TOP_LEVEL_AND_TAR_METADATA_BYTES_SCAN",
+    "ARCHIVE_MEMBER_NAME_BYTES_SCAN",
+    "ARCHIVE_MEMBER_NAME_STRUCTURAL_SEPARATOR_REMOVED_SCAN",
+    "NESTED_ZIP_AND_TAR_MEMBER_SCAN",
+    "CONTENT_PROBED_RENAMED_ZIP_SCAN",
+    "FAIL_CLOSED_NESTED_DEPTH_BOUND",
+)
+_DISTRIBUTION_ARTIFACT_SUFFIXES = (
+    ".whl",
+    ".tar.gz",
+    ".zip",
+    ".tgz",
+    ".tar",
+)
+
+_DENY_ENVIRONMENT = {
+    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
+    "GIT_CONFIG_COUNT",
+    "GIT_DIR",
+    "GIT_INDEX_FILE",
+    "GIT_OBJECT_DIRECTORY",
+    "GIT_WORK_TREE",
+    "PYTHONHOME",
+    "PYTHONPATH",
+    "PYTEST_ADDOPTS",
+    "PYTEST_PLUGINS",
+    "UV_NO_SYNC",
+    "UV_PROJECT_ENVIRONMENT",
+    "VIRTUAL_ENV",
+}
+_DENY_ENVIRONMENT_PREFIXES = ("GIT_", "PYTEST_", "PYTHON", "UV_")
+_SHA256 = re.compile(r"[0-9a-f]{64}")
+_ROLLING_HASH_BASE = 257
+_ROLLING_HASH_MASK = (1 << 64) - 1
+_ROLLING_HASH_TABLE_MULTIPLIER = 11_400_714_819_323_198_485
+
+
+def _sha256(payload: bytes) -> str:
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _canonical_json_digest(values: Iterable[str]) -> str:
+    # This inventory binding is intentionally local and dependency-free.
+    encoded = json.dumps(
+        list(values),
+        ensure_ascii=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return _sha256(encoded)
+
+
+def validate_hatch_distribution_policy(project: str | Path) -> dict[str, object]:
+    """Require the exact sdist raw-tree exclusion and preserved wheel allowlist."""
+
+    root = Path(project).absolute()
+    pyproject = root / "pyproject.toml"
+    if root.is_symlink() or not root.is_dir():
+        raise DistributionSafetyError("project root must be a non-symlink directory")
+    if pyproject.is_symlink() or not pyproject.is_file():
+        raise DistributionSafetyError("pyproject.toml must be a regular file")
+    try:
+        document = tomllib.loads(pyproject.read_text(encoding="utf-8"))
+        targets = document["tool"]["hatch"]["build"]["targets"]
+        wheel_packages = targets["wheel"]["packages"]
+        wheel_excludes = targets["wheel"]["exclude"]
+        sdist_excludes = targets["sdist"]["exclude"]
+    except (OSError, UnicodeError, tomllib.TOMLDecodeError, KeyError, TypeError) as exc:
+        raise DistributionSafetyError(
+            "Hatch distribution policy is missing or malformed"
+        ) from exc
+    if wheel_packages != list(WHEEL_PACKAGE_ALLOWLIST):
+        raise DistributionSafetyError("exact wheel package allowlist changed")
+    if (
+        not isinstance(wheel_excludes, list)
+        or any(not isinstance(value, str) for value in wheel_excludes)
+        or any(value not in wheel_excludes for value in BYTECODE_EXCLUSIONS)
+    ):
+        raise DistributionSafetyError(
+            "wheel distribution lacks the bytecode/cache exclusions"
+        )
+    if (
+        not isinstance(sdist_excludes, list)
+        or any(not isinstance(value, str) for value in sdist_excludes)
+        or SDIST_RAW_EXCLUSION not in sdist_excludes
+        or any(value not in sdist_excludes for value in BYTECODE_EXCLUSIONS)
+    ):
+        raise DistributionSafetyError(
+            "source distribution lacks the exact root data/raw exclusion"
+        )
+    return {
+        "status": "PASS",
+        "wheel_packages": list(WHEEL_PACKAGE_ALLOWLIST),
+        "sdist_raw_exclusion": SDIST_RAW_EXCLUSION,
+        "bytecode_exclusions": list(BYTECODE_EXCLUSIONS),
+        "pyproject_sha256": _sha256(pyproject.read_bytes()),
+    }
+
+
+def _subprocess_environment() -> dict[str, str]:
+    environment = {
+        key: value
+        for key, value in os.environ.items()
+        if key not in _DENY_ENVIRONMENT
+        and not any(key.startswith(prefix) for prefix in _DENY_ENVIRONMENT_PREFIXES)
+    }
+    environment.update(BUILD_ENVIRONMENT)
+    return environment
+
+
+def _safe_member_name(name: str) -> PurePosixPath:
+    if not isinstance(name, str) or not name or "\\" in name or "\x00" in name:
+        raise DistributionSafetyError("distribution member name is noncanonical")
+    value = PurePosixPath(name)
+    if (
+        value.is_absolute()
+        or value.as_posix() != name.rstrip("/")
+        or any(part in {"", ".", ".."} for part in value.parts)
+    ):
+        raise DistributionSafetyError(
+            f"distribution member name is unsafe: {name!r}"
+        )
+    return value
+
+
+def _zip_members(payload: bytes, *, context: str) -> list[tuple[str, bytes]]:
+    try:
+        archive = zipfile.ZipFile(io.BytesIO(payload))
+    except (OSError, zipfile.BadZipFile) as exc:
+        raise DistributionSafetyError(f"invalid ZIP distribution: {context}") from exc
+    with archive:
+        infos = archive.infolist()
+        if len(infos) > MAX_MEMBER_COUNT:
+            raise DistributionSafetyError("distribution member count exceeds bound")
+        if sum(info.file_size for info in infos) > MAX_TOTAL_EXPANDED_BYTES:
+            raise DistributionSafetyError("expanded distribution bytes exceed bound")
+        result: list[tuple[str, bytes]] = []
+        for info in infos:
+            name = info.filename.rstrip("/")
+            if not name:
+                continue
+            _safe_member_name(name)
+            mode = info.external_attr >> 16
+            if info.flag_bits & 0x1:
+                raise DistributionSafetyError("encrypted distribution member rejected")
+            if info.is_dir():
+                result.append((name, b""))
+                continue
+            file_type = stat.S_IFMT(mode)
+            if file_type and file_type != stat.S_IFREG:
+                raise DistributionSafetyError("non-regular ZIP member rejected")
+            if info.file_size > MAX_MEMBER_BYTES:
+                raise DistributionSafetyError("distribution member exceeds size bound")
+            result.append((name, archive.read(info)))
+        return result
+
+
+def _tar_payload_members(payload: bytes, *, context: str) -> list[tuple[str, bytes]]:
+    try:
+        archive = tarfile.open(fileobj=io.BytesIO(payload), mode="r:*")
+    except (OSError, tarfile.TarError) as exc:
+        raise DistributionSafetyError(f"invalid TAR distribution: {context}") from exc
+    with archive:
+        infos = archive.getmembers()
+        if len(infos) > MAX_MEMBER_COUNT:
+            raise DistributionSafetyError("distribution member count exceeds bound")
+        if sum(info.size for info in infos if info.isreg()) > MAX_TOTAL_EXPANDED_BYTES:
+            raise DistributionSafetyError("expanded distribution bytes exceed bound")
+        result: list[tuple[str, bytes]] = []
+        for info in infos:
+            name = info.name.rstrip("/")
+            if not name:
+                continue
+            _safe_member_name(name)
+            if info.isdir():
+                result.append((name, b""))
+                continue
+            if not info.isreg() or info.issym() or info.islnk():
+                raise DistributionSafetyError("non-regular TAR member rejected")
+            if info.size > MAX_MEMBER_BYTES:
+                raise DistributionSafetyError("distribution member exceeds size bound")
+            extracted = archive.extractfile(info)
+            if extracted is None:
+                raise DistributionSafetyError("unable to read source member")
+            result.append((name, extracted.read()))
+        return result
+
+
+def _tar_scan_surface(payload: bytes, *, context: str) -> bytes:
+    """Return bounded uncompressed TAR bytes so metadata/trailers are scanned."""
+
+    try:
+        if payload.startswith(b"\x1f\x8b"):
+            reader = gzip.GzipFile(fileobj=io.BytesIO(payload), mode="rb")
+        elif payload.startswith(b"BZh"):
+            reader = bz2.BZ2File(io.BytesIO(payload), mode="rb")
+        elif payload.startswith(b"\xfd7zXZ\x00"):
+            reader = lzma.LZMAFile(io.BytesIO(payload), mode="rb")
+        else:
+            if len(payload) > MAX_TOTAL_EXPANDED_BYTES:
+                raise DistributionSafetyError(
+                    "uncompressed TAR scan surface exceeds bound"
+                )
+            return payload
+        with reader:
+            expanded = reader.read(MAX_TOTAL_EXPANDED_BYTES + 1)
+    except (OSError, EOFError, gzip.BadGzipFile, lzma.LZMAError) as exc:
+        raise DistributionSafetyError(
+            f"unable to construct TAR metadata scan surface: {context}"
+        ) from exc
+    if len(expanded) > MAX_TOTAL_EXPANDED_BYTES:
+        raise DistributionSafetyError("TAR metadata scan surface exceeds bound")
+    return expanded
+
+
+def _nested_archive_members(
+    members: list[tuple[str, bytes]],
+    *,
+    depth: int = 0,
+    scan_surfaces: list[bytes] | None = None,
+) -> list[tuple[str, bytes]]:
+    if scan_surfaces is None:
+        scan_surfaces = []
+    result = list(members)
+    for name, payload in members:
+        lowered = name.casefold()
+        suffix = PurePosixPath(name).suffix.casefold()
+        zip_named = suffix in {".zip", ".whl"}
+        zip_magic = payload.startswith((b"PK\x03\x04", b"PK\x05\x06", b"PK\x07\x08"))
+        zip_content = zipfile.is_zipfile(io.BytesIO(payload))
+        tar_named = lowered.endswith((".tar.gz", ".tgz", ".tar", ".tar.bz2", ".tar.xz"))
+        tar_magic = (
+            payload.startswith((b"\x1f\x8b", b"BZh", b"\xfd7zXZ\x00"))
+            or (len(payload) >= 262 and payload[257:262] == b"ustar")
+        )
+        if not (zip_named or zip_magic or zip_content or tar_named or tar_magic):
+            continue
+        if depth >= MAX_NESTED_DEPTH:
+            raise DistributionSafetyError(
+                "nested archive depth exceeds fail-closed inspection bound"
+            )
+        if zip_named or zip_magic or zip_content:
+            nested = _zip_members(payload, context=name)
+        elif tar_named or tar_magic:
+            nested = _tar_payload_members(payload, context=name)
+            scan_surfaces.append(_tar_scan_surface(payload, context=name))
+        qualified = [(f"{name}!/{child}", value) for child, value in nested]
+        result.extend(
+            _nested_archive_members(
+                qualified,
+                depth=depth + 1,
+                scan_surfaces=scan_surfaces,
+            )
+        )
+    return result
+
+
+def _distribution_members(path: Path) -> tuple[list[tuple[str, bytes]], list[bytes]]:
+    if path.is_symlink() or not path.is_file():
+        raise DistributionSafetyError("distribution must be a regular file")
+    if path.stat().st_size > MAX_DISTRIBUTION_BYTES:
+        raise DistributionSafetyError("distribution exceeds byte bound")
+    artifact_payload = path.read_bytes()
+    scan_surfaces = [artifact_payload]
+    if path.name.endswith(".whl"):
+        members = _zip_members(artifact_payload, context=path.name)
+    elif path.name.endswith(".tar.gz"):
+        members = _tar_payload_members(artifact_payload, context=path.name)
+        scan_surfaces.append(
+            _tar_scan_surface(artifact_payload, context=path.name)
+        )
+    else:
+        raise DistributionSafetyError("unsupported distribution type")
+    members = _nested_archive_members(members, scan_surfaces=scan_surfaces)
+    if len(members) > MAX_MEMBER_COUNT:
+        raise DistributionSafetyError("expanded member count exceeds bound")
+    if sum(len(payload) for _name, payload in members) > MAX_TOTAL_EXPANDED_BYTES:
+        raise DistributionSafetyError("expanded distribution bytes exceed bound")
+    return members, scan_surfaces
+
+
+def _rolling_windows(payload: bytes, width: int) -> Iterable[tuple[int, int]]:
+    if width <= 0 or len(payload) < width:
+        return
+    value = 0
+    for byte in payload[:width]:
+        value = ((value * _ROLLING_HASH_BASE) + byte) & _ROLLING_HASH_MASK
+    yield value, 0
+    leading_factor = pow(_ROLLING_HASH_BASE, width - 1, 1 << 64)
+    for offset in range(1, len(payload) - width + 1):
+        outgoing = payload[offset - 1]
+        incoming = payload[offset + width - 1]
+        value = (
+            ((value - (outgoing * leading_factor)) * _ROLLING_HASH_BASE) + incoming
+        ) & _ROLLING_HASH_MASK
+        yield value, offset
+
+
+def _rolling_table(payload: bytes, width: int) -> tuple[array, int]:
+    count = max(0, len(payload) - width + 1)
+    if count == 0:
+        return array("Q"), 0
+    capacity = 1
+    while capacity < count * 2:
+        capacity <<= 1
+    table = array("Q", [0]) * capacity
+    mask = capacity - 1
+    for value, _offset in _rolling_windows(payload, width):
+        key = ((value + 1) & _ROLLING_HASH_MASK) or 1
+        slot = (key * _ROLLING_HASH_TABLE_MULTIPLIER) & mask
+        while table[slot] not in {0, key}:
+            slot = (slot + 1) & mask
+        table[slot] = key
+    return table, mask
+
+
+def _table_contains(table: array, mask: int, value: int) -> bool:
+    if not table:
+        return False
+    key = ((value + 1) & _ROLLING_HASH_MASK) or 1
+    slot = (key * _ROLLING_HASH_TABLE_MULTIPLIER) & mask
+    while table[slot] != 0:
+        if table[slot] == key:
+            return True
+        slot = (slot + 1) & mask
+    return False
+
+
+def _reject_fragment(
+    candidate: bytes,
+    sources: Iterable[tuple[str, str, bytes]],
+) -> None:
+    material = list(sources)
+    if not material:
+        return
+    table, mask = _rolling_table(candidate, FRAGMENT_BYTES)
+    try:
+        for name, form, source in material:
+            for value, offset in _rolling_windows(source, FRAGMENT_BYTES):
+                if not _table_contains(table, mask, value):
+                    continue
+                fragment = source[offset : offset + FRAGMENT_BYTES]
+                if fragment in candidate:
+                    raise DistributionSafetyError(
+                        "distribution contains forbidden source fragment: "
+                        f"{name} ({form})"
+                    )
+    finally:
+        del table
+
+
+def _reject_complete_rows(
+    candidate: bytes,
+    sources: Mapping[str, bytes],
+) -> None:
+    index: dict[bytes, list[tuple[str, bytes]]] = {}
+    for name, source in sources.items():
+        for row in source.splitlines():
+            if len(row) >= RAW_LINE_MIN_BYTES:
+                index.setdefault(row[:RAW_LINE_MIN_BYTES], []).append((name, row))
+    for candidate_line in candidate.splitlines():
+        if len(candidate_line) < RAW_LINE_MIN_BYTES:
+            continue
+        for offset in range(len(candidate_line) - RAW_LINE_MIN_BYTES + 1):
+            prefix = candidate_line[offset : offset + RAW_LINE_MIN_BYTES]
+            for name, row in index.get(prefix, ()):
+                if row in candidate_line:
+                    raise DistributionSafetyError(
+                        f"distribution contains complete forbidden source row: {name}"
+                    )
+
+
+def _validate_forbidden_sources(
+    sources: Mapping[str, bytes],
+) -> dict[str, dict[str, object]]:
+    records: dict[str, dict[str, object]] = {}
+    for name, payload in sorted(sources.items()):
+        if not isinstance(name, str) or not name or not isinstance(payload, bytes):
+            raise DistributionSafetyError("forbidden source contract is malformed")
+        basename = PurePosixPath(name).name
+        if not basename or len(payload) == 0:
+            raise DistributionSafetyError("forbidden source must have bytes and a name")
+        records[name] = {
+            "basename": basename,
+            "size_bytes": len(payload),
+            "sha256": _sha256(payload),
+        }
+    return records
+
+
+def inspect_distribution(
+    path: str | Path,
+    *,
+    forbidden_sources: Mapping[str, bytes],
+) -> dict[str, object]:
+    """Inspect one wheel or sdist for raw paths and registered source material."""
+
+    distribution = Path(path)
+    source_records = _validate_forbidden_sources(forbidden_sources)
+    members, scan_surfaces = _distribution_members(distribution)
+    forbidden_basenames = {
+        str(record["basename"]).casefold() for record in source_records.values()
+    }
+    for name, _payload in members:
+        structural_name = name.replace("!/", "/")
+        parts = PurePosixPath(structural_name).parts
+        if any(
+            parts[index].casefold() == "data"
+            and parts[index + 1].casefold() == "raw"
+            for index in range(max(0, len(parts) - 1))
+        ):
+            raise DistributionSafetyError(
+                f"distribution contains a data/raw member: {name}"
+            )
+        if PurePosixPath(structural_name).name.casefold() in forbidden_basenames:
+            raise DistributionSafetyError(
+                f"distribution contains a forbidden source filename: {name}"
+            )
+
+    sorted_members = sorted(members, key=lambda member: member[0])
+    names = [name for name, _payload in sorted_members]
+    encoded_names = [name.encode("utf-8") for name in names]
+    raw_candidate = (
+        b"\n".join(scan_surfaces)
+        + b"\n"
+        + b"\n".join(encoded_names)
+        + b"\n"
+        + b"".join(name.replace(b"/", b"") for name in encoded_names)
+        + b"\n"
+        + b"".join(payload for _name, payload in sorted_members)
+    )
+    for name, source in forbidden_sources.items():
+        if source in raw_candidate:
+            raise DistributionSafetyError(
+                f"distribution contains exact forbidden source bytes: {name}"
+            )
+    _reject_complete_rows(raw_candidate, forbidden_sources)
+    _reject_fragment(
+        raw_candidate,
+        [(name, "raw", source) for name, source in forbidden_sources.items()],
+    )
+
+    compact_candidate = raw_candidate.translate(None, b" \t\r\n\v\f")
+    base64_sources = [
+        (name, f"base64-phase-{phase}", base64.b64encode(source[phase:]))
+        for name, source in forbidden_sources.items()
+        for phase in range(3)
+        if len(source) - phase >= FRAGMENT_BYTES
+    ]
+    _reject_fragment(compact_candidate, base64_sources)
+
+    hex_candidate = bytes(
+        byte
+        for byte in raw_candidate.lower().replace(b"0x", b"")
+        if byte in b"0123456789abcdef"
+    )
+    _reject_fragment(
+        hex_candidate,
+        [
+            (name, "hex", source.hex().encode("ascii"))
+            for name, source in forbidden_sources.items()
+        ],
+    )
+    record = {
+        "filename": distribution.name,
+        "size_bytes": distribution.stat().st_size,
+        "sha256": _sha256(distribution.read_bytes()),
+        "member_count": len(members),
+        "member_names_sha256": _canonical_json_digest(sorted(names)),
+        "data_raw_member_count": 0,
+        "forbidden_filename_hits": 0,
+        "exact_payload_hits": 0,
+        "complete_raw_row_hits": 0,
+        "bounded_fragment_hits": 0,
+        "status": "PASS",
+    }
+    return record
+
+
+def _build_once(project: Path, output: Path) -> list[Path]:
+    if output.exists() or output.is_symlink():
+        raise DistributionSafetyError("temporary build output must start absent")
+    command = [str(output) if item == "{out_dir}" else item for item in BUILD_COMMAND]
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=project,
+            env=_subprocess_environment(),
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=300,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise DistributionSafetyError("ordinary distribution build failed to run") from exc
+    if completed.returncode != 0:
+        raise DistributionSafetyError(
+            "ordinary distribution build failed: "
+            f"exit={completed.returncode}; stdout={completed.stdout[-2000:]!r}; "
+            f"stderr={completed.stderr[-2000:]!r}"
+        )
+    if output.is_symlink() or not output.is_dir():
+        raise DistributionSafetyError("ordinary build output is not a directory")
+    paths = sorted(output.iterdir())
+    wheel = [path for path in paths if path.name.endswith(".whl")]
+    sdist = [path for path in paths if path.name.endswith(".tar.gz")]
+    if len(paths) != 2 or len(wheel) != 1 or len(sdist) != 1:
+        raise DistributionSafetyError(
+            "ordinary build must produce exactly one wheel and one source distribution"
+        )
+    if any(path.is_symlink() or not path.is_file() for path in paths):
+        raise DistributionSafetyError("ordinary build output must be regular files")
+    return paths
+
+
+def _checkout_distribution_inventory(root: Path) -> dict[str, dict[str, object]]:
+    """Bind every retained distribution-like file before and after a root build."""
+
+    inventory: dict[str, dict[str, object]] = {}
+    for path in sorted(root.rglob("*")):
+        if not path.name.casefold().endswith(_DISTRIBUTION_ARTIFACT_SUFFIXES):
+            continue
+        if path.is_symlink() or not path.is_file():
+            raise DistributionSafetyError(
+                "checkout distribution inventory contains a non-regular path"
+            )
+        payload = path.read_bytes()
+        inventory[path.relative_to(root).as_posix()] = {
+            "size_bytes": len(payload),
+            "sha256": _sha256(payload),
+        }
+    return inventory
+
+
+def _lstat_kind(mode: int) -> str:
+    """Return a stable name for an lstat mode without following links."""
+
+    if stat.S_ISREG(mode):
+        return "REGULAR_FILE"
+    if stat.S_ISDIR(mode):
+        return "DIRECTORY"
+    if stat.S_ISLNK(mode):
+        return "SYMLINK"
+    if stat.S_ISFIFO(mode):
+        return "FIFO"
+    if stat.S_ISSOCK(mode):
+        return "SOCKET"
+    if stat.S_ISCHR(mode):
+        return "CHARACTER_DEVICE"
+    if stat.S_ISBLK(mode):
+        return "BLOCK_DEVICE"
+    return "OTHER"
+
+
+def _same_lstat_identity(left: os.stat_result, right: os.stat_result) -> bool:
+    return (
+        left.st_dev,
+        left.st_ino,
+        stat.S_IFMT(left.st_mode),
+        left.st_size,
+        left.st_mtime_ns,
+    ) == (
+        right.st_dev,
+        right.st_ino,
+        stat.S_IFMT(right.st_mode),
+        right.st_size,
+        right.st_mtime_ns,
+    )
+
+
+def _hash_regular_residue_no_follow(
+    name: str | os.PathLike[str],
+    expected: os.stat_result,
+    *,
+    directory_fd: int | None = None,
+) -> str:
+    """Hash one bounded regular residue without ever following a symlink."""
+
+    no_follow = getattr(os, "O_NOFOLLOW", None)
+    if no_follow is None:  # pragma: no cover - required POSIX release host feature
+        raise DistributionSafetyError(
+            "raw residue inventory requires O_NOFOLLOW support"
+        )
+    flags = os.O_RDONLY | no_follow | getattr(os, "O_CLOEXEC", 0)
+    try:
+        descriptor = os.open(name, flags, dir_fd=directory_fd)
+    except OSError as exc:
+        raise DistributionSafetyError(
+            "raw residue changed before its regular-file bytes could be bound"
+        ) from exc
+    try:
+        opened = os.fstat(descriptor)
+        if not stat.S_ISREG(opened.st_mode) or not _same_lstat_identity(
+            expected, opened
+        ):
+            raise DistributionSafetyError(
+                "raw residue regular-file identity changed during inventory"
+            )
+        if opened.st_size > RAW_RESIDUE_MAX_REGULAR_FILE_BYTES:
+            raise DistributionSafetyError(
+                "raw residue inventory exceeded the per-file byte bound"
+            )
+        digest = hashlib.sha256()
+        consumed = 0
+        while True:
+            chunk = os.read(descriptor, min(1_048_576, opened.st_size + 1))
+            if not chunk:
+                break
+            consumed += len(chunk)
+            if consumed > RAW_RESIDUE_MAX_REGULAR_FILE_BYTES:
+                raise DistributionSafetyError(
+                    "raw residue inventory exceeded the per-file byte bound"
+                )
+            digest.update(chunk)
+        closed_identity = os.fstat(descriptor)
+        if consumed != opened.st_size or not _same_lstat_identity(
+            opened, closed_identity
+        ):
+            raise DistributionSafetyError(
+                "raw residue regular-file identity changed while hashing"
+            )
+        return digest.hexdigest()
+    finally:
+        os.close(descriptor)
+
+
+def _raw_residue_inventory(project: Path, raw_root: Path) -> dict[str, object]:
+    """Capture a bounded canonical lstat inventory of unexpected raw residue."""
+
+    entries: list[dict[str, object]] = []
+    total_regular_bytes = 0
+
+    def append_record(
+        relative_path: str,
+        identity: os.stat_result,
+        *,
+        sha256: str | None = None,
+    ) -> None:
+        nonlocal total_regular_bytes
+        if len(entries) >= RAW_RESIDUE_MAX_ENTRY_COUNT:
+            raise DistributionSafetyError(
+                "raw residue inventory exceeded the entry-count bound"
+            )
+        if len(os.fsencode(relative_path)) > RAW_RESIDUE_MAX_RELATIVE_PATH_BYTES:
+            raise DistributionSafetyError(
+                "raw residue inventory exceeded the relative-path byte bound"
+            )
+        record: dict[str, object] = {
+            "relative_path": relative_path,
+            "lstat_kind": _lstat_kind(identity.st_mode),
+            "size_bytes": identity.st_size,
+        }
+        if stat.S_ISREG(identity.st_mode):
+            total_regular_bytes += identity.st_size
+            if total_regular_bytes > RAW_RESIDUE_MAX_TOTAL_REGULAR_BYTES:
+                raise DistributionSafetyError(
+                    "raw residue inventory exceeded the total regular-byte bound"
+                )
+            if sha256 is None:
+                raise DistributionSafetyError(
+                    "raw residue regular-file inventory lacks a digest"
+                )
+            record["sha256"] = sha256
+        entries.append(record)
+
+    def scan_directory(
+        descriptor: int,
+        relative_directory: str,
+        opened_identity: os.stat_result,
+    ) -> None:
+        try:
+            with os.scandir(descriptor) as scanner:
+                children = sorted(scanner, key=lambda child: os.fsencode(child.name))
+        except OSError as exc:
+            raise DistributionSafetyError(
+                "raw residue directory could not be inventoried without following links"
+            ) from exc
+        for child in children:
+            relative_path = f"{relative_directory}/{child.name}"
+            try:
+                child_identity = child.stat(follow_symlinks=False)
+            except OSError as exc:
+                raise DistributionSafetyError(
+                    "raw residue changed during lstat inventory"
+                ) from exc
+            if stat.S_ISREG(child_identity.st_mode):
+                digest = _hash_regular_residue_no_follow(
+                    child.name,
+                    child_identity,
+                    directory_fd=descriptor,
+                )
+                append_record(relative_path, child_identity, sha256=digest)
+            else:
+                append_record(relative_path, child_identity)
+            if stat.S_ISDIR(child_identity.st_mode):
+                flags = (
+                    os.O_RDONLY
+                    | getattr(os, "O_DIRECTORY", 0)
+                    | getattr(os, "O_NOFOLLOW", 0)
+                    | getattr(os, "O_CLOEXEC", 0)
+                )
+                try:
+                    child_descriptor = os.open(
+                        child.name,
+                        flags,
+                        dir_fd=descriptor,
+                    )
+                except OSError as exc:
+                    raise DistributionSafetyError(
+                        "raw residue directory identity changed during inventory"
+                    ) from exc
+                try:
+                    child_opened = os.fstat(child_descriptor)
+                    if not _same_lstat_identity(child_identity, child_opened):
+                        raise DistributionSafetyError(
+                            "raw residue directory identity changed during inventory"
+                        )
+                    scan_directory(
+                        child_descriptor,
+                        relative_path,
+                        child_opened,
+                    )
+                finally:
+                    os.close(child_descriptor)
+        if not _same_lstat_identity(opened_identity, os.fstat(descriptor)):
+            raise DistributionSafetyError(
+                "raw residue directory changed while being inventoried"
+            )
+
+    relative_root = raw_root.relative_to(project).as_posix()
+    try:
+        root_identity = raw_root.lstat()
+    except OSError as exc:
+        raise DistributionSafetyError(
+            "raw residue disappeared before lstat inventory"
+        ) from exc
+    if stat.S_ISREG(root_identity.st_mode):
+        digest = _hash_regular_residue_no_follow(raw_root, root_identity)
+        append_record(relative_root, root_identity, sha256=digest)
+    else:
+        append_record(relative_root, root_identity)
+    if stat.S_ISDIR(root_identity.st_mode):
+        flags = (
+            os.O_RDONLY
+            | getattr(os, "O_DIRECTORY", 0)
+            | getattr(os, "O_NOFOLLOW", 0)
+            | getattr(os, "O_CLOEXEC", 0)
+        )
+        try:
+            root_descriptor = os.open(raw_root, flags)
+        except OSError as exc:
+            raise DistributionSafetyError(
+                "raw residue root identity changed during inventory"
+            ) from exc
+        try:
+            root_opened = os.fstat(root_descriptor)
+            if not _same_lstat_identity(root_identity, root_opened):
+                raise DistributionSafetyError(
+                    "raw residue root identity changed during inventory"
+                )
+            scan_directory(root_descriptor, relative_root, root_opened)
+        finally:
+            os.close(root_descriptor)
+    return {
+        "schema_version": "NME001_DWO05_RAW_RESIDUE_INVENTORY_V1",
+        "entry_count": len(entries),
+        "total_regular_file_bytes": total_regular_bytes,
+        "bounds": {
+            "maximum_entry_count": RAW_RESIDUE_MAX_ENTRY_COUNT,
+            "maximum_relative_path_bytes": RAW_RESIDUE_MAX_RELATIVE_PATH_BYTES,
+            "maximum_regular_file_bytes": RAW_RESIDUE_MAX_REGULAR_FILE_BYTES,
+            "maximum_total_regular_file_bytes": (
+                RAW_RESIDUE_MAX_TOTAL_REGULAR_BYTES
+            ),
+        },
+        "entries": entries,
+    }
+
+
+def prove_ordinary_root_build_safety(
+    project: str | Path,
+    *,
+    condition: str,
+    forbidden_sources: Mapping[str, bytes],
+) -> dict[str, object]:
+    """Build at the actual root, scan both outputs, and retain evidence only."""
+
+    if condition not in BUILD_CONDITIONS:
+        raise DistributionSafetyError("ordinary-build condition is not registered")
+    root = Path(project).absolute()
+    policy = validate_hatch_distribution_policy(root)
+    records = _validate_forbidden_sources(forbidden_sources)
+    _validate_root_raw_condition(root, condition, forbidden_sources)
+    checkout_inventory_before = _checkout_distribution_inventory(root)
+    temporary_path: Path | None = None
+    distributions: dict[str, dict[str, object]] = {}
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo05-root-build-") as temporary:
+        temporary_path = Path(temporary)
+        output = temporary_path / "dist"
+        for artifact in _build_once(root, output):
+            kind = "wheel" if artifact.name.endswith(".whl") else "sdist"
+            distributions[kind] = inspect_distribution(
+                artifact,
+                forbidden_sources=forbidden_sources,
+            )
+    if temporary_path is None or temporary_path.exists():
+        raise DistributionSafetyError(
+            "temporary ordinary-build distributions were not removed"
+        )
+    if set(distributions) != {"wheel", "sdist"}:
+        raise DistributionSafetyError("ordinary distribution evidence is incomplete")
+    build_created_empty_raw_directory = False
+    raw_root = root / "data/raw"
+    if condition == "NO_RAW_DIRECTORY" and (
+        raw_root.exists() or raw_root.is_symlink()
+    ):
+        residue_inventory = _raw_residue_inventory(root, raw_root)
+        residue_entries = residue_inventory["entries"]
+        empty_directory_only = (
+            residue_inventory["entry_count"] == 1
+            and isinstance(residue_entries, list)
+            and residue_entries[0].get("relative_path") == "data/raw"
+            and residue_entries[0].get("lstat_kind") == "DIRECTORY"
+        )
+        if not empty_directory_only:
+            canonical_inventory = json.dumps(
+                residue_inventory,
