+def _reproduce_hermetic_package_impl(
+    package: str | Path, *, timeout_seconds: int = 900
+) -> dict[str, object]:
+    candidate = Path(package).absolute()
+    manifest = _dwo04.verify_candidate_package(candidate)
+    expected = manifest["reproduction"]["candidate_only_hermetic"]["named_test_evidence"]
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo05-reproduce-") as temporary:
+        root = Path(temporary)
+        with zipfile.ZipFile(candidate) as archive:
+            _dwo04._validate_zip_metadata(archive)
+            archive.extractall(root)
+        completed = subprocess.run(
+            HERMETIC_COMMAND,
+            cwd=root,
+            env=_dwo04._subprocess_environment(LOCKED_TEST_ENVIRONMENT),
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds,
+        )
+        if completed.returncode != 0:
+            raise ReleaseError(
+                "DWO-05 sealed reproduction failed: "
+                f"exit={completed.returncode}; stdout={completed.stdout[-2000:]!r}; "
+                f"stderr={completed.stderr[-2000:]!r}"
+            )
+        observed = _junit_evidence(root / "pytest_dwo05_hermetic.xml")
+        if observed["collected"] != expected["collected"] or observed["named_tests"] != expected["named_tests"]:
+            raise ReleaseError("sealed DWO-05 ZIP did not reproduce named hermetic cases")
+        full_names = _dwo04._collect_named_tests(root, licensed=True)
+        advertised = manifest["reproduction"]["licensed_fixture_regression"]["named_test_evidence"]["named_tests"]
+        if full_names != advertised:
+            raise ReleaseError("sealed DWO-05 ZIP did not reproduce full inventory")
+        inventory = _dwo04._named_test_inventory(full_names)
+    return {
+        "status": "PASS",
+        "package_sha256": _sha256_bytes(candidate.read_bytes()),
+        "advertised_test_count": expected["collected"],
+        "reproduced_test_count": observed["collected"],
+        "named_test_set_identical": True,
+        "full_inventory_count": inventory["collected"],
+        "full_inventory_sha256": inventory["named_tests_sha256"],
+        "full_inventory_identical": True,
+        "authority": "NONE",
+    }
