+
+def _mini_project(root: Path) -> None:
+    package = root / "src/nexus_nme001"
+    package.mkdir(parents=True)
+    (package / "__init__.py").write_text("VALUE = 1\n", encoding="utf-8")
+    (root / "README.md").write_text("# Build safety fixture\n", encoding="utf-8")
+    (root / "pyproject.toml").write_text(
+        """[project]
+name = "nexus-nme001"
+version = "0.3.2"
+description = "DWO-05 build safety fixture"
+readme = "README.md"
+requires-python = "==3.12.*"
+dependencies = []
+
+[build-system]
+requires = ["hatchling==1.27.0"]
+build-backend = "hatchling.build"
+
+[tool.hatch.build.targets.wheel]
+packages = ["src/nexus_nme001"]
+exclude = ["**/__pycache__/**", "**/*.pyc", "**/*.pyo"]
+
+[tool.hatch.build.targets.sdist]
+exclude = ["/data/raw/**", "**/__pycache__/**", "**/*.pyc", "**/*.pyo"]
+""",
+        encoding="utf-8",
+    )
+
+
+def _wheel(path: Path, members: dict[str, bytes]) -> Path:
+    with zipfile.ZipFile(path, mode="w", compression=zipfile.ZIP_DEFLATED) as archive:
+        for name, payload in members.items():
+            archive.writestr(name, payload)
+    return path
+
+
+def _raw_material() -> bytes:
+    return (b"X" * 400) + b"\n" + b"".join(
+        (
+            f"2026-08-{(index % 28) + 1:02d} 09:{index % 60:02d}:00,"
+            f"{600 + index}.01,{601 + index}.02,{599 + index}.03,"
+            f"{600 + index}.04,{100000 + index}\n"
+        ).encode("ascii")
+        for index in range(80)
+    )
+
+
+def test_dwo05_hatch_policy_excludes_complete_raw_tree_and_preserves_wheel_allowlist() -> None:
+    evidence = validate_hatch_distribution_policy(ROOT)
+
+    assert evidence["status"] == "PASS"
+    assert evidence["sdist_raw_exclusion"] == SDIST_RAW_EXCLUSION
+    assert evidence["wheel_packages"] == list(WHEEL_PACKAGE_ALLOWLIST)
+    assert evidence["bytecode_exclusions"] == list(BYTECODE_EXCLUSIONS)
