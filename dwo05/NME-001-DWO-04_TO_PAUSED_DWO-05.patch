+def test_dwo05_output_reconciliation_nested_mutations_fail_closed(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    path: tuple[str, ...],
+    replacement: object,
+) -> None:
+    value = release_dwo05._expected_output_reconciliation_payload()
+    target: dict[str, object] = value
+    for part in path[:-1]:
+        target = target[part]  # type: ignore[assignment]
+    target[path[-1]] = replacement
+    payload = canonical_json_bytes(value)
+    monkeypatch.setattr(
+        release_dwo05, "OUTPUT_RECONCILIATION_SIZE_BYTES", len(payload)
+    )
+    monkeypatch.setattr(
+        release_dwo05,
+        "OUTPUT_RECONCILIATION_SHA256",
+        hashlib.sha256(payload).hexdigest(),
+    )
+    artifact = tmp_path / "reconciliation.json"
+    artifact.write_bytes(payload)
+    archive_path = tmp_path / "candidate.zip"
+    _write_zip(
+        archive_path,
+        {release_dwo05.OUTPUT_RECONCILIATION_ARCHIVE_PATH: artifact},
+    )
+    records = {
+        release_dwo05.OUTPUT_RECONCILIATION_ARCHIVE_PATH: {
+            "sha256": hashlib.sha256(payload).hexdigest(),
+            "size_bytes": len(payload),
+        }
+    }
+    with zipfile.ZipFile(archive_path) as archive:
+        with pytest.raises(ReleaseError):
+            release_dwo05._verify_output_reconciliation(archive, records)
+
