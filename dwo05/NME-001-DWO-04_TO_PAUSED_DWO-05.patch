+@pytest.mark.parametrize(
+    ("baseline_attrition", "expected_retention", "expected_meets"),
+    ((1, 0.95, True), (2, 0.90, False)),
+)
+def test_common_origin_retention_exact_ninety_five_percent_boundary(
+    baseline_attrition: int,
+    expected_retention: float,
+    expected_meets: bool,
+) -> None:
+    rows = _complete_relation(
+        candidate_status="ISSUED",
+        baseline_statuses={baseline: "ISSUED" for baseline in BASELINES},
+    )
+    base_eligibility = rows["eligibility_rows"][0]
+    base_event = rows["event_rows"][0]
+    base_predictions = list(rows["prediction_rows"])
+    base_scored = rows["scored_rows"][0]
+    for index in range(1, 20):
+        identifier = f"real-event-{index + 1:03d}"
+        session = f"2026-01-{index + 5:02d}"
+        eligibility = dict(base_eligibility)
+        eligibility.update(opportunity_id=identifier, session_date=session)
+        rows["eligibility_rows"].append(eligibility)
+        event = dict(base_event)
+        event.update(opportunity_id=identifier, session_date=session)
+        rows["event_rows"].append(event)
+        for base_prediction in base_predictions:
+            prediction = dict(base_prediction)
+            prediction.update(opportunity_id=identifier, session_date=session)
+            rows["prediction_rows"].append(prediction)
+        scored = dict(base_scored)
+        scored.update(opportunity_id=identifier, session_date=session)
+        rows["scored_rows"].append(scored)
+
+    attrited_ids = {
+        f"real-event-{index:03d}"
+        for index in range(21 - baseline_attrition, 21)
+    }
+    for prediction in rows["prediction_rows"]:
+        if (
+            prediction["model_id"] == "B_CLIM"
+            and prediction["opportunity_id"] in attrited_ids
+        ):
+            prediction["forecast_status"] = "TECHNICAL_NOT_ISSUED"
+            for field in CLASS_PROBABILITY_COLUMNS:
+                prediction[field] = None
+
+    result = _run(rows)
+    support = next(
+        item
+        for item in result.comparator_common_origin_support
+        if item.baseline_id == "B_CLIM"
+    )
+    assert support.candidate_scorable_rows == 20
+    assert support.common_origin_rows == 20 - baseline_attrition
+    assert support.retention == pytest.approx(expected_retention)
+    assert support.retention_meets_requirement is expected_meets
+
