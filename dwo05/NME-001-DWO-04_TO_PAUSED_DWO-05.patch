+# ---------------------------------------------------------------------------
+# Ordinary distribution builds and raw-data exclusion.
+# ---------------------------------------------------------------------------
+
+_SENTINEL_RELATIVE_PATH = "data/raw/NME001_DWO05_RAW_EXCLUSION_SENTINEL.csv"
+_SENTINEL_BYTES = b"".join(
+    (
+        b"NME001_DWO05_SENTINEL_",
+        b"DO_NOT_PACKAGE,raw,custody,proof\n",
+        b"2000-01-01T00:00:00Z,",
+        b"123.456789,987.654321\n",
+    )
+)
+_RAW_STATE_LOCK_PREFIX = ".nme001-dwo05-raw-state-"
+
+
+def _raw_state_lock_path(project: Path) -> Path:
+    canonical_project = project.absolute()
+    identity = _sha256_bytes(os.fsencode(str(canonical_project)))[:24]
+    return canonical_project.parent / f"{_RAW_STATE_LOCK_PREFIX}{identity}.lock"
+
+
+@contextmanager
+def _exclusive_raw_state_lock(project: Path) -> Iterator[None]:
+    """Hold a nonblocking cross-process lock for actual-root raw mutation."""
+
+    lock_path = _raw_state_lock_path(project)
+    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_CLOEXEC", 0)
+    flags |= getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(lock_path, flags, 0o600)
+    except OSError as exc:
+        raise ReleaseError("unable to open the actual-root raw-state lock") from exc
+    locked = False
+    try:
+        metadata = os.fstat(descriptor)
+        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
+            raise ReleaseError("actual-root raw-state lock is not a regular file")
+        try:
+            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise ReleaseError(
+                "another controlled actual-root raw-state operation is active"
+            ) from exc
+        except OSError as exc:
+            raise ReleaseError("unable to acquire the actual-root raw-state lock") from exc
+        locked = True
+        yield
+    finally:
+        if locked:
+            try:
+                fcntl.flock(descriptor, fcntl.LOCK_UN)
+            except OSError:  # pragma: no cover - process teardown retains fail-closed lock
+                pass
+        os.close(descriptor)
+
+
+def _require_distribution_exclusion_config(project: Path) -> dict[str, object]:
+    try:
+        value = tomllib.loads(
+            _read_regular_file(project / "pyproject.toml", purpose="DWO-05 build config").decode("utf-8")
+        )
+    except (UnicodeError, tomllib.TOMLDecodeError) as exc:
+        raise ReleaseError("pyproject.toml is not valid UTF-8 TOML") from exc
+    try:
+        targets = value["tool"]["hatch"]["build"]["targets"]
+        wheel_packages = targets["wheel"]["packages"]
+        wheel_exclude = targets["wheel"]["exclude"]
+        sdist_exclude = targets["sdist"]["exclude"]
+    except (KeyError, TypeError) as exc:
+        raise ReleaseError("Hatch wheel/sdist custody configuration is incomplete") from exc
+    if wheel_packages != ["src/nexus_nme001"]:
+        raise ReleaseError("Hatch wheel package allowlist changed")
+    if (
+        not isinstance(wheel_exclude, list)
+        or any(not isinstance(item, str) for item in wheel_exclude)
+        or any(item not in wheel_exclude for item in BYTECODE_EXCLUSIONS)
+    ):
+        raise ReleaseError("Hatch wheel bytecode/cache exclusions changed")
+    if not isinstance(sdist_exclude, list) or any(not isinstance(item, str) for item in sdist_exclude):
+        raise ReleaseError("Hatch sdist exclusion must be a string list")
+    if "/data/raw/**" not in sdist_exclude:
+        raise ReleaseError("Hatch sdist does not explicitly exclude /data/raw/**")
+    if any(item not in sdist_exclude for item in BYTECODE_EXCLUSIONS):
+        raise ReleaseError("Hatch sdist bytecode/cache exclusions changed")
+    return {
+        "status": "PASS",
+        "wheel_packages": list(wheel_packages),
+        "wheel_exclude": list(wheel_exclude),
+        "sdist_exclude": list(sdist_exclude),
+        "bytecode_exclusions": list(BYTECODE_EXCLUSIONS),
+        "required_raw_exclusion": "/data/raw/**",
+        "authority": "NONE",
+    }
+
+
+def _build_distribution_once(project: Path, output: Path) -> dict[str, dict[str, object]]:
+    if output.exists() or output.is_symlink():
+        raise ReleaseError("fresh distribution output directory must be absent")
+    command = [str(output) if item == "{out_dir}" else item for item in DISTRIBUTION_BUILD_COMMAND]
+    completed = subprocess.run(
+        command,
+        cwd=project,
+        env=_dwo04._subprocess_environment(DISTRIBUTION_BUILD_ENVIRONMENT),
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=300,
+    )
+    if completed.returncode != 0:
+        raise ReleaseError(
+            "ordinary locked distribution build failed: "
+            f"exit={completed.returncode}; stdout={completed.stdout[-2000:]!r}; "
+            f"stderr={completed.stderr[-2000:]!r}"
+        )
+    expected = {
+        f"nexus_nme001-{CANDIDATE_VERSION}-py3-none-any.whl",
+        f"nexus_nme001-{CANDIDATE_VERSION}.tar.gz",
+    }
+    paths = sorted(output.iterdir()) if output.is_dir() and not output.is_symlink() else []
+    if {path.name for path in paths} != expected:
+        raise ReleaseError("ordinary distribution build inventory is not exact")
+    records: dict[str, dict[str, object]] = {}
+    for path in paths:
+        if path.is_symlink() or not path.is_file():
+            raise ReleaseError("ordinary distribution output is not a regular file")
+        records[path.name] = _file_record(path)
+    return records
+
+
+@contextmanager
+def _controlled_actual_root_raw_state_unlocked(project: Path) -> Iterator[Path]:
+    """Temporarily hold and exactly restore raw bytes with the caller locked."""
+
+    raw_root = project / "data/raw"
+    if raw_root.is_symlink() or not raw_root.is_dir():
+        raise ReleaseError("controlled actual-root proof requires data/raw")
+    temporary_root = Path(tempfile.mkdtemp(
+        prefix="nme001-dwo05-held-raw-",
+        dir=project.parent,
+    ))
+    held_raw = temporary_root / "licensed-raw"
+    transient_raw = temporary_root / "transient-raw"
+    holding_started = False
+    restored = False
+    try:
+        try:
+            os.replace(raw_root, held_raw)
+        except OSError as exc:
+            raise ReleaseError(
+                "unable to atomically hold the verified actual-root raw tree"
+            ) from exc
+        holding_started = True
+        yield raw_root
+    finally:
+        if not holding_started:
+            temporary_root.rmdir()
+        else:
+            if raw_root.exists() or raw_root.is_symlink():
+                try:
+                    os.replace(raw_root, transient_raw)
+                except OSError as exc:  # pragma: no cover - recovery path
+                    raise ReleaseError(
+                        "unable to quarantine transient actual-root raw state; "
+                        f"licensed originals remain recoverable at {held_raw}"
+                    ) from exc
+            if not held_raw.is_dir() or held_raw.is_symlink():
+                raise ReleaseError(
+                    "verified actual-root raw tree became unavailable during proof"
+                )
+            try:
+                os.replace(held_raw, raw_root)
+                restored = True
+            except OSError as exc:  # pragma: no cover - recovery path
+                raise ReleaseError(
+                    "unable to restore the verified actual-root raw tree; "
+                    f"licensed originals remain recoverable at {held_raw}"
+                ) from exc
+            finally:
+                if restored:
+                    if transient_raw.exists():
+                        shutil.rmtree(transient_raw)
+                    temporary_root.rmdir()
+
+
+@contextmanager
+def _controlled_actual_root_raw_state(project: Path) -> Iterator[Path]:
+    """Exclusively hold and exactly restore the verified actual-root raw tree."""
+
+    with _exclusive_raw_state_lock(project):
+        with _controlled_actual_root_raw_state_unlocked(project) as raw_root:
+            yield raw_root
+
+
+def _ordinary_distribution_exclusion_matrix(project: Path) -> dict[str, object]:
+    """Prove clean, sentinel, and exact-fixture ordinary build behavior.
+
+    All three conditions run from ``project`` itself. Clean and sentinel states
+    are controlled by atomically holding and exactly restoring the verified raw
+    tree. No release-prefiltered or copied source tree participates.
+    """
+
+    _require_distribution_exclusion_config(project)
+    try:
+        fixture_verification = verify_licensed_fixtures(project)
+        licensed_sources = load_exact_sources(project, contract_records())
+    except (LicensedFixtureError, DistributionSafetyError) as exc:
+        raise ReleaseError(
+            "fixture-present ordinary-root proof requires exact fixtures"
+        ) from exc
+
+    def prove_twice(
+        root: Path,
+        *,
+        condition: str,
+        forbidden_sources: Mapping[str, bytes],
+        root_scope: str,
+    ) -> dict[str, object]:
+        try:
+            first = prove_ordinary_root_build_safety(
+                root,
+                condition=condition,
+                forbidden_sources=forbidden_sources,
+            )
+            second = prove_ordinary_root_build_safety(
+                root,
+                condition=condition,
+                forbidden_sources=forbidden_sources,
+            )
+        except DistributionSafetyError as exc:
+            raise ReleaseError(
+                f"ordinary distribution exclusion failed: {condition}"
+            ) from exc
+        if first != second:
+            raise ReleaseError(
+                f"ordinary distribution evidence is not deterministic: {condition}"
+            )
+        return {
+            "status": "PASS",
+            "condition": condition,
+            "build_root_scope": root_scope,
+            "fresh_build_count": 2,
+            "independent_builds_byte_identical": True,
+            "evidence": first,
+            "authority": "NONE",
+        }
+
+    fixture_present = prove_twice(
+        project,
+        condition="THREE_EXACT_LICENSED_FIXTURES_PRESENT",
+        forbidden_sources=licensed_sources,
+        root_scope="ACTUAL_PROJECT_ROOT",
+    )
+    with _controlled_actual_root_raw_state(project) as raw_root:
+        clean = prove_twice(
+            project,
+            condition="NO_RAW_DIRECTORY",
+            forbidden_sources={},
+            root_scope="ACTUAL_PROJECT_ROOT_CONTROLLED_DATA_RAW_STATE",
+        )
+        sentinel = project / _SENTINEL_RELATIVE_PATH
+        sentinel.parent.mkdir(parents=True, exist_ok=True)
+        sentinel.write_bytes(_SENTINEL_BYTES)
+        sentinel_lane = prove_twice(
+            project,
+            condition="HERMETIC_SENTINEL_PRESENT",
+            forbidden_sources={_SENTINEL_RELATIVE_PATH: _SENTINEL_BYTES},
+            root_scope="ACTUAL_PROJECT_ROOT_CONTROLLED_DATA_RAW_STATE",
+        )
+    try:
