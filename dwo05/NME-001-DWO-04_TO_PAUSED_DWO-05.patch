+
+def _validate_root_raw_condition(
+    root: Path,
+    condition: str,
+    forbidden_sources: Mapping[str, bytes],
+) -> None:
+    raw_root = root / "data/raw"
+    if (root / "data").is_symlink():
+        raise DistributionSafetyError("project data directory must not be a symlink")
+    if condition == "NO_RAW_DIRECTORY":
+        if raw_root.exists() or raw_root.is_symlink():
+            raise DistributionSafetyError(
+                "NO_RAW_DIRECTORY condition disagrees with the project root"
+            )
+        if forbidden_sources:
+            raise DistributionSafetyError(
+                "NO_RAW_DIRECTORY condition cannot declare raw sources"
+            )
+        return
+    if raw_root.is_symlink() or not raw_root.is_dir():
+        raise DistributionSafetyError("declared raw-present condition lacks data/raw")
+    discovered: dict[str, bytes] = {}
+    for directory, names, filenames in os.walk(raw_root, followlinks=False):
+        directory_path = Path(directory)
+        for name in names:
+            if (directory_path / name).is_symlink():
+                raise DistributionSafetyError("data/raw contains a symlink directory")
+        for filename in filenames:
+            source = directory_path / filename
+            if source.is_symlink() or not source.is_file():
+                raise DistributionSafetyError("data/raw contains a non-regular file")
+            relative = source.relative_to(root).as_posix()
+            discovered[relative] = source.read_bytes()
+    if discovered != dict(forbidden_sources):
+        raise DistributionSafetyError(
+            "declared forbidden sources do not exactly cover the data/raw tree"
+        )
+    if condition == "HERMETIC_SENTINEL_PRESENT" and len(discovered) != 1:
+        raise DistributionSafetyError(
+            "hermetic sentinel condition requires exactly one raw source"
+        )
+    if condition == "THREE_EXACT_LICENSED_FIXTURES_PRESENT" and len(discovered) != 3:
+        raise DistributionSafetyError(
+            "licensed-fixture condition requires exactly three raw sources"
+        )
+
+
+def load_exact_sources(
+    project: str | Path,
+    records: Iterable[Mapping[str, object]],
+) -> dict[str, bytes]:
+    """Read only exact regular sources described by path/size/SHA-256 records."""
+
+    root = Path(project).absolute()
+    result: dict[str, bytes] = {}
+    for record in records:
+        relative = record.get("relative_path")
+        size = record.get("size_bytes")
+        digest = record.get("sha256")
+        if (
+            not isinstance(relative, str)
+            or isinstance(size, bool)
+            or not isinstance(size, int)
+            or size < 0
+            or not isinstance(digest, str)
+            or _SHA256.fullmatch(digest) is None
+        ):
+            raise DistributionSafetyError("exact-source record is malformed")
+        path_value = _safe_member_name(relative)
+        if path_value.parts[:2] != ("data", "raw"):
+            raise DistributionSafetyError("exact source is outside data/raw")
+        source = root / relative
+        if source.is_symlink() or not source.is_file():
+            raise DistributionSafetyError(f"exact source is absent: {relative}")
+        payload = source.read_bytes()
+        if len(payload) != size or _sha256(payload) != digest:
+            raise DistributionSafetyError(f"exact source identity mismatch: {relative}")
+        result[relative] = payload
+    if not result:
+        raise DistributionSafetyError("exact-source contract is empty")
+    return result
