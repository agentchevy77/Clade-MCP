+        or value.get("status") != "PASS"
+        or value.get("authority") != "NONE"
+    ):
+        raise ReleaseError("DWO-05 licensed/build exclusion record failed closed")
+    if archive is None:
+        raise ReleaseError("candidate archive is required for policy verification")
