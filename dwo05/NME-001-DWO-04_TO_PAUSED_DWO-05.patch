+@pytest.mark.parametrize(
+    ("residue_kind", "expected_entries"),
+    (
+        (
+            "file_in_raw_directory",
+            (
+                ("data/raw", "DIRECTORY", False),
+                ("data/raw/replayed.csv", "REGULAR_FILE", True),
+            ),
+        ),
+        ("symlink_raw_root", (("data/raw", "SYMLINK", False),)),
+        ("regular_file_raw_root", (("data/raw", "REGULAR_FILE", True),)),
+    ),
+)
+def test_dwo05_no_raw_failure_captures_canonical_bounded_residue_without_following_links(  # noqa: E501
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    residue_kind: str,
+    expected_entries: tuple[tuple[str, str, bool], ...],
+) -> None:
+    _mini_project(tmp_path)
+    original_build = distribution_safety._build_once
+    residue_payload = b"replayed raw residue\n"
+
+    def build_then_create_residue(root: Path, output: Path) -> list[Path]:
+        artifacts = original_build(root, output)
+        raw_root = root / "data/raw"
+        if residue_kind == "file_in_raw_directory":
+            raw_root.mkdir(parents=True)
+            (raw_root / "replayed.csv").write_bytes(residue_payload)
+        elif residue_kind == "symlink_raw_root":
+            raw_root.parent.mkdir(parents=True)
+            raw_root.symlink_to(root / "README.md")
+        else:
+            raw_root.parent.mkdir(parents=True)
+            raw_root.write_bytes(residue_payload)
+        return artifacts
+
+    monkeypatch.setattr(distribution_safety, "_build_once", build_then_create_residue)
+
+    with pytest.raises(
+        DistributionSafetyError,
+        match="ordinary build changed the absent raw state nontrivially",
+    ) as captured:
+        prove_ordinary_root_build_safety(
+            tmp_path,
+            condition="NO_RAW_DIRECTORY",
+            forbidden_sources={},
+        )
+
+    inventory = captured.value.residue_inventory
+    assert inventory is not None
+    entries = inventory["entries"]
+    assert [
+        (
+            entry["relative_path"],
+            entry["lstat_kind"],
+            "sha256" in entry,
+        )
+        for entry in entries
+    ] == list(expected_entries)
+    for entry in entries:
+        assert type(entry["size_bytes"]) is int
+        if entry["lstat_kind"] == "REGULAR_FILE":
+            assert entry["sha256"] == hashlib.sha256(residue_payload).hexdigest()
+        else:
+            assert "sha256" not in entry
+    canonical_inventory = json.dumps(
+        inventory,
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    assert str(captured.value).endswith(
+        f"residue_inventory={canonical_inventory}"
+    )
+
