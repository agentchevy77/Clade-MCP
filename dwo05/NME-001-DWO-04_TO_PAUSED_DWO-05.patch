+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="python -m nexus_nme001.release_dwo05",
+        description="Package or independently verify the DWO-05 candidate",
+    )
+    subparsers = parser.add_subparsers(dest="operation", required=True)
+    package = subparsers.add_parser("package")
+    package.add_argument("--project-root", type=Path, required=True)
+    package.add_argument("--hermetic-junit", type=Path, required=True)
+    package.add_argument("--licensed-junit", type=Path, required=True)
+    package.add_argument("--output", type=Path, required=True)
+    verify = subparsers.add_parser("verify")
+    verify.add_argument("--package", type=Path, required=True)
+    reproduce = subparsers.add_parser("reproduce")
+    reproduce.add_argument("--package", type=Path, required=True)
+    reproduce.add_argument("--timeout-seconds", type=int, default=900)
+    bindings = subparsers.add_parser("collection-bindings")
+    bindings.add_argument("--project-root", type=Path, required=True)
+    patch = subparsers.add_parser("candidate-patch")
+    patch.add_argument("--project-root", type=Path, required=True)
+    patch.add_argument("--output", type=Path, required=True)
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    if args.operation == "package":
+        result = package_candidate(
+            project_root=args.project_root,
+            hermetic_junit_path=args.hermetic_junit,
+            licensed_junit_path=args.licensed_junit,
+            output_path=args.output,
+        )
+    elif args.operation == "verify":
+        manifest = verify_candidate_package(args.package)
+        sidecars = verify_candidate_sidecars(args.package)
+        result = {
+            "status": "PASS",
+            "package": args.package,
+            "hermetic_named_tests_passed": manifest["reproduction"]["candidate_only_hermetic"]["named_test_evidence"]["passed"],
+            "sidecar_status": "PASS" if set(sidecars) == {"manifest", "receipt"} else "FAIL",
+            "authority": dict(AUTHORITY),
+        }
+    elif args.operation == "reproduce":
+        verify_candidate_sidecars(args.package)
+        result = reproduce_hermetic_package(args.package, timeout_seconds=args.timeout_seconds)
+    elif args.operation == "candidate-patch":
+        result = write_canonical_candidate_patch(project_root=args.project_root, output_path=args.output)
+    else:
+        result = compute_collection_bindings(args.project_root)
+    print(json.dumps({key: str(value) if isinstance(value, Path) else value for key, value in result.items()}, ensure_ascii=False, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
