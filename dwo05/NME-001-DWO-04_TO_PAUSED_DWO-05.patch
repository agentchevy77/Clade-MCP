+    output_path = project / OUTPUT_RECONCILIATION_ARCHIVE_PATH
+    output_payload = _read_regular_file(
+        output_path,
+        purpose="DWO-05 output-relation reconciliation",
+    )
+    if len(output_payload) != output_size or _sha256_bytes(output_payload) != output_sha256:
+        raise ReleaseError("DWO-05 output-reconciliation identity changed")
+    entries[OUTPUT_RECONCILIATION_ARCHIVE_PATH] = output_path
+    required_missing = sorted(_REQUIRED_DWO05_DELIVERABLES - set(entries))
+    if required_missing:
+        raise ReleaseError(f"DWO-05 release inventory is incomplete: {required_missing}")
+    for name in entries:
+        if name.startswith("data/raw/") or name.casefold().endswith((".csv", ".parquet")):
+            raise ReleaseError(f"DWO-05 release selection reached raw/bulk data: {name}")
+    return entries
+
+
+def _verify_preserved_dwo04_records(
+    records: Mapping[str, Mapping[str, object]],
+) -> None:
+    for name, (expected_size, expected_sha256) in _PRESERVED_DWO04_RECORDS.items():
+        if records.get(name) != {
+            "size_bytes": expected_size,
+            "sha256": expected_sha256,
+        }:
+            raise ReleaseError(f"preserved DWO-04 artifact record changed: {name}")
+    for name, (expected_size, expected_sha256) in _TRANSITIVE_DWO03_RECORDS.items():
+        if records.get(name) != {
+            "size_bytes": expected_size,
+            "sha256": expected_sha256,
+        }:
+            raise ReleaseError(
+                f"transitive preserved DWO-03 artifact record changed: {name}"
+            )
+
+
+def _verify_preserved_dwo04_payloads(archive: zipfile.ZipFile) -> None:
+    package_payload = archive.read(DWO04_PACKAGE_ARCHIVE_PATH)
+    try:
+        nested_context = zipfile.ZipFile(io.BytesIO(package_payload))
+    except zipfile.BadZipFile as exc:  # exact parent hash is pinned
+        raise ReleaseError("preserved DWO-04 candidate is not a readable ZIP") from exc
+    with nested_context as nested:
+        names = nested.namelist()
+        if len(names) != len(set(names)) or any(info.flag_bits & 0x1 for info in nested.infolist()):
+            raise ReleaseError("preserved DWO-04 candidate archive is unsafe")
+        for name in (
+            DWO04_EMBEDDED_MANIFEST_ARCHIVE_PATH,
+            DWO04_HERMETIC_JUNIT_ARCHIVE_PATH,
+            DWO04_LICENSED_JUNIT_ARCHIVE_PATH,
+        ):
+            if nested.read(name) != archive.read(name):
+                raise ReleaseError(
+                    f"preserved DWO-04 evidence disagrees with parent bytes: {name}"
+                )
+        for name, (expected_size, expected_sha256) in (
+            _TRANSITIVE_DWO03_RECORDS.items()
+        ):
+            try:
+                nested_payload = nested.read(name)
+                outer_payload = archive.read(name)
+            except KeyError as exc:
+                raise ReleaseError(
+                    f"transitive DWO-03 artifact is missing: {name}"
+                ) from exc
+            if (
+                len(outer_payload) != expected_size
+                or _sha256_bytes(outer_payload) != expected_sha256
+                or outer_payload != nested_payload
+            ):
+                raise ReleaseError(
+                    f"transitive DWO-03 artifact disagrees with sealed DWO-04: {name}"
+                )
+    external_payload = archive.read(DWO04_EXTERNAL_MANIFEST_ARCHIVE_PATH)
+    receipt_payload = archive.read(DWO04_RECEIPT_ARCHIVE_PATH)
+    try:
+        external = json.loads(external_payload.decode("utf-8"))
+        receipt = json.loads(receipt_payload.decode("utf-8"))
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise ReleaseError("preserved DWO-04 sidecars are unreadable") from exc
+    if (
+        not isinstance(external, dict)
+        or not isinstance(receipt, dict)
+        or external_payload != canonical_json_bytes(external)
+        or receipt_payload != canonical_json_bytes(receipt)
+    ):
+        raise ReleaseError("preserved DWO-04 sidecars are not canonical JSON")
+    package_record = {
+        "filename": "NME-001-DWO-04_UNREVIEWED_RESEARCH_CANDIDATE.zip",
+        "sha256": _PRESERVED_DWO04_RECORDS[DWO04_PACKAGE_ARCHIVE_PATH][1],
+        "size_bytes": _PRESERVED_DWO04_RECORDS[DWO04_PACKAGE_ARCHIVE_PATH][0],
+    }
+    if external.get("candidate_package") != package_record or receipt.get(
+        "candidate_package"
+    ) != package_record:
+        raise ReleaseError("preserved DWO-04 sidecars do not bind the parent")
+    expected_manifest = _PRESERVED_DWO04_RECORDS[DWO04_EXTERNAL_MANIFEST_ARCHIVE_PATH]
+    if receipt.get("candidate_manifest_sidecar") != {
+        "filename": "NME-001-DWO-04_CANDIDATE_MANIFEST.json",
+        "sha256": expected_manifest[1],
+        "size_bytes": expected_manifest[0],
+    }:
+        raise ReleaseError("preserved DWO-04 receipt does not bind its manifest")
+
