+def package_candidate(
+    *,
+    project_root: str | Path,
+    hermetic_junit_path: str | Path,
+    output_path: str | Path,
+    licensed_junit_path: str | Path,
+) -> dict[str, object]:
+    """Run the actual-root matrix first, then carry it once into the freeze."""
+
+    _validate_release_identity()
+    project = Path(project_root).absolute()
+    if project.is_symlink() or not project.is_dir():
+        raise ReleaseError("project root must be a non-symlink directory")
+    output = Path(output_path).absolute()
+    if output.exists() or output.is_symlink():
+        raise ReleaseError("candidate output path must be absent")
+    if output.name != PACKAGE_NAME:
+        raise ReleaseError(f"candidate output filename must be {PACKAGE_NAME}")
+    for sidecar_name in (EXTERNAL_MANIFEST_NAME, RECEIPT_NAME):
+        sidecar = output.parent / sidecar_name
+        if sidecar.exists() or sidecar.is_symlink():
+            raise ReleaseError(
+                f"candidate sidecar output path must be absent: {sidecar.name}"
+            )
+    if licensed_junit_path is None:  # type: ignore[comparison-overlap]
+        raise ReleaseError("DWO-05 release requires exact licensed PASS JUnit evidence")
+
+    precomputed_matrix = _ordinary_distribution_exclusion_matrix(project)
+    scan_call_count = 0
+
+    def scan_with_precomputed_matrix(
+        scan_project: Path,
+        entries: Mapping[str, Path],
+    ) -> dict[str, object]:
+        nonlocal scan_call_count
+        if Path(scan_project).absolute() != project:
+            raise ReleaseError(
+                "precomputed ordinary matrix was requested for a different root"
+            )
+        if scan_call_count != 0:
+            raise ReleaseError(
+                "precomputed ordinary matrix may be consumed exactly once"
+            )
+        scan_call_count += 1
+        return _licensed_payload_exclusion_scan(
+            project,
+            entries,
+            precomputed_ordinary_matrix=precomputed_matrix,
+        )
+
+    with _dwo05_context(licensed_scan_override=scan_with_precomputed_matrix):
+        result = _dwo04.package_candidate(
+            project_root=project_root,
+            hermetic_junit_path=hermetic_junit_path,
+            output_path=output_path,
+            licensed_junit_path=licensed_junit_path,
+        )
+    if scan_call_count != 1:
+        raise ReleaseError(
+            "DWO-05 package did not consume its precomputed ordinary matrix once"
+        )
+    return result
+
