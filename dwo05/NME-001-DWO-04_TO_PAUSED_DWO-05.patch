+    }
+    if not isinstance(conditions, dict) or set(conditions) != set(expected_conditions):
+        raise ReleaseError("ordinary distribution condition set is not exact")
+    for key, (condition, scope) in expected_conditions.items():
+        lane = conditions.get(key)
