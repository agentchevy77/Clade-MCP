+def _validate_zip_metadata(archive: zipfile.ZipFile) -> list[str]:
+    if archive.comment:
+        raise ReleaseError("candidate ZIP comment must be empty")
+    infos = archive.infolist()
+    if not infos or len(infos) > MAX_ARCHIVE_MEMBERS:
+        raise ReleaseError("candidate ZIP member count is outside the safe bound")
+    names = [info.filename for info in infos]
+    if len(names) != len(set(names)):
+        raise ReleaseError("candidate ZIP has duplicate members")
+    normalized_names = {
+        unicodedata.normalize("NFC", name).casefold() for name in names
+    }
+    if len(names) != len(normalized_names):
+        raise ReleaseError("candidate ZIP has normalized-name-colliding members")
+    if names != sorted(names):
+        raise ReleaseError("candidate ZIP members are not canonical-sorted")
+    total_uncompressed = 0
+    total_name_bytes = 0
+    for info in infos:
+        _safe_archive_name(info.filename)
+        name_size = len(info.filename.encode("utf-8"))
+        if name_size <= 0 or name_size > MAX_ARCHIVE_MEMBER_NAME_BYTES:
+            raise ReleaseError("candidate ZIP member name exceeds the byte bound")
+        total_name_bytes += name_size
+        if total_name_bytes > MAX_TOTAL_ARCHIVE_NAME_BYTES:
+            raise ReleaseError("candidate ZIP member names exceed the total byte bound")
+        mode = (info.external_attr >> 16) & 0xFFFF
+        if info.is_dir() or not stat.S_ISREG(mode):
+            raise ReleaseError(
+                f"candidate ZIP contains a non-regular member: {info.filename}"
+            )
+        if info.file_size < 0 or info.file_size > MAX_MEMBER_UNCOMPRESSED_BYTES:
+            raise ReleaseError(
+                f"candidate ZIP member exceeds the size bound: {info.filename}"
+            )
+        total_uncompressed += info.file_size
+        if total_uncompressed > MAX_TOTAL_UNCOMPRESSED_BYTES:
+            raise ReleaseError("candidate ZIP exceeds the total uncompressed bound")
+        if info.file_size and (
+            info.compress_size <= 0
+            or info.file_size / info.compress_size > MAX_COMPRESSION_RATIO
+        ):
+            raise ReleaseError(
+                f"candidate ZIP member exceeds the compression-ratio bound: {info.filename}"
+            )
+        if (
+            info.date_time != (1980, 1, 1, 0, 0, 0)
+            or info.compress_type != zipfile.ZIP_DEFLATED
+            or info.create_system != 3
+            or mode != 0o100644
+            or info.flag_bits != 0
+            or info.extra
+            or info.comment
+        ):
+            raise ReleaseError(
+                f"candidate ZIP member metadata is noncanonical: {info.filename}"
+            )
+        if _forbidden_member(info.filename):
+            raise ReleaseError(
+                f"candidate ZIP contains prohibited data/output: {info.filename}"
+            )
+        if not _allowed_member(info.filename):
+            raise ReleaseError(
+                f"candidate ZIP contains a member outside the exact release roots: "
+                f"{info.filename}"
+            )
+    return names
+
+
+def _require_canonical_zip_bytes(
+    candidate: Path,
+    archive: zipfile.ZipFile,
+    names: list[str],
+) -> None:
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo04-canonical-zip-") as temporary:
+        root = Path(temporary)
+        entries: dict[str, Path] = {}
+        for index, name in enumerate(names):
+            target = root / f"member-{index:04d}"
+            target.write_bytes(archive.read(name))
+            entries[name] = target
+        rebuilt = root / "rebuilt.zip"
+        _write_zip(rebuilt, entries)
+        if rebuilt.read_bytes() != candidate.read_bytes():
+            raise ReleaseError(
+                "candidate ZIP bytes are not the unique canonical deterministic encoding"
+            )
+
+
+def verify_candidate_package(package: str | Path) -> dict[str, Any]:
