+def _collect_release_entries(project: Path) -> dict[str, Path]:
+    entries = _collect_project_entries(project)
+    for name, path in _preserved_dwo03_entries(project).items():
+        if name in entries:
+            raise ReleaseError(f"duplicate preserved DWO-03 release member: {name}")
+        entries[name] = path
+    attrition_path = project / ATTRITION_RECONCILIATION_ARCHIVE_PATH
+    attrition_payload = _read_regular_file(
+        attrition_path,
+        purpose="DWO-04 licensed attrition reconciliation evidence",
+    )
+    if (
+        len(attrition_payload) != ATTRITION_RECONCILIATION_SIZE_BYTES
+        or _sha256_bytes(attrition_payload) != ATTRITION_RECONCILIATION_SHA256
+    ):
+        raise ReleaseError("DWO-04 attrition reconciliation identity changed")
+    entries[ATTRITION_RECONCILIATION_ARCHIVE_PATH] = attrition_path
+    for name, (expected_size, expected_sha256) in _EXACT_DWO04_SOURCE_RECORDS.items():
+        source = entries.get(name)
+        if source is None:
+            raise ReleaseError(f"exact DWO-04 source is absent: {name}")
+        record = _file_record(source)
+        if record != {
+            "sha256": expected_sha256,
+            "size_bytes": expected_size,
+        }:
