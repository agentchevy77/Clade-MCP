+def test_high_positive_real_support_and_pseudo_rows_cannot_clear_authority() -> None:
+    eligibility_rows: list[dict[str, object]] = []
+    event_rows: list[dict[str, object]] = []
+    prediction_rows: list[dict[str, object]] = []
+    scored_rows: list[dict[str, object]] = []
+    for index in range(240):
+        session_date = date.fromordinal(date(2025, 1, 1).toordinal() + index)
+        identifier = f"high-support-{index:03d}"
+        label = CLASS_ORDER[index % len(CLASS_ORDER)]
+        opportunity = _opportunity(
+            identifier,
+            session_date.isoformat(),
+            disposition="EVENT_SEALED",
+        )
+        eligibility_rows.append(opportunity)
+        event_rows.append(_event(opportunity, label))
+        prediction_rows.append(
+            {
+                **_prediction(
+                    identifier,
+                    session_date.isoformat(),
+                    "ISSUED",
+                ),
+                "outcome_only.label": label,
+            }
+        )
+        scored_rows.append(
+            {
+                "opportunity_id": identifier,
+                "session_date": session_date.isoformat(),
+                "cohort": "REAL",
+                "outer_fold": "1",
+                "outcome_only.label": label,
+            }
+        )
+
+    # A valid PSEUDO score is outside the REAL acquisition quantity and must
+    # be filtered before the nontechnical-origin check.
+    scored_rows.append(
+        {
+            "opportunity_id": "pseudo-score-outside-real-capacity",
+            "session_date": "2025-01-01",
+            "cohort": "PSEUDO",
+            "outer_fold": "1",
+            "outcome_only.label": CLASS_ORDER[0],
+        }
+    )
+    result = reconcile_capacity_attrition(
+        eligibility_rows=eligibility_rows,
+        event_rows=event_rows,
+        prediction_rows=prediction_rows,
+        fit_rows=[
+            {
+                "cohort": "REAL",
+                "outer_fold": 1,
+                "model_id": "MODEL_FULL",
+                "status": "FIT",
+            }
+        ],
+        scored_rows=scored_rows,
+        thresholds=CapacityGateThresholds(200, 30, 50, 5),
+    )
+
+    assert result.model_full_scorable_rows == 240
+    assert dict(result.model_full_scorable_per_class_rows) == {
+        label: 60 for label in CLASS_ORDER
+    }
+    assert result.observed_support_meets_development_total
+    assert result.observed_support_meets_development_per_class
+    assert result.observed_support_meets_final_total
+    assert result.observed_support_meets_final_per_class
+    assert result.clears_development_total is False
+    assert result.clears_development_per_class is False
+    assert result.clears_final_total is False
+    assert result.clears_final_per_class is False
+    assert result.clears_all is False
+    assert result.status == FAIL_CLOSED_ACQUISITION_STATUS
+
