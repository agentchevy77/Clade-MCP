+def _preserved_dwo03_entries(project: Path) -> dict[str, Path]:
+    entries: dict[str, Path] = {}
+    for name, (expected_size, expected_sha256) in _PRESERVED_DWO03_RECORDS.items():
+        path = project / name
+        payload = _read_regular_file(path, purpose=f"preserved DWO-03 artifact {name}")
+        if len(payload) != expected_size or _sha256_bytes(payload) != expected_sha256:
+            raise ReleaseError(f"preserved DWO-03 artifact identity changed: {name}")
+        entries[name] = path
+    return entries
