+            raise ValueError(
+                f"prediction fit reconciliation has unknown {row_kind}.cohort"
+            )
+        if model_id not in MODEL_ORDER:
+            raise ValueError(
+                f"prediction fit reconciliation has unknown {row_kind}.model_id"
+            )
+
+        if final_mode:
+            if row_kind == "fit":
+                if "evaluation_block" not in row:
+                    raise ValueError(
+                        "prediction fit reconciliation fit missing evaluation_block"
+                    )
+                block = row["evaluation_block"]
+                if type(block) is not str or block != "FINAL":
+                    raise ValueError(
+                        "prediction fit reconciliation fit requires exact FINAL block"
+                    )
+            else:
+                if "outer_fold" not in row:
+                    raise ValueError(
+                        "prediction fit reconciliation prediction missing outer_fold"
+                    )
+                block = row["outer_fold"]
+                if type(block) is not int or block != 0:
+                    raise ValueError(
+                        "prediction fit reconciliation final prediction requires "
+                        "exact integer outer_fold=0"
+                    )
+                block = "FINAL"
+        else:
+            if "outer_fold" not in row:
+                raise ValueError(
+                    f"prediction fit reconciliation {row_kind} missing outer_fold"
+                )
+            block = row["outer_fold"]
+            if type(block) is not int or block <= 0:
+                raise ValueError(
+                    "prediction fit reconciliation development "
+                    f"{row_kind}.outer_fold must be an exact positive integer"
+                )
+        return cohort, block, model_id
+
+    successful_fits: set[tuple[str, int | str, str]] = set()
+    all_fit_keys: set[tuple[str, int | str, str]] = set()
+    for row in fit_records:
+        key = exact_identity(row, row_kind="fit")
+        if key in all_fit_keys:
+            raise ValueError(
+                "prediction fit reconciliation duplicate fit identity: "
+                f"cohort/block/model={key}"
+            )
+        all_fit_keys.add(key)
+        if "status" not in row or type(row["status"]) is not str or not row["status"]:
+            raise ValueError(
+                "prediction fit reconciliation fit requires exact nonempty string status"
+            )
+        if row["status"] == "FIT":
+            successful_fits.add(key)
+
+    for row in predictions:
+        key = exact_identity(row, row_kind="prediction")
+        if (
+            "forecast_status" not in row
+            or type(row["forecast_status"]) is not str
+            or row["forecast_status"]
+            not in {"TECHNICAL_NOT_ISSUED", "OOD_ABSTAIN", "ISSUED"}
+        ):
+            raise ValueError(
+                "prediction fit reconciliation prediction requires an exact "
+                "registered forecast_status"
+            )
+        if row["forecast_status"] == "TECHNICAL_NOT_ISSUED":
+            continue
+        if key not in successful_fits:
+            raise ValueError(
+                "prediction fit reconciliation failed for "
+                f"cohort/block/model={key}: expected one successful FIT, "
+                "observed 0"
+            )
