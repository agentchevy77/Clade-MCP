+def _verify_archived_governance_and_configs(
+    archive: zipfile.ZipFile,
+    records: Mapping[str, Mapping[str, object]],
+) -> None:
+    for name, (expected_size, expected_sha256) in _EXACT_DWO04_SOURCE_RECORDS.items():
+        if records.get(name) != {
+            "sha256": expected_sha256,
+            "size_bytes": expected_size,
+        }:
+            raise ReleaseError(f"exact DWO-04 source identity changed: {name}")
+    preserved_configs = {
+        "config/frozen_config_v1_0_1.json": V1_0_1_CONFIG_SHA256,
+        "config/frozen_config_v1_1_0.json": V1_1_CONFIG_SHA256,
+        "config/frozen_config_v1_2_0.json": DWO03_CONFIG_SHA256,
+    }
+    for name, expected_sha256 in preserved_configs.items():
+        if records[name].get("sha256") != expected_sha256:
+            raise ReleaseError(f"preserved configuration identity changed: {name}")
+    try:
+        active_config = json.loads(
+            archive.read("config/frozen_config.json").decode("utf-8")
+        )
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise ReleaseError("active archived configuration is unreadable") from exc
+    if not isinstance(active_config, dict) or (
+        active_config.get("protocol_sha256") != PROTOCOL_SHA256
+        or active_config.get("stage") != "development"
+        or active_config.get("final_authorization_token_sha256") is not None
+    ):
+        raise ReleaseError("active archived configuration identity is invalid")
+    bound_documents = (
+        (
+            "prior_exposure_ledger_filename",
+            "prior_exposure_ledger_sha256",
+        ),
+        (
+            "historical_final_identities_filename",
+            "historical_final_identities_file_sha256",
+        ),
+    )
+    for filename_field, sha_field in bound_documents:
+        filename = active_config.get(filename_field)
+        if not isinstance(filename, str) or not filename:
+            raise ReleaseError(f"active config lacks {filename_field}")
+        path = f"governance/{filename}"
+        record = records.get(path)
+        if not isinstance(record, Mapping) or record.get("sha256") != active_config.get(
+            sha_field
+        ):
+            raise ReleaseError(f"active config document binding is invalid: {path}")
+    try:
+        v1_1 = archive.read(
+            "governance/NEXUS_MARKET_EXPERIMENT_001_v1_1_0.md"
+        ).decode("utf-8")
+        v1_1_to_v1_2 = archive.read(
+            "governance/NEXUS_MARKET_EXPERIMENT_001_v1_1_0_TO_v1_2_0.diff"
+        ).decode("utf-8")
+        v1_2 = archive.read(
+            "governance/NEXUS_MARKET_EXPERIMENT_001_v1_2_0.md"
+        ).decode("utf-8")
+        v1_2_to_v1_2_1 = archive.read(PROTOCOL_DIFF_ARCHIVE_PATH).decode("utf-8")
+        active = archive.read(ACTIVE_PROTOCOL_PATH).decode("utf-8")
+    except UnicodeError as exc:
+        raise ReleaseError("archived protocol/diff documents are not UTF-8") from exc
+    if _sha256_bytes(v1_2.encode("utf-8")) != DWO03_PROTOCOL_SHA256:
+        raise ReleaseError("preserved v1.2.0 protocol identity changed")
+    if _apply_unified_diff(v1_1, v1_1_to_v1_2) != v1_2:
+        raise ReleaseError("v1.1-to-v1.2 diff does not reconstruct v1.2.0")
+    if _apply_unified_diff(v1_2, v1_2_to_v1_2_1) != active:
+        raise ReleaseError("v1.2.0-to-v1.2.1 diff does not reconstruct active protocol")
+    if records["governance/NME001_PRIOR_EXPOSURE_LEDGER_v1_0_0.json"].get(
+        "sha256"
+    ) != DWO03_LEDGER_SHA256:
+        raise ReleaseError("preserved exposure ledger v1.0.0 identity changed")
+    if records["docs/NME-001-DWO-02_TO_DWO-03.patch"].get(
+        "sha256"
+    ) != DWO03_CANDIDATE_DIFF_SHA256:
+        raise ReleaseError("preserved DWO-02-to-DWO-03 diff identity changed")
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo04-configs-") as temporary:
+        root = Path(temporary)
+        for name in (
+            "config/frozen_config.json",
+            "config/frozen_config_v1_0_1.json",
+            "config/frozen_config_v1_1_0.json",
+        ):
+            target = root / Path(name).name
+            target.write_bytes(archive.read(name))
+            try:
+                load_config(target)
+            except (ContractError, KeyError, TypeError, ValueError) as exc:
+                raise ReleaseError(
+                    f"archived configuration failed contract validation: {name}"
+                ) from exc
+        try:
+            preserved_v1_2 = json.loads(
+                archive.read("config/frozen_config_v1_2_0.json").decode("utf-8")
+            )
+        except (UnicodeError, json.JSONDecodeError) as exc:
+            raise ReleaseError("preserved v1.2.0 configuration is unreadable") from exc
+        if not isinstance(preserved_v1_2, dict) or preserved_v1_2.get(
+            "protocol_sha256"
+        ) != DWO03_PROTOCOL_SHA256:
+            raise ReleaseError("preserved v1.2.0 configuration identity is invalid")
