+def _deterministic_distribution_build_evidence(project: Path) -> dict[str, object]:
+    release_entries = _collect_release_entries(project)
+    source_before = _entry_records(release_entries)
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo04-builds-") as temporary:
+        root = Path(temporary)
+        staged_sources: list[Path] = []
+        for label in ("source-a", "source-b"):
+            staged_source = root / label
+            staged_source.mkdir()
+            for name, source in release_entries.items():
+                target = staged_source / name
+                target.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copyfile(source, target)
+            staged_sources.append(staged_source)
+        first_root = root / "first"
+        second_root = root / "second"
+        first = _build_distribution_once(staged_sources[0], first_root)
+        second = _build_distribution_once(staged_sources[1], second_root)
+        if first != second:
+            raise ReleaseError("fresh locked wheel/sdist records are not identical")
+        for name in first:
+            if (first_root / name).read_bytes() != (second_root / name).read_bytes():
+                raise ReleaseError("fresh locked wheel/sdist bytes are not identical")
+    if _entry_records(_collect_release_entries(project)) != source_before:
+        raise ReleaseError("project bytes changed during locked distribution builds")
+    return {
+        "status": "PASS",
+        "command": list(DISTRIBUTION_BUILD_COMMAND),
+        "environment": dict(DISTRIBUTION_BUILD_ENVIRONMENT),
+        "fresh_build_count": 2,
+        "artifacts": first,
+        "independent_builds_byte_identical": True,
+        "authority": "NONE",
+    }
+
