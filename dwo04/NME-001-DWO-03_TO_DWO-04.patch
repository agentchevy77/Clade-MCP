+def _sealed_package_record(package: Path) -> dict[str, object]:
+    _bounded_regular_file_size(
+        package,
+        maximum=MAX_ARCHIVE_BYTES,
+        purpose="sealed DWO-04 candidate ZIP",
+    )
+    payload = _read_regular_file(package, purpose="sealed DWO-04 candidate ZIP")
+    return {
+        "filename": PACKAGE_NAME,
+        "sha256": _sha256_bytes(payload),
+        "size_bytes": len(payload),
+    }
+
+
+def _canonical_sidecar_object(path: Path, *, purpose: str) -> dict[str, Any]:
+    _bounded_regular_file_size(
+        path,
+        maximum=MAX_SIDECAR_BYTES,
+        purpose=purpose,
+    )
+    payload = _read_regular_file(path, purpose=purpose)
+    try:
+        value = json.loads(payload.decode("utf-8"))
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise ReleaseError(f"{purpose} is not valid UTF-8 JSON") from exc
+    if not isinstance(value, dict) or payload != canonical_json_bytes(value):
+        raise ReleaseError(f"{purpose} is not canonical object JSON")
+    return value
+
+
+def _validate_sealed_reproduction_record(
+    record: object,
+    *,
+    package_record: Mapping[str, object],
+    expected_count: int,
+    expected_full_inventory: Mapping[str, object],
+) -> None:
+    if not isinstance(record, dict) or set(record) != {
+        "status",
+        "package_sha256",
+        "advertised_test_count",
+        "reproduced_test_count",
+        "named_test_set_identical",
+        "full_inventory_count",
+        "full_inventory_sha256",
+        "full_inventory_identical",
+        "authority",
+    }:
+        raise ReleaseError("sealed reproduction sidecar record is invalid")
+    if record != {
+        "status": "PASS",
+        "package_sha256": package_record["sha256"],
+        "advertised_test_count": expected_count,
+        "reproduced_test_count": expected_count,
+        "named_test_set_identical": True,
+        "full_inventory_count": expected_full_inventory["collected"],
+        "full_inventory_sha256": expected_full_inventory[
+            "named_tests_sha256"
+        ],
+        "full_inventory_identical": True,
+        "authority": "NONE",
+    }:
+        raise ReleaseError("sealed reproduction sidecar result is invalid")
+
+
+def _sidecar_documents(
+    package: Path,
+    *,
+    embedded_manifest: Mapping[str, object],
+    sealed_reproduction: Mapping[str, object],
+) -> tuple[bytes, bytes]:
+    package_record = _sealed_package_record(package)
+    embedded_bytes = canonical_json_bytes(embedded_manifest)
+    embedded_record = {
+        "archive_path": MANIFEST_ARCHIVE_PATH,
+        "sha256": _sha256_bytes(embedded_bytes),
+        "size_bytes": len(embedded_bytes),
+    }
+    external_manifest = {
+        "schema_version": EXTERNAL_MANIFEST_SCHEMA_VERSION,
+        "work_order": WORK_ORDER,
+        "work_order_sha256": WORK_ORDER_SHA256,
+        "candidate_id": CANDIDATE_ID,
+        "candidate_version": CANDIDATE_VERSION,
+        "partition_design_version": DEFAULT_PARTITION_DESIGN.version,
+        "marking": MARKING,
+        "candidate_package": package_record,
+        "embedded_manifest": embedded_record,
+        "sealed_hermetic_reproduction": dict(sealed_reproduction),
+        "authority": dict(AUTHORITY),
+    }
+    external_bytes = canonical_json_bytes(external_manifest)
+    receipt = {
+        "schema_version": RECEIPT_SCHEMA_VERSION,
+        "work_order": WORK_ORDER,
+        "work_order_sha256": WORK_ORDER_SHA256,
+        "candidate_id": CANDIDATE_ID,
+        "candidate_version": CANDIDATE_VERSION,
+        "partition_design_version": DEFAULT_PARTITION_DESIGN.version,
+        "marking": MARKING,
+        "candidate_package": package_record,
+        "candidate_manifest_sidecar": {
+            "filename": EXTERNAL_MANIFEST_NAME,
+            "sha256": _sha256_bytes(external_bytes),
+            "size_bytes": len(external_bytes),
+        },
+        "sealed_hermetic_reproduction": dict(sealed_reproduction),
+        "final_holdout_opened": "NO",
+        "authority": dict(AUTHORITY),
+    }
+    return external_bytes, canonical_json_bytes(receipt)
+
