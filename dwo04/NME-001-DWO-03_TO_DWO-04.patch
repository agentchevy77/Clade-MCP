+def test_dwo04_candidate_patch_rejects_trailing_payload_and_extended_headers(
+    tmp_path: Path,
+) -> None:
+    base = tmp_path / "base"
+    _copy_release_tree(base)
+    original = (
+        base / release_dwo04.CANDIDATE_DIFF_ARCHIVE_PATH
+    ).read_bytes()
+    mutations = {
+        "trailing-line": original + b"UNBOUND TRAILING PAYLOAD\n",
+        "fixture-fragment": original + b"LICENSED,SENTINEL,CSV\nraw,row,fragment\n",
+        "extended-rename": original.replace(
+            b"\nindex ",
+            b"\nrename from artifacts/verification/hidden.json\n"
+            b"rename to artifacts/verification/renamed.json\nindex ",
+            1,
+        ),
+        "extended-copy": original.replace(
+            b"\nindex ",
+            b"\ncopy from artifacts/verification/hidden.json\n"
+            b"copy to docs/copied.md\nindex ",
+            1,
+        ),
+    }
+    for label, payload in mutations.items():
+        root = tmp_path / label
+        shutil.copytree(base, root)
+        (root / release_dwo04.CANDIDATE_DIFF_ARCHIVE_PATH).write_bytes(payload)
+        with pytest.raises(ReleaseError, match="complete canonical scoped diff"):
+            _candidate_diff_reconstruction_evidence(root)
+
