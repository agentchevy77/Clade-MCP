+def verify_candidate_sidecars(package: str | Path) -> dict[str, Any]:
+    """Verify deterministic external manifest/receipt bindings for one ZIP."""
+
+    candidate = Path(package).absolute()
+    if candidate.name != PACKAGE_NAME:
+        raise ReleaseError(f"candidate package filename must be {PACKAGE_NAME}")
+    embedded_manifest = verify_candidate_package(candidate)
+    package_record = _sealed_package_record(candidate)
+    external_path = candidate.parent / EXTERNAL_MANIFEST_NAME
+    receipt_path = candidate.parent / RECEIPT_NAME
+    external = _canonical_sidecar_object(
+        external_path,
+        purpose="DWO-04 external candidate manifest",
+    )
+    receipt = _canonical_sidecar_object(
+        receipt_path,
+        purpose="DWO-04 candidate receipt",
+    )
+    expected_external_fields = {
+        "schema_version",
+        "work_order",
+        "work_order_sha256",
+        "candidate_id",
+        "candidate_version",
+        "partition_design_version",
+        "marking",
+        "candidate_package",
+        "embedded_manifest",
+        "sealed_hermetic_reproduction",
+        "authority",
+    }
+    expected_receipt_fields = {
+        "schema_version",
+        "work_order",
+        "work_order_sha256",
+        "candidate_id",
+        "candidate_version",
+        "partition_design_version",
+        "marking",
+        "candidate_package",
+        "candidate_manifest_sidecar",
+        "sealed_hermetic_reproduction",
+        "final_holdout_opened",
+        "authority",
+    }
+    if set(external) != expected_external_fields or set(receipt) != expected_receipt_fields:
+        raise ReleaseError("DWO-04 sidecar field set is not exact")
+    common_identity = {
+        "work_order": WORK_ORDER,
+        "work_order_sha256": WORK_ORDER_SHA256,
+        "candidate_id": CANDIDATE_ID,
+        "candidate_version": CANDIDATE_VERSION,
+        "partition_design_version": DEFAULT_PARTITION_DESIGN.version,
+        "marking": MARKING,
+        "candidate_package": package_record,
+        "authority": AUTHORITY,
+    }
+    if any(external.get(key) != value for key, value in common_identity.items()):
+        raise ReleaseError("external candidate manifest identity is invalid")
+    if any(receipt.get(key) != value for key, value in common_identity.items()):
+        raise ReleaseError("candidate receipt identity is invalid")
+    if external.get("schema_version") != EXTERNAL_MANIFEST_SCHEMA_VERSION:
+        raise ReleaseError("external candidate manifest schema is invalid")
+    if receipt.get("schema_version") != RECEIPT_SCHEMA_VERSION or receipt.get(
+        "final_holdout_opened"
+    ) != "NO":
+        raise ReleaseError("candidate receipt schema/holdout status is invalid")
+    embedded_bytes = canonical_json_bytes(embedded_manifest)
+    if external.get("embedded_manifest") != {
+        "archive_path": MANIFEST_ARCHIVE_PATH,
+        "sha256": _sha256_bytes(embedded_bytes),
+        "size_bytes": len(embedded_bytes),
+    }:
+        raise ReleaseError("external manifest does not bind the embedded manifest")
+    external_payload = _read_regular_file(
+        external_path,
+        purpose="DWO-04 external candidate manifest",
+    )
+    if receipt.get("candidate_manifest_sidecar") != {
+        "filename": EXTERNAL_MANIFEST_NAME,
+        "sha256": _sha256_bytes(external_payload),
+        "size_bytes": len(external_payload),
+    }:
+        raise ReleaseError("candidate receipt does not bind the external manifest")
+    expected_count = embedded_manifest["reproduction"][  # type: ignore[index]
+        "candidate_only_hermetic"
+    ]["named_test_evidence"]["collected"]
+    if isinstance(expected_count, bool) or not isinstance(expected_count, int):
+        raise ReleaseError("embedded hermetic collection count is invalid")
+    licensed_lane = embedded_manifest["reproduction"][  # type: ignore[index]
+        "licensed_fixture_regression"
+    ]
+    full_names = licensed_lane["named_test_evidence"]["named_tests"]
+    if not isinstance(full_names, list):
+        raise ReleaseError("embedded full named-test inventory is invalid")
+    expected_full_inventory = _named_test_inventory(full_names)
+    _validate_sealed_reproduction_record(
+        external.get("sealed_hermetic_reproduction"),
+        package_record=package_record,
+        expected_count=expected_count,
+        expected_full_inventory=expected_full_inventory,
+    )
+    _validate_sealed_reproduction_record(
+        receipt.get("sealed_hermetic_reproduction"),
+        package_record=package_record,
+        expected_count=expected_count,
+        expected_full_inventory=expected_full_inventory,
+    )
+    if external["sealed_hermetic_reproduction"] != receipt[
+        "sealed_hermetic_reproduction"
+    ]:
+        raise ReleaseError("sidecar sealed-reproduction records disagree")
+    return {"manifest": external, "receipt": receipt}
+
