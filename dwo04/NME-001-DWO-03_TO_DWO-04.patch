+def _candidate_diff_reconstruction_evidence(project: Path) -> dict[str, object]:
+    baseline_package = project / DWO03_PACKAGE_ARCHIVE_PATH
+    baseline_payload = _read_regular_file(
+        baseline_package,
+        purpose="exact DWO-03 candidate-diff baseline",
+    )
+    if (
+        len(baseline_payload) != 744_862
+        or _sha256_bytes(baseline_payload) != DWO03_CANDIDATE_PACKAGE_SHA256
+    ):
+        raise ReleaseError("candidate diff baseline is not the exact DWO-03 candidate")
+    patch_path = project / CANDIDATE_DIFF_ARCHIVE_PATH
+    patch_payload = _read_regular_file(patch_path, purpose="DWO-03-to-DWO-04 patch")
+    try:
+        patch_text = patch_payload.decode("utf-8")
+    except UnicodeError as exc:
+        raise ReleaseError("DWO-03-to-DWO-04 patch is not UTF-8") from exc
+    canonical_patch = canonical_candidate_patch_bytes(project)
+    if patch_payload != canonical_patch:
+        raise ReleaseError(
+            "DWO-03-to-DWO-04 patch is not the complete canonical scoped diff"
+        )
+    if not patch_text.startswith("diff --git "):
+        raise ReleaseError("DWO-03-to-DWO-04 patch lacks canonical git diff headers")
+    if any(
+        line.startswith(("rename from ", "rename to ", "copy from ", "copy to "))
+        for line in patch_text.splitlines()
+    ):
+        raise ReleaseError("DWO-03-to-DWO-04 patch contains rename/copy headers")
+    if (
+        f" a/{CANDIDATE_DIFF_ARCHIVE_PATH}" in patch_text
+        or f" b/{CANDIDATE_DIFF_ARCHIVE_PATH}" in patch_text
+    ):
+        raise ReleaseError("candidate diff must exclude itself")
+    allowed_exact = {"README.md", "pyproject.toml", "uv.lock"}
+    allowed_prefixes = (
+        "src/",
+        "tests/",
+        "config/",
+        "governance/",
+        "docs/",
+        "data/receipts/",
+    )
+    diff_headers = [
+        line for line in patch_text.splitlines() if line.startswith("diff --git ")
+    ]
+    for header in diff_headers:
+        fields = header.split(" ")
+        if len(fields) != 4 or not fields[2].startswith("a/") or not fields[3].startswith("b/"):
+            raise ReleaseError("candidate diff contains a noncanonical path header")
+        for field in fields[2:]:
+            name = field[2:]
+            _safe_archive_name(name)
+            if name == CANDIDATE_DIFF_ARCHIVE_PATH or not (
+                name in allowed_exact
+                or any(name.startswith(prefix) for prefix in allowed_prefixes)
+            ):
+                raise ReleaseError(
+                    f"candidate diff path is outside the exact snapshot scope: {name}"
+                )
+    target_snapshot = _candidate_source_snapshot(project)
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo04-diff-") as temporary:
+        baseline = Path(temporary) / "baseline"
+        baseline.mkdir()
+        try:
+            with zipfile.ZipFile(io.BytesIO(baseline_payload)) as archive:
+                archive.extractall(baseline)
+        except zipfile.BadZipFile as exc:  # pragma: no cover - exact hash is pinned
+            raise ReleaseError("exact DWO-03 baseline is not a readable ZIP") from exc
+        for check_only in (True, False):
+            command = ["git", "apply", "--whitespace=nowarn"]
+            if check_only:
+                command.append("--check")
+            command.append(str(patch_path))
+            try:
+                completed = subprocess.run(
+                    command,
+                    cwd=baseline,
+                    env=_subprocess_environment(
+                        {
+                            "GIT_ATTR_NOSYSTEM": "1",
+                            "GIT_CONFIG_GLOBAL": os.devnull,
+                            "GIT_CONFIG_NOSYSTEM": "1",
+                            "GIT_CONFIG_SYSTEM": os.devnull,
+                            "GIT_TERMINAL_PROMPT": "0",
+                            "LC_ALL": "C",
+                            "TZ": "UTC",
+                        }
+                    ),
+                    check=False,
+                    capture_output=True,
+                    text=True,
+                    timeout=120,
+                )
+            except (OSError, subprocess.TimeoutExpired) as exc:
+                raise ReleaseError("unable to apply the DWO-04 candidate diff") from exc
+            if completed.returncode != 0:
+                raise ReleaseError(
+                    "DWO-04 candidate diff does not apply to the exact DWO-03 "
+                    f"baseline: {completed.stderr[-2000:]!r}"
+                )
+        reconstructed_snapshot = _candidate_source_snapshot(baseline)
+    if reconstructed_snapshot != target_snapshot:
+        missing = sorted(set(target_snapshot) - set(reconstructed_snapshot))
+        extra = sorted(set(reconstructed_snapshot) - set(target_snapshot))
+        changed = sorted(
+            name
+            for name in set(target_snapshot) & set(reconstructed_snapshot)
+            if target_snapshot[name] != reconstructed_snapshot[name]
+        )
+        raise ReleaseError(
+            "DWO-04 candidate diff reconstruction disagrees with the candidate "
+            f"snapshot: missing={missing[:20]!r}; extra={extra[:20]!r}; "
+            f"changed={changed[:20]!r}"
+        )
+    snapshot_payload = canonical_json_bytes(target_snapshot)
+    return {
+        "status": "PASS",
+        "baseline": {
+            "archive_path": DWO03_PACKAGE_ARCHIVE_PATH,
+            "size_bytes": len(baseline_payload),
+            "sha256": DWO03_CANDIDATE_PACKAGE_SHA256,
+        },
+        "patch": {
+            "archive_path": CANDIDATE_DIFF_ARCHIVE_PATH,
+            "size_bytes": len(patch_payload),
+            "sha256": _sha256_bytes(patch_payload),
+        },
+        "snapshot_scope": [
+            "README.md",
+            "pyproject.toml",
+            "uv.lock",
+            "src/",
+            "tests/",
+            "config/",
+            "governance/",
+            "docs/",
+            "data/receipts/",
+        ],
+        "excluded_self_referential_path": CANDIDATE_DIFF_ARCHIVE_PATH,
+        "reconstructed_file_count": len(target_snapshot),
+        "reconstructed_snapshot_sha256": _sha256_bytes(snapshot_payload),
+        "byte_for_byte_identical": True,
+        "authority": "NONE",
+    }
+
+
+def _file_record(path: Path) -> dict[str, object]:
+    payload = _read_regular_file(path, purpose="release input")
+    return {"sha256": _sha256_bytes(payload), "size_bytes": len(payload)}
+
+
+def _bounded_regular_file_size(
+    path: Path,
+    *,
+    maximum: int,
+    purpose: str,
+) -> int:
+    if path.is_symlink() or not path.is_file():
+        raise ReleaseError(f"{purpose} must be a regular non-symlink file")
+    try:
+        size = path.stat().st_size
+    except OSError as exc:
+        raise ReleaseError(f"unable to stat {purpose}") from exc
+    if size <= 0 or size > maximum:
+        raise ReleaseError(f"{purpose} size is outside the safe bound")
+    return size
+
+
+def _canonical_junit_bytes(evidence: Mapping[str, object]) -> bytes:
+    names = evidence.get("named_tests")
+    if not isinstance(names, list) or not names:
+        raise ReleaseError("named JUnit evidence is empty")
+    cases: list[str] = []
+    for identity in sorted(names):
+        if not isinstance(identity, str) or "::" not in identity:
+            raise ReleaseError("named JUnit identity is malformed")
+        classname, name = identity.rsplit("::", 1)
+        cases.append(
+            '<testcase classname="'
+            + escape(classname, quote=True)
+            + '" name="'
+            + escape(name, quote=True)
+            + '"/>'
+        )
+    count = len(cases)
+    return (
+        f'<testsuites tests="{count}" failures="0" errors="0" skipped="0">'
+        f'<testsuite name="pytest" tests="{count}" failures="0" '
+        f'errors="0" skipped="0">{"".join(cases)}</testsuite>'
+        "</testsuites>\n"
+    ).encode("utf-8")
+
+
+def _supplied_junit_evidence(path: Path) -> dict[str, Any]:
+    if path.is_symlink() or not path.is_file():
+        raise ReleaseError(f"supplied JUnit must be a regular non-symlink file: {path}")
+    if path.stat().st_size <= 0 or path.stat().st_size > MAX_SUPPLIED_JUNIT_BYTES:
+        raise ReleaseError("supplied JUnit size is outside the safe bound")
+    return _junit_evidence(path)
+
+
+def _nodeid_to_junit_identity(nodeid: str) -> str:
+    parts = nodeid.split("::")
+    if len(parts) < 2 or not parts[0].endswith(".py"):
+        raise ReleaseError(f"pytest emitted a noncanonical node id: {nodeid!r}")
+    module = parts[0][:-3].replace("/", ".").replace("\\", ".")
+    classname = ".".join((module, *parts[1:-1]))
+    return f"{classname}::{parts[-1]}"
+
+
+def _collect_named_tests_unbound(project: Path, *, licensed: bool) -> list[str]:
+    command = [
+        "uv",
+        "run",
+        "--locked",
+        "--extra",
+        "dev",
+        "pytest",
+        "--collect-only",
+        "-q",
+        "-p",
+        "no:cacheprovider",
+    ]
+    if licensed:
+        command.append("--licensed-fixture-inventory-only")
+    environment = _subprocess_environment(LOCKED_TEST_ENVIRONMENT)
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=project,
+            env=environment,
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=180,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise ReleaseError("unable to collect the candidate named-test set") from exc
+    if completed.returncode != 0:
+        raise ReleaseError(
+            "candidate test collection failed: "
+            f"exit={completed.returncode}; stdout={completed.stdout[-2000:]!r}; "
+            f"stderr={completed.stderr[-2000:]!r}"
+        )
+    # Keep any plain output line whose first component is a .py test path and
+    # ignore pytest's prose summary.
+    nodeids = [
+        line.strip()
+        for line in completed.stdout.splitlines()
+        if "::" in line and line.strip().split("::", 1)[0].endswith(".py")
+    ]
+    identities = sorted(_nodeid_to_junit_identity(nodeid) for nodeid in nodeids)
+    if not identities or len(identities) != len(set(identities)):
+        raise ReleaseError("candidate named-test collection is empty or nonunique")
+    return identities
+
+
+def _collect_named_tests(project: Path, *, licensed: bool) -> list[str]:
+    identities = _collect_named_tests_unbound(project, licensed=licensed)
+    _assert_frozen_collection(identities, licensed=licensed)
+    return identities
+
+
+def compute_collection_bindings(project: str | Path) -> dict[str, object]:
+    """Compute, but do not silently adopt, the final DWO-04 test identities."""
+
+    root = Path(project).absolute()
+    if root.is_symlink() or not root.is_dir():
+        raise ReleaseError("collection-binding project must be a non-symlink directory")
+    source_before = _candidate_source_snapshot(root)
+    lanes: dict[str, object] = {}
+    named_collections: dict[str, list[str]] = {}
+    for lane, licensed in (("hermetic", False), ("licensed", True)):
+        names = _collect_named_tests_unbound(root, licensed=licensed)
+        named_collections[lane] = names
+        lanes[lane] = {
+            "count": len(names),
+            "named_tests_sha256": _sha256_bytes(
+                canonical_json_bytes(sorted(names))
+            ),
+        }
+    if _candidate_source_snapshot(root) != source_before:
+        raise ReleaseError(
+            "candidate source bytes changed during collection binding"
+        )
+    hermetic = lanes["hermetic"]
+    licensed = lanes["licensed"]
+    if not isinstance(hermetic, dict) or not isinstance(licensed, dict):
+        raise ReleaseError("computed collection binding is malformed")
+    if not set(named_collections["hermetic"]) < set(named_collections["licensed"]):
+        raise ReleaseError(
+            "licensed inventory must be a strict named-test superset of hermetic"
+        )
+    return {
+        "work_order": EXPECTED_WORK_ORDER,
+        "work_order_sha256": EXPECTED_WORK_ORDER_SHA256,
+        "candidate_id": EXPECTED_CANDIDATE_ID,
+        "candidate_version": EXPECTED_CANDIDATE_VERSION,
+        "hermetic": hermetic,
+        "licensed": licensed,
+    }
+
+
+def _bound_collection_values(*, licensed: bool) -> tuple[int, str]:
+    count = LICENSED_COLLECTION_COUNT if licensed else HERMETIC_COLLECTION_COUNT
+    digest = (
+        LICENSED_COLLECTION_SHA256 if licensed else HERMETIC_COLLECTION_SHA256
+    )
+    if (
+        isinstance(count, bool)
+        or not isinstance(count, int)
+        or count <= 0
+        or not isinstance(digest, str)
+        or len(digest) != 64
+        or any(character not in "0123456789abcdef" for character in digest)
+    ):
+        raise ReleaseError(
+            "DWO-04 named-test collection bindings are not finalized; run "
+            "the collection-bindings command after all test lanes merge, then "
+            "bind its independently reviewed count/digest values"
+        )
+    return count, digest
+
+
+def _assert_frozen_collection(names: list[str], *, licensed: bool) -> None:
+    expected_count, expected_sha256 = _bound_collection_values(licensed=licensed)
+    observed_sha256 = _sha256_bytes(canonical_json_bytes(sorted(names)))
+    lane = "licensed" if licensed else "hermetic"
+    if len(names) != expected_count or observed_sha256 != expected_sha256:
+        raise ReleaseError(
+            f"{lane} pytest collection does not match the frozen DWO-04 "
+            "count and named-test digest"
+        )
+
+
+def _frozen_collection_contract(*, licensed: bool) -> dict[str, object]:
+    count, digest = _bound_collection_values(licensed=licensed)
+    return {
+        "count": count,
+        "named_tests_sha256": digest,
+    }
+
+
+def _named_test_inventory(names: list[str]) -> dict[str, object]:
+    ordered = sorted(names)
+    if not ordered or len(ordered) != len(set(ordered)):
+        raise ReleaseError("named-test inventory is empty or nonunique")
+    return {
+        "collected": len(ordered),
+        "named_tests_sha256": _sha256_bytes(canonical_json_bytes(ordered)),
+        "named_tests": ordered,
+    }
+
+
+def _run_licensed_regression(project: Path, junit_output: Path) -> dict[str, Any]:
+    command = list(LICENSED_COMMAND)
+    actual_output = project / "pytest_dwo04_licensed.xml"
+    if actual_output.is_symlink():
+        raise ReleaseError("licensed rerun JUnit destination must not be a symlink")
+    previous_identity = None
+    if actual_output.is_file():
+        previous_identity = (
+            actual_output.stat().st_mtime_ns,
+            actual_output.stat().st_size,
+            _sha256_bytes(actual_output.read_bytes()),
+        )
+    environment = _subprocess_environment(LOCKED_TEST_ENVIRONMENT)
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=project,
+            env=environment,
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=900,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise ReleaseError("licensed regression rerun could not complete") from exc
+    if completed.returncode != 0:
+        raise ReleaseError(
+            "licensed regression rerun failed: "
+            f"exit={completed.returncode}; stdout={completed.stdout[-2000:]!r}; "
+            f"stderr={completed.stderr[-2000:]!r}"
+        )
+    if actual_output.is_symlink() or not actual_output.is_file():
+        raise ReleaseError("licensed regression did not produce its exact JUnit output")
+    current_identity = (
+        actual_output.stat().st_mtime_ns,
+        actual_output.stat().st_size,
+        _sha256_bytes(actual_output.read_bytes()),
+    )
+    if previous_identity is not None and current_identity == previous_identity:
+        raise ReleaseError("licensed regression left a stale pre-existing JUnit output")
+    evidence = _junit_evidence(actual_output)
+    junit_output.write_bytes(actual_output.read_bytes())
+    return evidence
+
+
+def _entry_records(entries: Mapping[str, Path]) -> dict[str, dict[str, object]]:
+    return {name: _file_record(path) for name, path in sorted(entries.items())}
+
+
+def _validate_entry_size_bounds(entries: Mapping[str, Path]) -> None:
+    total = 0
+    for name, path in entries.items():
+        if path.is_symlink() or not path.is_file():
+            raise ReleaseError(f"release entry is not a regular file: {name}")
+        try:
+            size = path.stat().st_size
+        except OSError as exc:
+            raise ReleaseError(f"unable to stat release entry: {name}") from exc
+        if size < 0 or size > MAX_MEMBER_UNCOMPRESSED_BYTES:
+            raise ReleaseError(f"release entry exceeds the size bound: {name}")
+        total += size
+        if total > MAX_TOTAL_UNCOMPRESSED_BYTES:
+            raise ReleaseError("release entries exceed the total size bound")
+
+
+def _assert_no_licensed_payload_records(
+    records: Mapping[str, Mapping[str, object]],
+) -> None:
+    forbidden = {
+        (record["size_bytes"], record["sha256"])
+        for record in contract_records()
+    }
+    for name, record in records.items():
+        if (record.get("size_bytes"), record.get("sha256")) in forbidden:
+            raise ReleaseError(
+                "candidate content matches an exact licensed fixture under a "
+                f"disguised or prohibited path: {name}"
+            )
+
+
+def _verify_textual_release_entries(entries: Mapping[str, Path]) -> None:
+    for name, path in entries.items():
+        if name in _SPECIAL_ARTIFACT_MEMBERS:
+            continue
+        payload = _read_regular_file(path, purpose=f"textual release member {name}")
+        try:
+            payload.decode("utf-8")
+        except UnicodeError as exc:
+            raise ReleaseError(f"textual release member is not UTF-8: {name}") from exc
+        if any(byte < 32 and byte not in {9, 10, 13} for byte in payload):
+            raise ReleaseError(f"textual release member contains control bytes: {name}")
+
+
+def _expected_receipt_records() -> dict[str, dict[str, object]]:
+    expected: dict[str, dict[str, object]] = {}
+    for contract in contract_records():
+        name = contract.get("receipt_relative_path")
+        size = contract.get("receipt_size_bytes")
+        digest = contract.get("receipt_sha256")
+        if (
+            not isinstance(name, str)
+            or not name.startswith("data/receipts/")
+            or isinstance(size, bool)
+            or not isinstance(size, int)
+            or size <= 0
+            or not isinstance(digest, str)
+            or re.fullmatch(r"[0-9a-f]{64}", digest) is None
+            or name in expected
+        ):
+            raise ReleaseError("licensed receipt contract is malformed")
+        expected[name] = {"sha256": digest, "size_bytes": size}
+    if not expected:
+        raise ReleaseError("licensed receipt contract is empty")
+    return expected
+
+
+def _verify_exact_receipt_records(
+    records: Mapping[str, Mapping[str, object]],
+) -> None:
+    expected = _expected_receipt_records()
+    observed_names = {
+        name for name in records if name.startswith("data/receipts/")
+    }
+    if observed_names != set(expected):
+        raise ReleaseError(
+            "candidate receipt inventory is not the exact frozen path set"
+        )
+    for name, record in expected.items():
+        if records.get(name) != record:
+            raise ReleaseError(f"candidate receipt identity changed: {name}")
+
+
+def _validate_entry_name_bounds(entries: Mapping[str, Path]) -> None:
+    if len(entries) > MAX_ARCHIVE_MEMBERS - GENERATED_ARCHIVE_MEMBER_RESERVE:
+        raise ReleaseError("release inventory exceeds the fail-closed member bound")
+    total = 0
+    for name in entries:
+        size = len(name.encode("utf-8"))
+        if size <= 0 or size > MAX_ARCHIVE_MEMBER_NAME_BYTES:
+            raise ReleaseError("release member name exceeds the fail-closed byte bound")
+        total += size
+        if total > MAX_TOTAL_ARCHIVE_NAME_BYTES:
+            raise ReleaseError(
+                "release member names exceed the fail-closed cumulative byte bound"
+            )
+
+
+def _validate_release_entry_inventory(entries: Mapping[str, Path]) -> None:
+    _validate_entry_name_bounds(entries)
+    for name in entries:
+        if _forbidden_member(name) or not _allowed_member(name):
+            raise ReleaseError(
+                f"project release inventory contains a prohibited path/type: {name}"
+            )
+    _verify_textual_release_entries(entries)
+    records = _entry_records(entries)
+    _assert_no_licensed_payload_records(records)
+    _verify_exact_receipt_records(records)
+
+
+def _licensed_scan_fixture_contract() -> list[dict[str, object]]:
+    return [
+        {
+            "relative_path": record["relative_path"],
+            "size_bytes": record["size_bytes"],
+            "sha256": record["sha256"],
+        }
+        for record in contract_records()
+    ]
+
+
+def _licensed_scan_inventory_evidence(
+    records: Mapping[str, Mapping[str, object]],
+) -> dict[str, object]:
+    scanned = {
+        name: dict(record)
+        for name, record in sorted(records.items())
+        if name not in _LICENSED_SCAN_CONTENT_EXCLUSIONS
+    }
+    excluded = {
+        name: dict(record)
+        for name, record in sorted(records.items())
+        if name in _LICENSED_SCAN_CONTENT_EXCLUSIONS
+    }
+    names = sorted(records)
+    scanned_byte_count = sum(
+        int(record["size_bytes"]) for record in scanned.values()
+    )
+    if scanned_byte_count > MAX_LICENSED_SCAN_TEXT_BYTES:
+        raise ReleaseError(
+            "licensed fragment-scan inventory exceeds its bound"
+        )
+    return {
+        "manifest_recorded_member_count": len(records),
+        "manifest_recorded_inventory_sha256": _sha256_bytes(
+            canonical_json_bytes(records)
+        ),
+        "manifest_recorded_name_count": len(names),
+        "manifest_recorded_name_sha256": _sha256_bytes(canonical_json_bytes(names)),
+        "manifest_self_member_excluded": True,
+        "content_scanned_member_count": len(scanned),
+        "content_scanned_byte_count": scanned_byte_count,
+        "content_scanned_inventory_sha256": _sha256_bytes(
+            canonical_json_bytes(scanned)
+        ),
+        "content_excluded_exact_members": excluded,
+        "content_exclusion_policy": (
+            "EXACT_PINNED_HISTORICAL_OR_MACHINE_EVIDENCE_VERIFIED_SEPARATELY"
+        ),
+    }
+
+
+_ROLLING_HASH_BASE = 257
+_ROLLING_HASH_MASK = (1 << 64) - 1
+_ROLLING_HASH_TABLE_MULTIPLIER = 11_400_714_819_323_198_485
+
+
+def _rolling_window_hashes(payload: bytes, width: int) -> Any:
+    """Yield deterministic 64-bit rolling hashes and exact window offsets."""
+
+    if width <= 0 or len(payload) < width:
+        return
+    value = 0
+    for byte in payload[:width]:
+        value = ((value * _ROLLING_HASH_BASE) + byte) & _ROLLING_HASH_MASK
+    yield value, 0
+    leading_factor = pow(_ROLLING_HASH_BASE, width - 1, 1 << 64)
+    for offset in range(1, len(payload) - width + 1):
+        outgoing = payload[offset - 1]
+        incoming = payload[offset + width - 1]
+        value = (
+            ((value - (outgoing * leading_factor)) * _ROLLING_HASH_BASE)
+            + incoming
+        ) & _ROLLING_HASH_MASK
+        yield value, offset
+
+
+def _rolling_hash_table(payload: bytes, width: int) -> tuple[array, int]:
+    """Build a compact open-addressed table for all windows in ``payload``."""
+
+    window_count = max(0, len(payload) - width + 1)
+    if window_count == 0:
+        return array("Q"), 0
+    capacity = 1
+    while capacity < window_count * 2:
+        capacity <<= 1
+    table = array("Q", [0]) * capacity
+    mask = capacity - 1
+    for value, _offset in _rolling_window_hashes(payload, width):
+        # Zero marks an empty slot.  Mapping the two edge values to the same
+        # nonzero key can create only a false-positive lookup; the exact byte
+        # confirmation below prevents that from becoming a rejection.
+        key = ((value + 1) & _ROLLING_HASH_MASK) or 1
+        slot = (key * _ROLLING_HASH_TABLE_MULTIPLIER) & mask
+        while table[slot] not in {0, key}:
+            slot = (slot + 1) & mask
+        table[slot] = key
+    return table, mask
+
+
+def _rolling_hash_table_contains(table: array, mask: int, value: int) -> bool:
+    if not table:
+        return False
+    key = ((value + 1) & _ROLLING_HASH_MASK) or 1
+    slot = (key * _ROLLING_HASH_TABLE_MULTIPLIER) & mask
+    while table[slot] != 0:
+        if table[slot] == key:
+            return True
+        slot = (slot + 1) & mask
+    return False
+
+
+def _assert_no_rolling_fragment_match(
+    candidate: bytes,
+    fixture_forms: list[tuple[str, str, bytes]],
+) -> None:
+    """Reject any exactly confirmed common rolling window."""
+
+    width = LICENSED_FRAGMENT_SCAN_CHUNK_BYTES
+    table, mask = _rolling_hash_table(candidate, width)
+    try:
+        for relative, form, fixture in fixture_forms:
+            for value, offset in _rolling_window_hashes(fixture, width):
+                if not _rolling_hash_table_contains(table, mask, value):
+                    continue
+                chunk = fixture[offset : offset + width]
+                if chunk in candidate:
+                    raise ReleaseError(
+                        "release text contains licensed fixture material: "
+                        f"{relative} ({form}, contiguous {width}-byte fragment)"
+                    )
+    finally:
+        del table
+
+
+def _ascii_whitespace_compact(payload: bytes) -> bytes:
+    return payload.translate(None, b" \t\r\n\v\f")
+
+
+def _hex_separator_compact(payload: bytes) -> bytes:
+    lowered = payload.lower().replace(b"0x", b"")
+    return bytes(byte for byte in lowered if byte in b"0123456789abcdef")
+
+
+def _assert_no_indexed_raw_line(
+    payload: bytes,
+    raw_line_index: Mapping[bytes, list[tuple[str, bytes]]],
+    *,
+    context: str,
+) -> None:
+    for candidate_line in payload.splitlines():
+        if len(candidate_line) < LICENSED_RAW_LINE_SCAN_MIN_BYTES:
+            continue
+        last = len(candidate_line) - LICENSED_RAW_LINE_SCAN_MIN_BYTES + 1
+        for offset in range(last):
+            matches = raw_line_index.get(
+                candidate_line[offset : offset + LICENSED_RAW_LINE_SCAN_MIN_BYTES]
+            )
+            if matches is None:
+                continue
+            for relative, raw_line in matches:
+                if raw_line in candidate_line:
+                    raise ReleaseError(
+                        "release text contains a complete licensed fixture line: "
+                        f"{context} ({relative})"
+                    )
+
+
+def _licensed_payload_exclusion_scan(
+    project: Path,
+    entries: Mapping[str, Path],
+) -> dict[str, object]:
+    """Reject raw/base64/hex fixture material hidden in allowed text."""
+
+    raw_fixture_forms: list[tuple[str, str, bytes]] = []
+    encoded_fixture_forms: list[tuple[str, str, bytes]] = []
+    raw_line_index: dict[bytes, list[tuple[str, bytes]]] = {}
+    for record in _licensed_scan_fixture_contract():
+        relative = record["relative_path"]
+        expected_size = record["size_bytes"]
+        expected_sha256 = record["sha256"]
+        if (
+            not isinstance(relative, str)
+            or isinstance(expected_size, bool)
+            or not isinstance(expected_size, int)
+            or not isinstance(expected_sha256, str)
+        ):
+            raise ReleaseError("licensed fragment-scan contract is malformed")
+        source = project / relative
+        if source.is_symlink() or not source.is_file():
+            raise ReleaseError("licensed fragment scan requires exact verified fixtures")
+        if source.stat().st_size != expected_size:
+            raise ReleaseError("licensed fragment-scan fixture size changed")
+        raw = _read_regular_file(source, purpose="licensed fragment-scan fixture")
+        if _sha256_bytes(raw) != expected_sha256:
+            raise ReleaseError("licensed fragment-scan fixture hash changed")
+        raw_fixture_forms.append((relative, "raw", raw))
+        encoded_fixture_forms.extend(
+            (
+                (
+                    relative,
+                    f"base64-phase-{phase}-whitespace-normalized",
+                    base64.b64encode(raw[phase:]),
+                )
+                for phase in range(3)
+                if len(raw) - phase >= LICENSED_FRAGMENT_SCAN_CHUNK_BYTES
+            )
+        )
+        encoded_fixture_forms.append(
+            (
+                relative,
+                "hex-non-hexdigit-normalized",
+                raw.hex().encode("ascii"),
+            )
+        )
+        for line in raw.splitlines():
+            if len(line) < LICENSED_RAW_LINE_SCAN_MIN_BYTES:
+                continue
+            prefix = line[:LICENSED_RAW_LINE_SCAN_MIN_BYTES]
+            raw_line_index.setdefault(prefix, []).append((relative, line))
+
+    member_payloads: list[tuple[str, bytes]] = []
+    total_text_bytes = 0
+    for name, path in sorted(entries.items()):
+        if name in _LICENSED_SCAN_CONTENT_EXCLUSIONS:
+            continue
+        payload = _read_regular_file(path, purpose=f"licensed fragment scan {name}")
+        total_text_bytes += len(payload)
+        if total_text_bytes > MAX_LICENSED_SCAN_TEXT_BYTES:
+            raise ReleaseError(
+                "release text exceeds the fail-closed licensed fragment-scan bound"
+            )
+        member_payloads.append((name, payload))
+
+        _assert_no_indexed_raw_line(
+            payload,
+            raw_line_index,
+            context=name,
+        )
+
+    try:
+        names = [name.encode("ascii") for name in sorted(entries)]
+    except UnicodeEncodeError as exc:  # fail cleanly when called independently
+        raise ReleaseError("licensed fragment scan requires ASCII member names") from exc
+    raw_name_candidate = b"\n".join(names)
+    structural_name_candidate = b"".join(
+        name.replace(b"/", b"") for name in names
+    )
+    encoded_name_candidate = bytes(
+        byte
+        for name in names
+        for byte in name
+        if byte not in b"/._-"
+    )
+    raw_candidate = (
+        raw_name_candidate
+        + b"\n"
+        + structural_name_candidate
+        + b"\n"
+        + b"".join(payload for _name, payload in member_payloads)
+    )
+    _assert_no_indexed_raw_line(
+        raw_candidate,
+        raw_line_index,
+        context="SORTED_MEMBER_CONCATENATION",
+    )
+    compact_candidate = b"".join(
+        _ascii_whitespace_compact(payload) for _name, payload in member_payloads
+    ) + encoded_name_candidate
+    hex_candidate = _hex_separator_compact(raw_candidate)
+    _assert_no_rolling_fragment_match(raw_candidate, raw_fixture_forms)
+    _assert_no_rolling_fragment_match(
+        compact_candidate,
+        [form for form in encoded_fixture_forms if form[1].startswith("base64")],
+    )
+    _assert_no_rolling_fragment_match(
+        hex_candidate,
+        [form for form in encoded_fixture_forms if form[1].startswith("hex")],
+    )
+
+    records = _entry_records(entries)
+    return {
+        "schema_version": LICENSED_FRAGMENT_SCAN_SCHEMA_VERSION,
+        "status": "PASS",
+        "execution_scope": "PACKAGE_TIME_FIXTURE_BACKED",
+        "standalone_verifier_scope": "RECORD_AND_INVENTORY_ONLY",
+        "methods": list(LICENSED_FRAGMENT_SCAN_METHODS),
+        "minimum_contiguous_fragment_bytes": LICENSED_FRAGMENT_SCAN_CHUNK_BYTES,
+        "contiguous_fragment_threshold_unit": "NORMALIZED_REPRESENTATION_BYTES",
+        "minimum_complete_raw_line_bytes": LICENSED_RAW_LINE_SCAN_MIN_BYTES,
+        "maximum_scanned_text_bytes": MAX_LICENSED_SCAN_TEXT_BYTES,
+        "fixture_contract": _licensed_scan_fixture_contract(),
+        **_licensed_scan_inventory_evidence(records),
+        "authority": "NONE",
+    }
+
