+            "source_regression_protocol_version": "1.0.1",
+            "trading_authority": "NONE",
+            "work_order": EXPECTED_WORK_ORDER,
+        }
+        or
+        not isinstance(model_full, dict)
+        or model_full.get("fit_rows") != 0
+        or model_full.get("technical_not_issued_rows") != 9
+        or model_full.get("ood_abstain_rows") != 0
+        or model_full.get("issued_rows") != 0
+        or model_full.get("scorable_rows") != 0
+        or not isinstance(fit, dict)
+        or fit.get("status") != "PASS"
+        or fit.get("issued_or_ood_rows_total")
+        != fit.get("issued_or_ood_rows_with_successful_fit")
+        or not isinstance(clearance, dict)
+        or clearance.get("clears_all") is not False
+        or clearance.get("status")
+        != "FAIL_CLOSED_EXPLORATORY_ACQUISITION_PROPOSAL"
