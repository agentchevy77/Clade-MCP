+def _clopper_pearson_two_sided(
+    successes: int,
+    trials: int,
+    *,
+    confidence_level: float,
+) -> tuple[float, float]:
+    if (
+        isinstance(successes, bool)
+        or not isinstance(successes, int)
+        or isinstance(trials, bool)
+        or not isinstance(trials, int)
+        or trials <= 0
+        or not 0 <= successes <= trials
+    ):
+        raise CapacityReconciliationError(
+            "session-incidence observations must satisfy 0 <= successes <= trials"
+        )
+    if (
+        isinstance(confidence_level, bool)
+        or not isinstance(confidence_level, (int, float))
+        or not 0.0 < float(confidence_level) < 1.0
+    ):
+        raise CapacityReconciliationError(
+            "session-incidence confidence level must lie strictly inside (0, 1)"
+        )
+    alpha_half = (1.0 - float(confidence_level)) / 2.0
+    lower = (
+        0.0
+        if successes == 0
+        else float(beta.ppf(alpha_half, successes, trials - successes + 1))
+    )
+    upper = (
+        1.0
+        if successes == trials
+        else float(beta.ppf(1.0 - alpha_half, successes + 1, trials - successes))
+    )
+    return lower, upper
+
+
+def technical_event_session_incidence_sensitivity(
+    *,
+    technical_origin_rows: int,
+    technical_event_sessions: Sequence[date],
+    outer_test_sessions: int,
+    confidence_level: float = 0.95,
+) -> TechnicalSessionIncidenceSensitivity:
+    """Describe 9/84 as session incidence, never as Bernoulli origins."""
+
+    if (
+        isinstance(confidence_level, bool)
+        or not isinstance(confidence_level, (int, float))
+        or float(confidence_level) != 0.95
+    ):
+        raise CapacityReconciliationError(
+            "the frozen TWO_SIDED_95 sensitivity requires confidence_level=0.95"
+        )
+    frozen_sessions = tuple(technical_event_sessions)
+    if tuple(sorted(set(frozen_sessions))) != frozen_sessions:
+        raise CapacityReconciliationError(
+            "technical-event session identities must be unique and ordered"
+        )
+    if (
+        isinstance(technical_origin_rows, bool)
+        or not isinstance(technical_origin_rows, int)
+        or technical_origin_rows < len(frozen_sessions)
+    ):
+        raise CapacityReconciliationError(
+            "technical origin rows cannot be fewer than distinct event sessions"
+        )
+    lower, upper = _clopper_pearson_two_sided(
+        len(frozen_sessions),
+        outer_test_sessions,
+        confidence_level=confidence_level,
+    )
+    return TechnicalSessionIncidenceSensitivity(
+        estimand=TECHNICAL_EVENT_SESSION_INCIDENCE,
+        method=CONDITIONAL_IID_BINOMIAL_SENSITIVITY_METHOD,
+        confidence_level=float(confidence_level),
+        technical_origin_rows=technical_origin_rows,
+        technical_event_distinct_sessions=len(frozen_sessions),
+        outer_test_sessions=outer_test_sessions,
+        ordered_session_identities_sha256=session_identity_sha256(
+            frozen_sessions
+        ),
+        lower=lower,
+        upper=upper,
+        unconditional_temporal_coverage_claim="NONE",
+        acquisition_clearance_vote=False,
+        interpretation_vote=False,
+        promotion_vote=False,
+        authority_vote=False,
+    )
+
+
+def _required_text(row: Mapping[str, object], field: str, context: str) -> str:
+    value = row.get(field)
+    if not isinstance(value, str) or not value:
+        raise CapacityReconciliationError(f"{context}.{field} must be nonempty text")
+    return value
+
+
+def _outer_fold(row: Mapping[str, object], context: str) -> int:
+    value = row.get("outer_fold")
+    if type(value) is int:
+        parsed = value
+    elif type(value) is str and re.fullmatch(r"[1-9][0-9]*", value):
+        parsed = int(value)
+    else:
+        raise CapacityReconciliationError(
+            f"{context}.outer_fold must be an exact positive integer or "
+            "canonical positive decimal string"
+        )
+    if parsed <= 0:
+        raise CapacityReconciliationError(
+            f"{context}.outer_fold must be an exact positive integer or "
+            "canonical positive decimal string"
+        )
+    return parsed
+
+
+def _session(row: Mapping[str, object], context: str) -> date:
+    raw = row.get("session_date")
+    if isinstance(raw, date):
+        return raw
+    value = _required_text(row, "session_date", context)
+    try:
+        return date.fromisoformat(value)
+    except ValueError as exc:
+        raise CapacityReconciliationError(
+            f"{context}.session_date is not an ISO date"
+        ) from exc
+
+
+def _unique_by_identifier(
+    rows: Iterable[Mapping[str, object]],
+    *,
+    context: str,
+) -> dict[str, Mapping[str, object]]:
+    result: dict[str, Mapping[str, object]] = {}
+    for index, row in enumerate(rows):
+        identifier = _required_text(row, "opportunity_id", f"{context}[{index}]")
+        if identifier in result:
+            raise CapacityReconciliationError(
+                f"{context} contains duplicate opportunity_id {identifier!r}"
+            )
+        result[identifier] = row
+    return result
+
+
+def _class_counts(
+    rows: Iterable[Mapping[str, object]],
+    *,
+    label_field: str,
+    context: str,
+) -> tuple[tuple[tuple[str, int], ...], tuple[tuple[str, int], ...]]:
+    row_counts: Counter[str] = Counter()
+    session_sets: dict[str, set[date]] = {label: set() for label in CLASS_ORDER}
+    for index, row in enumerate(rows):
+        label = _required_text(row, label_field, f"{context}[{index}]")
+        if label not in CLASS_ORDER:
+            raise CapacityReconciliationError(
+                f"{context}[{index}].{label_field} has unknown class {label!r}"
+            )
+        row_counts[label] += 1
+        session_sets[label].add(_session(row, f"{context}[{index}]"))
+    return (
+        tuple((label, row_counts[label]) for label in CLASS_ORDER),
+        tuple((label, len(session_sets[label])) for label in CLASS_ORDER),
+    )
+
+
+def _successful_fit_keys(
+    fit_rows: Sequence[Mapping[str, object]],
+) -> set[tuple[str, int, str]]:
+    keys: Counter[tuple[str, int, str]] = Counter()
+    for index, row in enumerate(fit_rows):
+        if row.get("status") != _SUCCESSFUL_FIT_STATUS:
+            continue
+        key = (
+            _required_text(row, "cohort", f"fit_rows[{index}]"),
+            _outer_fold(row, f"fit_rows[{index}]"),
+            _required_text(row, "model_id", f"fit_rows[{index}]"),
+        )
+        keys[key] += 1
+    duplicates = sorted(key for key, count in keys.items() if count != 1)
+    if duplicates:
+        raise CapacityReconciliationError(
+            f"successful FIT records are not unique by cohort/fold/model: {duplicates}"
+        )
+    return set(keys)
+
+
+def _reconcile_prediction_fits(
+    prediction_rows: Sequence[Mapping[str, object]],
+    fit_rows: Sequence[Mapping[str, object]],
+) -> tuple[int, int]:
+    fit_keys = _successful_fit_keys(fit_rows)
+    required = []
+    for index, row in enumerate(prediction_rows):
+        status = _required_text(
+            row,
+            "forecast_status",
+            f"prediction_rows[{index}]",
+        )
+        if status not in _FIT_REQUIRED_FORECAST_STATUSES:
+            continue
+        key = (
+            _required_text(row, "cohort", f"prediction_rows[{index}]"),
+            _outer_fold(row, f"prediction_rows[{index}]"),
+            _required_text(row, "model_id", f"prediction_rows[{index}]"),
+        )
+        required.append((index, key))
+    missing = [(index, key) for index, key in required if key not in fit_keys]
+    if missing:
+        raise CapacityReconciliationError(
+            "OOD_ABSTAIN or ISSUED prediction lacks one successful "
+            f"same-cohort/fold/model FIT record: {missing}"
+        )
+    return len(required), len(required)
+
+
+def reconcile_capacity_attrition(
+    *,
+    eligibility_rows: Sequence[Mapping[str, object]],
+    event_rows: Sequence[Mapping[str, object]],
+    prediction_rows: Sequence[Mapping[str, object]],
+    fit_rows: Sequence[Mapping[str, object]],
+    scored_rows: Sequence[Mapping[str, object]],
+    thresholds: CapacityGateThresholds,
+    confidence_level: float = 0.95,
+) -> OutputAttritionReconciliation:
+    """Reconstruct capacity attrition from output rows and fail on divergence."""
+
+    eligibility_by_id = _unique_by_identifier(
+        eligibility_rows,
+        context="eligibility_rows",
+    )
+    event_by_id = _unique_by_identifier(event_rows, context="event_rows")
+    scored_by_id = _unique_by_identifier(scored_rows, context="scored_rows")
+
+    outer_real = [
+        row
+        for row in eligibility_by_id.values()
+        if row.get("partition") == _OUTER_TEST_PARTITION
+        and row.get("cohort") == _REAL_COHORT
+    ]
+    outer_sessions = tuple(
+        sorted({_session(row, "outer_real") for row in outer_real})
+    )
+    sealed = [
+        row for row in outer_real if row.get("origin_disposition") == "EVENT_SEALED"
+    ]
+    missing_event_rows = sorted(
+        _required_text(row, "opportunity_id", "sealed")
+        for row in sealed
+        if _required_text(row, "opportunity_id", "sealed") not in event_by_id
+    )
+    if missing_event_rows:
+        raise CapacityReconciliationError(
+            f"EVENT_SEALED rows are absent from events output: {missing_event_rows}"
+        )
+
+    technically_evaluable = [
+        row
+        for row in sealed
+        if row.get("feature_status") == _TECHNICALLY_EVALUABLE_FEATURE_STATUS
+        and row.get("outcome_evaluation_status")
+        == _TECHNICALLY_EVALUABLE_OUTCOME_STATUS
+    ]
+    technical_ids = {
+        _required_text(row, "opportunity_id", "technically_evaluable")
+        for row in technically_evaluable
+    }
+    technical_event_rows = [event_by_id[identifier] for identifier in technical_ids]
+    for index, row in enumerate(technical_event_rows):
+        identifier = _required_text(
+            row,
+            "opportunity_id",
+            f"technical_event_rows[{index}]",
+        )
+        eligibility = eligibility_by_id[identifier]
+        for field in (
+            "session_date",
+            "partition",
+            "outer_fold",
+            "cohort",
+            "origin_disposition",
+            "feature_status",
+            "outcome_evaluation_status",
+        ):
+            if row.get(field) != eligibility.get(field):
+                raise CapacityReconciliationError(
+                    "technical event does not preserve its eligibility "
+                    f"identity: opportunity_id={identifier!r}, field={field!r}"
+                )
+    technical_sessions = tuple(
+        sorted({_session(row, "technically_evaluable") for row in technically_evaluable})
+    )
+    technical_class_rows, technical_class_sessions = _class_counts(
+        technical_event_rows,
+        label_field="outcome_only.label",
+        context="technical_event_rows",
+    )
+
+    primary_predictions = [
+        row
+        for row in prediction_rows
+        if row.get("model_id") == _PRIMARY_MODEL
+        and row.get("cohort") == _REAL_COHORT
+        and row.get("opportunity_id") in technical_ids
+    ]
+    primary_by_id = _unique_by_identifier(
+        primary_predictions,
+        context="model_full_prediction_rows",
+    )
+    if set(primary_by_id) != technical_ids:
+        raise CapacityReconciliationError(
+            "MODEL_FULL predictions are not an exact one-row-per-technically-"
+            "evaluable-origin join"
+        )
+    for identifier, prediction in primary_by_id.items():
+        eligibility = eligibility_by_id[identifier]
+        if (
+            prediction.get("session_date") != eligibility.get("session_date")
+            or _outer_fold(prediction, "model_full_prediction")
+            != _outer_fold(eligibility, "technical_eligibility")
+        ):
+            raise CapacityReconciliationError(
+                "MODEL_FULL prediction does not preserve its technical-origin "
+                f"session/fold identity: {identifier!r}"
+            )
+    status_counts = Counter(
+        _required_text(row, "forecast_status", "model_full_prediction")
+        for row in primary_by_id.values()
+    )
+    unknown_statuses = sorted(set(status_counts) - set(_FORECAST_STATUSES))
+    if unknown_statuses:
+        raise CapacityReconciliationError(
+            f"MODEL_FULL predictions have invalid statuses: {unknown_statuses}"
+        )
+
+    successful_fit_keys = _successful_fit_keys(fit_rows)
+    primary_fit_rows = sum(
+        1
+        for cohort, _fold, model_id in successful_fit_keys
+        if cohort == _REAL_COHORT and model_id == _PRIMARY_MODEL
+    )
+    reconciled_fit_rows, fit_required_rows = _reconcile_prediction_fits(
+        prediction_rows,
+        fit_rows,
+    )
+
+    scored_real_by_id = {
+        identifier: row
+        for identifier, row in scored_by_id.items()
+        if row.get("cohort") == _REAL_COHORT
+    }
+    unexpected_scored = sorted(set(scored_real_by_id) - technical_ids)
+    if unexpected_scored:
+        raise CapacityReconciliationError(
+            "scored REAL MODEL_FULL output contains nontechnical origins: "
+            f"{unexpected_scored}"
+        )
+    scored_real = list(scored_real_by_id.values())
+    scored_ids = {
+        _required_text(row, "opportunity_id", "scored_real") for row in scored_real
+    }
+    issued_ids = {
+        identifier
+        for identifier, row in primary_by_id.items()
+        if row.get("forecast_status") == "ISSUED"
+        and row.get("outcome_only.evaluation_status") == "EVALUATED"
+    }
+    if scored_ids != issued_ids:
+        raise CapacityReconciliationError(
+            "scored rows are not the exact evaluated ISSUED REAL MODEL_FULL rows"
+        )
+    for identifier, row in scored_real_by_id.items():
+        event = event_by_id[identifier]
+        prediction = primary_by_id[identifier]
+        if (
+            row.get("session_date") != event.get("session_date")
+            or row.get("outcome_only.label") != event.get("outcome_only.label")
+            or row.get("outcome_only.label")
+            != prediction.get("outcome_only.label")
+        ):
+            raise CapacityReconciliationError(
+                "scored MODEL_FULL row does not preserve event/prediction "
+                f"session and class identity: {identifier!r}"
+            )
+    scorable_class_rows, scorable_class_sessions = _class_counts(
+        scored_real,
+        label_field="outcome_only.label",
+        context="scored_real",
+    )
+    scorable_sessions = {
+        _session(row, "scored_real") for row in scored_real
+    }
+
+    scorable_total = len(scored_real)
+    scorable_per_class = dict(scorable_class_rows)
+    observed_support_meets_development_total = (
+        scorable_total >= thresholds.development_min_scorable_real
+    )
+    observed_support_meets_development_per_class = all(
+        scorable_per_class[label] >= thresholds.development_min_per_class
+        for label in CLASS_ORDER
+    )
+    observed_support_meets_final_total = (
+        scorable_total >= thresholds.final_min_scorable_real
+    )
+    observed_support_meets_final_per_class = all(
+        scorable_per_class[label] >= thresholds.final_min_per_class
+        for label in CLASS_ORDER
+    )
+    # DWO-04 does not authorize acquisition clearance. Even hypothetical row
+    # counts above the descriptive thresholds cannot turn this engineering
+    # reconciliation into an acquisition, interpretation, or authority vote.
+    clears_development_total = False
+    clears_development_per_class = False
+    clears_final_total = False
+    clears_final_per_class = False
+    clears_all = False
+    status = FAIL_CLOSED_ACQUISITION_STATUS
+
+    sensitivity = technical_event_session_incidence_sensitivity(
+        technical_origin_rows=len(technically_evaluable),
+        technical_event_sessions=technical_sessions,
+        outer_test_sessions=len(outer_sessions),
+        confidence_level=confidence_level,
+    )
+    return OutputAttritionReconciliation(
+        partition_eligible_opportunity_rows=len(outer_real),
+        outer_test_sessions=len(outer_sessions),
+        event_sealed_rows=len(sealed),
+        technically_evaluable_rows=len(technically_evaluable),
+        technical_event_distinct_sessions=len(technical_sessions),
+        technical_event_session_identities=tuple(
+            session.isoformat() for session in technical_sessions
+        ),
+        technical_event_session_identities_sha256=(
+            sensitivity.ordered_session_identities_sha256
+        ),
+        technically_evaluable_per_class_rows=technical_class_rows,
+        technically_evaluable_per_class_distinct_sessions=(
+            technical_class_sessions
+        ),
+        model_full_fit_rows=primary_fit_rows,
+        model_full_technical_not_issued_rows=status_counts[
+            "TECHNICAL_NOT_ISSUED"
+        ],
+        model_full_ood_abstain_rows=status_counts["OOD_ABSTAIN"],
+        model_full_issued_rows=status_counts["ISSUED"],
+        model_full_scorable_rows=scorable_total,
+        model_full_scorable_distinct_sessions=len(scorable_sessions),
+        model_full_scorable_per_class_rows=scorable_class_rows,
+        model_full_scorable_per_class_distinct_sessions=(
+            scorable_class_sessions
+        ),
+        issued_or_ood_rows_with_successful_fit=reconciled_fit_rows,
+        issued_or_ood_rows_total=fit_required_rows,
+        prediction_fit_reconciliation="PASS",
+        technical_event_session_incidence_sensitivity=sensitivity,
+        observed_support_meets_development_total=(
+            observed_support_meets_development_total
+        ),
+        observed_support_meets_development_per_class=(
+            observed_support_meets_development_per_class
+        ),
+        observed_support_meets_final_total=observed_support_meets_final_total,
+        observed_support_meets_final_per_class=(
+            observed_support_meets_final_per_class
+        ),
+        clears_development_total=clears_development_total,
+        clears_development_per_class=clears_development_per_class,
+        clears_final_total=clears_final_total,
+        clears_final_per_class=clears_final_per_class,
+        clears_all=clears_all,
+        status=status,
+    )
+
+
+def _read_csv_rows(path: Path) -> list[dict[str, object]]:
+    try:
+        with path.open(newline="", encoding="utf-8") as handle:
+            return [dict(row) for row in csv.DictReader(handle)]
+    except (OSError, UnicodeError, csv.Error) as exc:
+        raise CapacityReconciliationError(
+            f"capacity output is not readable canonical CSV: {path}"
+        ) from exc
+
+
+def _read_fit_rows(path: Path) -> list[dict[str, object]]:
+    try:
+        payload: Any = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
+        raise CapacityReconciliationError(
+            f"capacity fit output is not readable JSON: {path}"
+        ) from exc
+    if (
+        not isinstance(payload, dict)
+        or set(payload) != {"rows"}
+        or not isinstance(payload["rows"], list)
+        or any(not isinstance(row, dict) for row in payload["rows"])
+    ):
+        raise CapacityReconciliationError(
+            "capacity fit output must be an exact object containing a rows array"
+        )
+    return [dict(row) for row in payload["rows"]]
+
+
+def reconcile_capacity_output_directory(
+    machine_output_directory: str | Path,
+    *,
+    thresholds: CapacityGateThresholds,
+    confidence_level: float = 0.95,
+) -> OutputAttritionReconciliation:
+    """Read the five emitted tables needed to reconstruct capacity attrition."""
+
+    machine = Path(machine_output_directory)
+    return reconcile_capacity_attrition(
+        eligibility_rows=_read_csv_rows(machine / "eligibility_ledger.csv"),
+        event_rows=_read_csv_rows(machine / "events.csv"),
+        prediction_rows=_read_csv_rows(machine / "predictions.csv"),
+        fit_rows=_read_fit_rows(machine / "model_fits.json"),
+        scored_rows=_read_csv_rows(machine / "scored_events.csv"),
+        thresholds=thresholds,
+        confidence_level=confidence_level,
+    )
+
+
+__all__ = (
+    "CAPACITY_EVIDENCE_SCHEMA_VERSION",
+    "CONDITIONAL_IID_BINOMIAL_SENSITIVITY_METHOD",
+    "CapacityGateThresholds",
+    "CapacityReconciliationError",
+    "FAIL_CLOSED_ACQUISITION_STATUS",
+    "EXACT_HELD_LICENSED_FIXTURE_SOURCE_LANE",
+    "OutputAttritionReconciliation",
+    "TECHNICAL_EVENT_SESSION_INCIDENCE",
+    "TechnicalSessionIncidenceSensitivity",
+    "UNATTESTED_RECONCILIATION_SOURCE_LANE",
+    "exact_held_licensed_evidence_payload",
+    "reconcile_capacity_attrition",
+    "reconcile_capacity_output_directory",
+    "technical_event_session_incidence_sensitivity",
+)
