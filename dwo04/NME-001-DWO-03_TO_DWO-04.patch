+def _build_distribution_once(project: Path, output: Path) -> dict[str, dict[str, object]]:
+    if output.exists() or output.is_symlink():
+        raise ReleaseError("fresh distribution output directory must be absent")
+    command = [
+        str(output) if item == "{out_dir}" else item
+        for item in DISTRIBUTION_BUILD_COMMAND
+    ]
+    environment = _subprocess_environment(DISTRIBUTION_BUILD_ENVIRONMENT)
+    try:
+        completed = subprocess.run(
+            command,
+            cwd=project,
+            env=environment,
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=300,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise ReleaseError("locked distribution build could not complete") from exc
+    if completed.returncode != 0:
+        raise ReleaseError(
+            "locked distribution build failed: "
+            f"exit={completed.returncode}; stdout={completed.stdout[-2000:]!r}; "
+            f"stderr={completed.stderr[-2000:]!r}"
+        )
+    expected_names = {
+        f"nexus_nme001-{CANDIDATE_VERSION}-py3-none-any.whl",
+        f"nexus_nme001-{CANDIDATE_VERSION}.tar.gz",
+    }
+    if output.is_symlink() or not output.is_dir():
+        raise ReleaseError("locked distribution build did not create its output")
+    paths = sorted(output.iterdir())
+    if {path.name for path in paths} != expected_names:
+        raise ReleaseError("locked distribution build output inventory is not exact")
+    records: dict[str, dict[str, object]] = {}
+    for path in paths:
+        if path.is_symlink() or not path.is_file():
+            raise ReleaseError("locked distribution output is not a regular file")
+        records[path.name] = _file_record(path)
+    return records
+
