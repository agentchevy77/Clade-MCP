+            "prediction fit reconciliation requires the exact FINAL block"
+        )
+
+    def exact_identity(
+        row: Mapping[str, Any],
+        *,
+        row_kind: str,
+    ) -> tuple[str, int | str, str]:
+        for field in ("cohort", "model_id"):
+            if field not in row:
+                raise ValueError(
+                    f"prediction fit reconciliation {row_kind} missing {field}"
+                )
+            value = row[field]
+            if type(value) is not str or not value:
+                raise ValueError(
+                    "prediction fit reconciliation requires exact nonempty "
+                    f"string {row_kind}.{field}"
+                )
+        cohort = row["cohort"]
+        model_id = row["model_id"]
