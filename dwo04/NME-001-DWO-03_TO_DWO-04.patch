+    reconciliation: OutputAttritionReconciliation,
+    *,
+    exact_fixture_identity_verified: bool,
+) -> dict[str, object]:
+    """Bind licensed provenance only after the caller verifies exact fixtures.
+
+    Generic reconciliation accepts caller-supplied rows and therefore remains
+    provenance-neutral.  The public pipeline is the only production caller of
+    this envelope, after its exact-path, exact-byte, and receipt checks pass.
+    """
+
+    if exact_fixture_identity_verified is not True:
+        raise CapacityReconciliationError(
+            "exact held licensed provenance requires a verified fixture identity"
+        )
+    payload = reconciliation.as_dict()
+    identity = payload.get("evidence_identity")
+    if not isinstance(identity, dict):  # pragma: no cover - internal invariant
+        raise CapacityReconciliationError(
+            "capacity evidence identity envelope is unavailable"
+        )
+    identity["source_lane"] = EXACT_HELD_LICENSED_FIXTURE_SOURCE_LANE
+    return payload
