+def package_candidate(
+    *,
+    project_root: str | Path,
+    hermetic_junit_path: str | Path,
+    output_path: str | Path,
+    licensed_junit_path: str | Path,
+) -> dict[str, object]:
+    """Build two independent freezes, compare bytes, and publish one ZIP."""
+
+    _validate_release_identity()
+    project = Path(project_root).absolute()
+    if project.is_symlink() or not project.is_dir():
+        raise ReleaseError("project root must be a non-symlink directory")
+    output = Path(output_path).absolute()
+    if output.exists() or output.is_symlink():
+        raise ReleaseError("candidate output path must be absent")
+    if output.name != PACKAGE_NAME:
+        raise ReleaseError(f"candidate output filename must be {PACKAGE_NAME}")
+    external_manifest_output = output.parent / EXTERNAL_MANIFEST_NAME
+    receipt_output = output.parent / RECEIPT_NAME
+    for sidecar in (external_manifest_output, receipt_output):
+        if sidecar.exists() or sidecar.is_symlink():
+            raise ReleaseError(
+                f"candidate sidecar output path must be absent: {sidecar.name}"
+            )
+    if licensed_junit_path is None:  # type: ignore[comparison-overlap]
+        raise ReleaseError("DWO-04 release requires exact licensed PASS JUnit evidence")
+    hermetic_source = Path(hermetic_junit_path).absolute()
+    licensed_source = Path(licensed_junit_path).absolute()
+    hermetic_supplied = _supplied_junit_evidence(hermetic_source)
+    hermetic_collection = _collect_named_tests(project, licensed=False)
+    licensed_collection = _collect_named_tests(project, licensed=True)
+    _bind_junit_to_collection(
+        hermetic_supplied,
+        hermetic_collection,
+        lane="candidate-only hermetic",
+    )
+    documents = _validate_order_and_protocol(project)
+    locked_project = _locked_project_identity(project)
+    candidate_diff_reconstruction = _candidate_diff_reconstruction_evidence(project)
+    distribution_build_reproduction = _deterministic_distribution_build_evidence(
+        project
+    )
+    entries_before = _collect_release_entries(project)
+    _validate_entry_size_bounds(entries_before)
+    supplied_sources = (hermetic_source, licensed_source)
+    _reject_supplied_evidence_reinclusion(entries_before, supplied_sources)
+    entry_records_before = _entry_records(entries_before)
+    _assert_no_licensed_payload_records(entry_records_before)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(
+        prefix=".nme001-dwo04-freeze-", dir=output.parent
+    ) as temporary:
+        stage = Path(temporary)
+        hermetic_path = stage / "hermetic.xml"
+        hermetic_path.write_bytes(_canonical_junit_bytes(hermetic_supplied))
+        hermetic = _junit_evidence(hermetic_path)
+        _bind_junit_to_collection(
+            hermetic,
+            hermetic_collection,
+            lane="canonical candidate-only hermetic",
+        )
+
+        try:
+            licensed_fixture_verification = verify_licensed_fixtures(project)
+        except LicensedFixtureError as exc:
+            raise ReleaseError(
+                "licensed JUnit supplied but the exact external fixtures did not verify"
+            ) from exc
+        licensed_supplied = _supplied_junit_evidence(licensed_source)
+        _bind_junit_to_collection(
+            licensed_supplied,
+            licensed_collection,
+            lane="licensed-fixture regression",
+        )
+        fresh_licensed_path = stage / "licensed-fresh.xml"
+        fresh_licensed = _run_licensed_regression(
+            project,
+            fresh_licensed_path,
+        )
+        try:
+            licensed_fixture_verification_after = verify_licensed_fixtures(
+                project,
+            )
+        except LicensedFixtureError as exc:
+            raise ReleaseError(
+                "licensed fixture identity changed during the locked rerun"
+            ) from exc
+        if licensed_fixture_verification_after != licensed_fixture_verification:
+            raise ReleaseError(
+                "licensed fixture verification changed during the locked rerun"
+            )
+        _bind_junit_to_collection(
+            fresh_licensed,
+            licensed_collection,
+            lane="fresh licensed-fixture regression",
+        )
+        licensed_path = stage / "licensed.xml"
+        licensed_path.write_bytes(_canonical_junit_bytes(fresh_licensed))
+        licensed = _licensed_evidence(
+            licensed_path,
+            hermetic=hermetic,
+            collected=licensed_collection,
+        )
+        licensed["fixture_verification"] = licensed_fixture_verification
+
+        entries = _collect_release_entries(project)
+        _validate_entry_size_bounds(entries)
+        _reject_supplied_evidence_reinclusion(entries, supplied_sources)
+        if _entry_records(entries) != entry_records_before:
+            raise ReleaseError(
+                "project source/governance/configuration bytes changed during "
+                "DWO-04 packaging"
+            )
+        entries[HERMETIC_JUNIT_ARCHIVE_PATH] = hermetic_path
+        entries[LICENSED_JUNIT_ARCHIVE_PATH] = licensed_path
+        for name in entries:
+            if _forbidden_member(name):
+                raise ReleaseError(
+                    f"package selection reached prohibited data: {name}"
+                )
+        licensed_payload_exclusion_scan = _licensed_payload_exclusion_scan(
+            project,
+            entries,
+        )
+        manifest = _manifest(
+            entries,
+            hermetic=hermetic,
+            licensed=licensed,
+            document_records=documents,
+            locked_project=locked_project,
+            candidate_diff_reconstruction=candidate_diff_reconstruction,
+            distribution_build_reproduction=distribution_build_reproduction,
+            licensed_payload_exclusion_scan=licensed_payload_exclusion_scan,
+        )
+        _assert_manifest_matches_entry_snapshot(manifest, entry_records_before)
+        manifest_path = stage / "manifest.json"
+        manifest_path.write_bytes(canonical_json_bytes(manifest))
+        try:
+            licensed_fixture_verification_final = verify_licensed_fixtures(project)
+        except LicensedFixtureError as exc:
+            raise ReleaseError(
+                "licensed fixture identity changed immediately before freeze"
+            ) from exc
+        if licensed_fixture_verification_final != licensed_fixture_verification:
+            raise ReleaseError(
+                "licensed fixture verification changed immediately before freeze"
+            )
+        zip_entries = dict(entries)
+        zip_entries[MANIFEST_ARCHIVE_PATH] = manifest_path
+        first = stage / "freeze_a.zip"
+        second = stage / "freeze_b.zip"
+        _write_zip(first, zip_entries)
+        _write_zip(second, zip_entries)
+        if first.read_bytes() != second.read_bytes():
+            raise ReleaseError("independent DWO-04 freezes are not byte-identical")
+        verify_candidate_package(first)
+        verify_candidate_package(second)
+        sealed_reproduction = reproduce_hermetic_package(first)
+        shutil.copyfile(first, output)
+        output.chmod(0o644)
+        external_bytes, receipt_bytes = _sidecar_documents(
+            output,
+            embedded_manifest=manifest,
+            sealed_reproduction=sealed_reproduction,
+        )
+        independently_built_sidecars = _sidecar_documents(
+            output,
+            embedded_manifest=manifest,
+            sealed_reproduction=sealed_reproduction,
+        )
+        if (external_bytes, receipt_bytes) != independently_built_sidecars:
+            raise ReleaseError("independent DWO-04 sidecar freezes are not identical")
+        external_manifest_output.write_bytes(external_bytes)
+        receipt_output.write_bytes(receipt_bytes)
+        external_manifest_output.chmod(0o644)
+        receipt_output.chmod(0o644)
+    verify_candidate_package(output)
+    verify_candidate_sidecars(output)
+    external_record = _file_record(external_manifest_output)
+    receipt_record = _file_record(receipt_output)
+    return {
+        "package": output,
+        "sha256": hashlib.sha256(output.read_bytes()).hexdigest(),
+        "size_bytes": output.stat().st_size,
+        "external_manifest": external_manifest_output,
+        "external_manifest_sha256": external_record["sha256"],
+        "external_manifest_size_bytes": external_record["size_bytes"],
+        "receipt": receipt_output,
+        "receipt_sha256": receipt_record["sha256"],
+        "receipt_size_bytes": receipt_record["size_bytes"],
+        "hermetic_named_tests_passed": hermetic["passed"],
+        "licensed_regression": licensed["status"],
+        "independent_freezes_byte_identical": True,
+        "sealed_hermetic_reproduction": sealed_reproduction,
+        "authority": dict(AUTHORITY),
+    }
+
+
+def reproduce_hermetic_package(
+    package: str | Path,
+    *,
+    timeout_seconds: int = 900,
+) -> dict[str, object]:
+    """Extract the ZIP, rerun its hermetic command, and compare named cases."""
+
+    candidate = Path(package).absolute()
+    manifest = verify_candidate_package(candidate)
+    expected = manifest["reproduction"]["candidate_only_hermetic"][  # type: ignore[index]
+        "named_test_evidence"
+    ]
+    with tempfile.TemporaryDirectory(prefix="nme001-dwo04-reproduce-") as temporary:
+        root = Path(temporary)
+        with zipfile.ZipFile(candidate) as archive:
+            _validate_zip_metadata(archive)
+            archive.extractall(root)
+        environment = _subprocess_environment(LOCKED_TEST_ENVIRONMENT)
+        try:
+            completed = subprocess.run(
+                HERMETIC_COMMAND,
+                cwd=root,
+                env=environment,
+                check=False,
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds,
+            )
+        except (OSError, subprocess.TimeoutExpired) as exc:
+            raise ReleaseError("hermetic reproduction command could not complete") from exc
+        if completed.returncode != 0:
+            raise ReleaseError(
+                "hermetic reproduction failed: "
+                f"exit={completed.returncode}; stdout={completed.stdout[-2000:]!r}; "
+                f"stderr={completed.stderr[-2000:]!r}"
+            )
+        observed_path = root / "pytest_dwo04_hermetic.xml"
+        observed = _junit_evidence(observed_path)
+        if (
+            observed["collected"] != expected["collected"]
+            or observed["named_tests"] != expected["named_tests"]
+        ):
+            raise ReleaseError(
+                "sealed ZIP did not reproduce its advertised hermetic named-test set"
+            )
+        reproduced_full_names = _collect_named_tests(root, licensed=True)
+        licensed_lane = manifest["reproduction"][  # type: ignore[index]
+            "licensed_fixture_regression"
+        ]
+        advertised_full_names = licensed_lane["named_test_evidence"]["named_tests"]
+        if reproduced_full_names != advertised_full_names:
+            raise ReleaseError(
+                "sealed ZIP did not reproduce its advertised full named-test "
+                "inventory"
+            )
+        full_inventory = _named_test_inventory(reproduced_full_names)
+    return {
+        "status": "PASS",
+        "package_sha256": hashlib.sha256(candidate.read_bytes()).hexdigest(),
+        "advertised_test_count": expected["collected"],
+        "reproduced_test_count": observed["collected"],
+        "named_test_set_identical": True,
+        "full_inventory_count": full_inventory["collected"],
+        "full_inventory_sha256": full_inventory["named_tests_sha256"],
+        "full_inventory_identical": True,
+        "authority": "NONE",
+    }
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="python -m nexus_nme001.release_dwo04",
+        description="Package or independently verify the DWO-04 candidate",
+    )
+    subparsers = parser.add_subparsers(dest="operation", required=True)
+    package = subparsers.add_parser("package")
+    package.add_argument("--project-root", type=Path, required=True)
+    package.add_argument("--hermetic-junit", type=Path, required=True)
+    package.add_argument("--licensed-junit", type=Path, required=True)
+    package.add_argument("--output", type=Path, required=True)
+    verify = subparsers.add_parser("verify")
+    verify.add_argument("--package", type=Path, required=True)
+    reproduce = subparsers.add_parser("reproduce")
+    reproduce.add_argument("--package", type=Path, required=True)
+    reproduce.add_argument("--timeout-seconds", type=int, default=900)
+    bindings = subparsers.add_parser(
+        "collection-bindings",
+        help="compute final named-test count/digest values without adopting them",
+    )
+    bindings.add_argument("--project-root", type=Path, required=True)
+    candidate_patch = subparsers.add_parser(
+        "candidate-patch",
+        help="write the canonical complete patch from the exact DWO-03 baseline",
+    )
+    candidate_patch.add_argument("--project-root", type=Path, required=True)
+    candidate_patch.add_argument("--output", type=Path, required=True)
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    if args.operation == "package":
+        result = package_candidate(
+            project_root=args.project_root,
+            hermetic_junit_path=args.hermetic_junit,
+            licensed_junit_path=args.licensed_junit,
+            output_path=args.output,
+        )
+    elif args.operation == "verify":
+        manifest = verify_candidate_package(args.package)
+        sidecars = verify_candidate_sidecars(args.package)
+        result = {
+            "status": "PASS",
+            "package": args.package,
+            "hermetic_named_tests_passed": manifest["reproduction"][  # type: ignore[index]
+                "candidate_only_hermetic"
+            ]["named_test_evidence"]["passed"],
+            "external_manifest": str(
+                Path(args.package).absolute().parent / EXTERNAL_MANIFEST_NAME
+            ),
+            "receipt": str(Path(args.package).absolute().parent / RECEIPT_NAME),
+            "sidecar_status": (
+                "PASS" if set(sidecars) == {"manifest", "receipt"} else "FAIL"
+            ),
+            "authority": dict(AUTHORITY),
+        }
+    elif args.operation == "reproduce":
+        verify_candidate_sidecars(args.package)
+        result = reproduce_hermetic_package(
+            args.package,
+            timeout_seconds=args.timeout_seconds,
+        )
+    elif args.operation == "candidate-patch":
+        result = write_canonical_candidate_patch(
+            project_root=args.project_root,
+            output_path=args.output,
+        )
+    else:
+        result = compute_collection_bindings(args.project_root)
+    print(
+        json.dumps(
+            {
+                key: str(value) if isinstance(value, Path) else value
+                for key, value in result.items()
+            },
+            ensure_ascii=False,
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
