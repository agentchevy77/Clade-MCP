+def _subprocess_environment(
+    updates: Mapping[str, str] | None = None,
+) -> dict[str, str]:
+    """Return a deterministic environment with injection controls removed."""
+
+    environment = {
+        key: value
+        for key, value in os.environ.items()
+        if key not in _SUBPROCESS_ENVIRONMENT_DENYLIST
+        and not any(
+            key.startswith(prefix)
+            for prefix in _SUBPROCESS_ENVIRONMENT_DENY_PREFIXES
+        )
+    }
+    if updates is not None:
+        environment.update(updates)
+    return environment
+
