+def _junit(
+    path: Path,
+    *,
+    outcome: str | None = None,
+    names: tuple[str, ...] = ("test_hermetic",),
+) -> Path:
+    child = "" if outcome is None else f"<{outcome}/>"
+    failures = 1 if outcome == "failure" else 0
+    errors = 1 if outcome == "error" else 0
+    skipped = 1 if outcome == "skipped" else 0
+    cases = "".join(
+        (
+            '<testcase classname="tests.test_fixture" '
+            f'name="{name}">{child}</testcase>'
+        )
+        for name in names
+    )
+    path.write_text(
+        (
+            f'<testsuites tests="{len(names)}" failures="{failures}" errors="{errors}" skipped="{skipped}">'
+            f'<testsuite tests="{len(names)}" failures="{failures}" errors="{errors}" skipped="{skipped}">'
+            f"{cases}</testsuite></testsuites>\n"
+        ),
+        encoding="utf-8",
+    )
+    return path
