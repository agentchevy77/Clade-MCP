+                f"candidate ZIP lacks required DWO-04 members: {missing}"
+            )
+        absent_prefixes = [
+            prefix for prefix in _REQUIRED_PREFIXES
+            if not any(name.startswith(prefix) for name in names)
+        ]
+        if absent_prefixes:
