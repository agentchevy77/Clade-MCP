index 0000000000000000000000000000000000000000..6d48783bbe302f318d71719863b941eb20b77a7a
--- /dev/null
+++ b/tests/test_config_typing_dwo04.py
@@ -0,0 +1,232 @@
+"""Central strict-type contract regressions for NME-001-DWO-04."""
+
+from __future__ import annotations
+
+import json
+from datetime import date, datetime
+from pathlib import Path
+
+import pytest
+
+from nexus_nme001.config import (
+    ContractError,
+    ExperimentConfig,
+    load_config,
+    validate_config,
+)
+from nexus_nme001.contract import Stage
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ACTIVE = ROOT / "config/frozen_config.json"
+LEGACY = ROOT / "config/frozen_config_v1_0_1.json"
+
+
+def _serialized_config() -> dict[str, object]:
+    return json.loads(ACTIVE.read_text(encoding="utf-8"))
+
+
+def _runtime_config_values() -> dict[str, object]:
+    cfg = load_config(ACTIVE)
+    return {
+        name: getattr(cfg, name) for name in ExperimentConfig.__dataclass_fields__
+    }
+
+
+@pytest.mark.parametrize(
+    ("field", "wrong_value", "message"),
+    (
+        ("interval_minutes", True, "integer field has invalid type"),
+        ("minimum_outer_cycles", True, "integer field has invalid type"),
+        ("standard_symbol", 7, "field has invalid type"),
+        ("capacity_design_version", 7, "field has invalid type"),
+        ("tick_size", 1, "numeric field has invalid type"),
+        ("capacity_planning_haircut", False, "numeric field has invalid type"),
+        ("stage", 7, "field has invalid type"),
+        ("calendar_start", 7, "field has invalid type"),
+        ("cutoff_et", 7, "field has invalid type"),
+    ),
+)
+def test_json_loading_rejects_declared_type_mismatches(
+    tmp_path: Path,
+    field: str,
+    wrong_value: object,
+    message: str,
+) -> None:
+    payload = _serialized_config()
+    payload[field] = wrong_value
+    path = tmp_path / f"wrong-{field}.json"
+    path.write_text(json.dumps(payload), encoding="utf-8")
+
+    with pytest.raises(ContractError, match=message):
+        load_config(path)
+
+
+@pytest.mark.parametrize(
+    ("field", "wrong_value", "message"),
+    (
+        ("interval_minutes", True, "integer field has invalid type"),
+        ("minimum_outer_cycles", True, "integer field has invalid type"),
+        ("standard_symbol", 7, "field has invalid type"),
+        ("capacity_design_version", 7, "field has invalid type"),
+        ("tick_size", 1, "numeric field has invalid type"),
+        ("capacity_planning_haircut", False, "numeric field has invalid type"),
+        ("stage", 7, "field has invalid type"),
+        ("calendar_start", 7, "field has invalid type"),
+        ("cutoff_et", 7, "field has invalid type"),
+    ),
+)
+def test_from_mapping_rejects_declared_type_mismatches_without_coercion(
+    field: str,
+    wrong_value: object,
+    message: str,
+) -> None:
+    payload = _serialized_config()
+    payload[field] = wrong_value
+
+    with pytest.raises(ContractError, match=message):
+        ExperimentConfig.from_mapping(payload)
+
+
+@pytest.mark.parametrize(
+    ("field", "wrong_value", "message"),
+    (
+        ("interval_minutes", True, "integer field has invalid type"),
+        ("minimum_outer_cycles", True, "integer field has invalid type"),
+        ("standard_symbol", 7, "field has invalid type"),
+        ("capacity_design_version", 7, "field has invalid type"),
+        ("tick_size", 1, "numeric field has invalid type"),
+        ("capacity_planning_haircut", False, "numeric field has invalid type"),
+        ("stage", Stage.DEVELOPMENT.value, "field has invalid type"),
+        (
+            "calendar_start",
+            datetime(2024, 1, 2),
+            "field has invalid type",
+        ),
+        ("cutoff_et", date(2024, 1, 2), "field has invalid type"),
+    ),
+)
+def test_direct_construction_rejects_declared_runtime_type_mismatches(
+    field: str,
+    wrong_value: object,
+    message: str,
+) -> None:
+    values = _runtime_config_values()
+    values[field] = wrong_value
+
+    with pytest.raises(ContractError, match=message):
+        ExperimentConfig(**values)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    ("field", "wrong_value", "message"),
+    (
+        ("interval_minutes", True, "integer field has invalid type"),
+        ("minimum_outer_cycles", True, "integer field has invalid type"),
+        ("standard_symbol", 7, "field has invalid type"),
+        ("capacity_design_version", 7, "field has invalid type"),
+        ("tick_size", 1, "numeric field has invalid type"),
+        ("capacity_planning_haircut", False, "numeric field has invalid type"),
+        ("stage", Stage.DEVELOPMENT.value, "field has invalid type"),
+        (
+            "calendar_start",
+            datetime(2024, 1, 2),
+            "field has invalid type",
+        ),
+        ("cutoff_et", date(2024, 1, 2), "field has invalid type"),
+    ),
+)
+def test_validate_config_rechecks_declared_runtime_types(
+    field: str,
+    wrong_value: object,
+    message: str,
+) -> None:
+    cfg = load_config(ACTIVE)
+    object.__setattr__(cfg, field, wrong_value)
+
+    with pytest.raises(ContractError, match=message):
+        validate_config(cfg)
+
+
+@pytest.mark.parametrize(
+    ("field", "invalid_value"),
+    (
+        ("stage", "not-a-registered-stage"),
+        ("calendar_start", "2024-02-30"),
+        ("cutoff_et", "not-an-iso-datetime"),
+    ),
+)
+def test_serialized_invalid_enum_date_and_datetime_values_are_contract_errors(
+    tmp_path: Path,
+    field: str,
+    invalid_value: str,
+) -> None:
+    payload = _serialized_config()
+    payload[field] = invalid_value
+
+    with pytest.raises(ContractError, match=f"invalid value: {field}"):
+        ExperimentConfig.from_mapping(payload)
+
+    path = tmp_path / f"invalid-value-{field}.json"
+    path.write_text(json.dumps(payload), encoding="utf-8")
+    with pytest.raises(ContractError, match=f"invalid value: {field}"):
+        load_config(path)
+
+
+def test_nullable_fields_accept_none_in_serialized_and_runtime_forms() -> None:
+    serialized = _serialized_config()
+    serialized["capacity_design_version"] = None
+    parsed = ExperimentConfig.from_mapping(serialized)
+    assert parsed.capacity_design_version is None
+
+    runtime = _runtime_config_values()
+    runtime["capacity_design_version"] = None
+    constructed = ExperimentConfig(**runtime)  # type: ignore[arg-type]
+    assert constructed.capacity_design_version is None
+
+    legacy = load_config(LEGACY)
+    assert legacy.capacity_design_version is None
+    assert legacy.capacity_planning_haircut is None
+
+
+def test_from_mapping_rejects_unknown_and_missing_required_fields() -> None:
+    unknown = _serialized_config()
+    unknown["unregistered_field"] = "value"
+    with pytest.raises(ContractError, match="unknown fields"):
+        ExperimentConfig.from_mapping(unknown)
+
+    missing = _serialized_config()
+    del missing["interval_minutes"]
+    with pytest.raises(ContractError, match="missing required field: interval_minutes"):
+        ExperimentConfig.from_mapping(missing)
+
+
+def test_json_loader_rejects_missing_required_and_duplicate_keys(
+    tmp_path: Path,
+) -> None:
+    unknown = _serialized_config()
+    unknown["unregistered_field"] = "value"
+    unknown_path = tmp_path / "unknown.json"
+    unknown_path.write_text(json.dumps(unknown), encoding="utf-8")
+    with pytest.raises(ContractError, match="unknown fields"):
+        load_config(unknown_path)
+
+    missing = _serialized_config()
+    del missing["interval_minutes"]
+    missing_path = tmp_path / "missing.json"
+    missing_path.write_text(json.dumps(missing), encoding="utf-8")
+    with pytest.raises(ContractError, match="missing required field: interval_minutes"):
+        load_config(missing_path)
+
+    original = ACTIVE.read_text(encoding="utf-8")
+    duplicate_path = tmp_path / "duplicate.json"
+    duplicate_path.write_text(
+        original.replace(
+            '  "calendar_name": "XNYS",',
+            '  "calendar_name": "XNYS",\n  "calendar_name": "XNYS",',
+            1,
+        ),
+        encoding="utf-8",
+    )
+    with pytest.raises(ContractError, match="duplicate key: calendar_name"):
+        load_config(duplicate_path)
