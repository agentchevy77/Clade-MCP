+        raise ReleaseError("DWO-04 candidate is not a readable ZIP") from exc
+    with archive_context as archive:
+        names = _validate_zip_metadata(archive)
+        _require_canonical_zip_bytes(candidate, archive, names)
+        required = {
+            MANIFEST_ARCHIVE_PATH,
+            HERMETIC_JUNIT_ARCHIVE_PATH,
+            LICENSED_JUNIT_ARCHIVE_PATH,
+            ORDER_ARCHIVE_PATH,
+            ACTIVE_PROTOCOL_PATH,
