+def _verify_attrition_reconciliation(
+    archive: zipfile.ZipFile,
+    records: Mapping[str, Mapping[str, object]],
+) -> None:
+    if records.get(ATTRITION_RECONCILIATION_ARCHIVE_PATH) != {
+        "sha256": ATTRITION_RECONCILIATION_SHA256,
+        "size_bytes": ATTRITION_RECONCILIATION_SIZE_BYTES,
+    }:
+        raise ReleaseError("DWO-04 attrition reconciliation record changed")
+    payload = archive.read(ATTRITION_RECONCILIATION_ARCHIVE_PATH)
+    try:
+        value = json.loads(payload.decode("utf-8"))
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise ReleaseError("DWO-04 attrition reconciliation is unreadable") from exc
+    if not isinstance(value, dict) or payload != canonical_json_bytes(value):
+        raise ReleaseError("DWO-04 attrition reconciliation is not canonical JSON")
+    model_full = value.get("model_full")
+    fit = value.get("fit_reconciliation")
+    clearance = value.get("acquisition_clearance")
+    evidence_identity = value.get("evidence_identity")
+    if (
+        evidence_identity
+        != {
+            "active_protocol_version": EXPECTED_PROTOCOL_VERSION,
+            "candidate_id": EXPECTED_CANDIDATE_ID,
+            "candidate_version": EXPECTED_CANDIDATE_VERSION,
