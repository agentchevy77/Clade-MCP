+def test_dwo04_collection_binding_rejects_concurrent_source_drift(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    calls = 0
+
+    def snapshot(_project: Path) -> dict[str, dict[str, object]]:
+        nonlocal calls
+        calls += 1
+        return {
+            "source": {
+                "size_bytes": calls,
+                "sha256": f"{calls:064x}",
+            }
+        }
+
+    monkeypatch.setattr(release_dwo04, "_candidate_source_snapshot", snapshot)
+    monkeypatch.setattr(
+        release_dwo04,
+        "_collect_named_tests_unbound",
+        lambda _project, *, licensed: (
+            ["tests.test_a::test_one", "tests.test_b::test_licensed"]
+            if licensed
+            else ["tests.test_a::test_one"]
+        ),
+    )
+
+    with pytest.raises(ReleaseError, match="changed during collection binding"):
+        compute_collection_bindings(tmp_path)
