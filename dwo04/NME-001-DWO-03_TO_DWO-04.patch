+def test_dwo04_licensed_rerun_uses_exact_locked_command(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    project = tmp_path / "project"
+    project.mkdir()
+    destination = tmp_path / "stage" / "licensed.xml"
+    destination.parent.mkdir()
+    for key in (
+        "PYTHONPATH",
+        "PYTHONHOME",
+        "PYTEST_ADDOPTS",
+        "PYTEST_PLUGINS",
+        "UV_PROJECT_ENVIRONMENT",
+        "UV_NO_SYNC",
+        "VIRTUAL_ENV",
+    ):
+        monkeypatch.setenv(key, "INJECTED")
+
+    def fake_run(
+        command: list[str],
+        **kwargs: object,
+    ) -> subprocess.CompletedProcess[str]:
+        assert command == list(LICENSED_COMMAND)
+        assert Path(kwargs["cwd"]) == project
+        environment = kwargs["env"]
+        assert isinstance(environment, dict)
+        assert environment["UV_OFFLINE"] == "1"
+        assert environment["UV_NO_CONFIG"] == "1"
+        assert environment["PYTHONDONTWRITEBYTECODE"] == "1"
+        assert not {
+            "PYTHONPATH",
+            "PYTHONHOME",
+            "PYTEST_ADDOPTS",
+            "PYTEST_PLUGINS",
+            "UV_PROJECT_ENVIRONMENT",
+            "UV_NO_SYNC",
+            "VIRTUAL_ENV",
+        } & set(environment)
+        _junit(project / "pytest_dwo04_licensed.xml")
+        return subprocess.CompletedProcess(command, 0, "passed", "")
+
+    monkeypatch.setattr("nexus_nme001.release_dwo04.subprocess.run", fake_run)
+    evidence = _run_licensed_regression(project, destination)
+
+    assert evidence["passed"] == 1
+    assert destination.read_bytes() == (
+        project / "pytest_dwo04_licensed.xml"
+    ).read_bytes()
+
