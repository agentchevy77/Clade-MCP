+def _release_name_shape_is_safe(name: str) -> bool:
+    try:
+        _safe_archive_name(name)
+    except ReleaseError:
+        return False
+    if (
+        not name.isascii()
+        or unicodedata.normalize("NFC", name) != name
+        or "\\" in name
+    ):
+        return False
+    parts = name.split("/")
+    if not parts or any(not part for part in parts):
+        return False
+    for part in parts:
+        stem = part.split(".", 1)[0]
+        if (
+            part != part.strip()
+            or part.startswith(".")
+            or part.endswith(".")
+            or ":" in part
+            or _WINDOWS_DEVICE_STEM.fullmatch(stem) is not None
+            or any(ord(character) < 32 or ord(character) == 127 for character in part)
+        ):
+            return False
+    return True
+
+
+def _name_has_forbidden_data_alias(name: str) -> bool:
+    tokens = [
+        token
+        for token in re.split(r"[^a-z0-9]+", name.casefold())
+        if token
+    ]
+    if "raw" in tokens or "bulk" in tokens:
+        return True
+    normalized = "_".join(tokens)
+    return any(alias in normalized for alias in _FORBIDDEN_NORMALIZED_ALIASES)
+
+
+def _forbidden_member(name: str) -> bool:
+    if not _release_name_shape_is_safe(name) or _name_has_forbidden_data_alias(name):
+        return True
+    if name in _SPECIAL_ARTIFACT_MEMBERS or name in {
+        "README.md",
+        "pyproject.toml",
+        "uv.lock",
+    }:
+        return False
+    path = PurePosixPath(name)
+    if name.startswith("data/receipts/"):
+        return path.suffix.casefold() != ".json"
+    suffixes = _ROOT_SUFFIX_ALLOWLIST.get(path.parts[0])
+    return suffixes is not None and path.suffix.casefold() not in suffixes
+
+
+def _allowed_member(name: str) -> bool:
+    if _forbidden_member(name):
+        return False
+    if name in _ALLOWED_EXACT_MEMBERS:
+        return True
+    path = PurePosixPath(name)
+    if name.startswith("data/receipts/"):
+        return path.suffix.casefold() == ".json"
+    suffixes = _ROOT_SUFFIX_ALLOWLIST.get(path.parts[0])
+    return suffixes is not None and path.suffix.casefold() in suffixes
+
