+def _thresholds() -> CapacityGateThresholds:
+    cfg = load_config(ROOT / "config/frozen_config.json")
+    return CapacityGateThresholds(
+        development_min_scorable_real=cfg.development_min_scorable_real,
+        development_min_per_class=cfg.development_min_per_class,
+        final_min_scorable_real=cfg.final_min_scorable_real,
+        final_min_per_class=cfg.final_min_per_class,
+    )
+
+
+def _opportunity(
+    identifier: str,
+    session_date: str,
+    *,
+    disposition: str,
+) -> dict[str, object]:
+    technical = disposition == "EVENT_SEALED"
+    return {
+        "opportunity_id": identifier,
+        "session_date": session_date,
+        "partition": "DEVELOPMENT_TEST",
+        "outer_fold": "1",
+        "cohort": "REAL",
+        "origin_disposition": disposition,
+        "forecast_status": (
+            "TECHNICAL_NOT_ISSUED" if technical else "NOT_APPLICABLE"
+        ),
+        "outcome_evaluation_status": "EVALUATED" if technical else "NOT_APPLICABLE",
+        "feature_status": "AVAILABLE" if technical else "NOT_APPLICABLE",
+    }
+
+
+def _event(
+    opportunity: dict[str, object],
+    label: str,
+) -> dict[str, object]:
+    return {**opportunity, "outcome_only.label": label}
+
+
+def _prediction(
+    identifier: str,
+    session_date: str,
+    status: str,
+) -> dict[str, object]:
+    return {
+        "opportunity_id": identifier,
+        "session_date": session_date,
+        "outer_fold": "1",
+        "cohort": "REAL",
+        "model_id": "MODEL_FULL",
+        "forecast_status": status,
+        "outcome_only.evaluation_status": "EVALUATED",
+        "outcome_only.label": "NO_CONTACT",
+    }
+
+
+def _small_output_rows(
+    *,
+    primary_status: str = "TECHNICAL_NOT_ISSUED",
+    fitted: bool = False,
+) -> dict[str, list[dict[str, object]]]:
+    first = _opportunity("event-a", "2026-01-05", disposition="EVENT_SEALED")
+    second = _opportunity("event-b", "2026-01-05", disposition="EVENT_SEALED")
+    third = _opportunity("none-c", "2026-01-06", disposition="NO_EVENT_NO_APPROACH")
+    fourth = _opportunity("none-d", "2026-01-06", disposition="NO_EVENT_NO_APPROACH")
+    fit = {
+        "cohort": "REAL",
+        "outer_fold": 1,
+        "model_id": "MODEL_FULL",
+        "status": "FIT" if fitted else "INSUFFICIENT_TRAINING_CLASS_OR_FIT",
+    }
+    return {
+        "eligibility_rows": [first, second, third, fourth],
+        "event_rows": [
+            _event(first, "NO_CONTACT"),
+            _event(second, "DEFEND_OR_REJECT"),
+        ],
+        "prediction_rows": [
+            _prediction("event-a", "2026-01-05", primary_status),
+            _prediction("event-b", "2026-01-05", primary_status),
+        ],
+        "fit_rows": [fit],
+        "scored_rows": [],
+    }
+
+
+def test_technical_origins_are_not_mislabeled_as_bernoulli_sessions() -> None:
+    result = reconcile_capacity_attrition(
+        **_small_output_rows(),
+        thresholds=CapacityGateThresholds(200, 30, 50, 5),
+    )
+
+    assert result.partition_eligible_opportunity_rows == 4
+    assert result.outer_test_sessions == 2
+    assert result.technically_evaluable_rows == 2
+    assert result.technical_event_distinct_sessions == 1
+    sensitivity = result.technical_event_session_incidence_sensitivity
+    assert sensitivity.estimand == TECHNICAL_EVENT_SESSION_INCIDENCE
+    assert sensitivity.technical_origin_rows == 2
+    assert sensitivity.technical_event_distinct_sessions == 1
+    assert sensitivity.outer_test_sessions == 2
+    assert sensitivity.method == CONDITIONAL_IID_BINOMIAL_SENSITIVITY_METHOD
+    assert sensitivity.acquisition_clearance_vote is False
+    assert sensitivity.unconditional_temporal_coverage_claim == "NONE"
+    assert not result.clears_all
+    assert result.status == FAIL_CLOSED_ACQUISITION_STATUS
+
+
+def test_output_reconciliation_rejects_ood_without_same_fit() -> None:
+    with pytest.raises(
+        CapacityReconciliationError,
+        match="OOD_ABSTAIN or ISSUED prediction lacks one successful",
+    ):
+        reconcile_capacity_attrition(
+            **_small_output_rows(primary_status="OOD_ABSTAIN", fitted=False),
+            thresholds=CapacityGateThresholds(200, 30, 50, 5),
+        )
+
+
+def test_output_reconciliation_preserves_successful_fit_ood() -> None:
+    result = reconcile_capacity_attrition(
+        **_small_output_rows(primary_status="OOD_ABSTAIN", fitted=True),
+        thresholds=CapacityGateThresholds(200, 30, 50, 5),
+    )
+
+    assert result.model_full_fit_rows == 1
+    assert result.model_full_ood_abstain_rows == 2
+    assert result.model_full_technical_not_issued_rows == 0
+    assert result.model_full_issued_rows == 0
+    assert result.model_full_scorable_rows == 0
+    assert result.prediction_fit_reconciliation == "PASS"
+    assert result.issued_or_ood_rows_with_successful_fit == 2
+    assert result.issued_or_ood_rows_total == 2
+
