+def _locked_project_identity(project: Path) -> dict[str, object]:
+    pyproject_path = project / "pyproject.toml"
+    lock_path = project / "uv.lock"
+    try:
+        pyproject = tomllib.loads(
+            _read_regular_file(pyproject_path, purpose="pyproject identity").decode(
+                "utf-8"
+            )
+        )
+        lock = tomllib.loads(
+            _read_regular_file(lock_path, purpose="lock identity").decode("utf-8")
+        )
+    except (UnicodeError, tomllib.TOMLDecodeError) as exc:
+        raise ReleaseError("pyproject.toml or uv.lock is not valid UTF-8 TOML") from exc
+    project_table = pyproject.get("project")
+    if not isinstance(project_table, dict) or (
+        project_table.get("name") != "nexus-nme001"
+        or project_table.get("version") != CANDIDATE_VERSION
+        or project_table.get("requires-python") != "==3.12.*"
+    ):
+        raise ReleaseError("pyproject identity disagrees with the DWO-04 candidate")
+    packages = lock.get("package")
+    local = [
+        item
+        for item in packages if isinstance(item, dict) and item.get("name") == "nexus-nme001"
+    ] if isinstance(packages, list) else []
+    if len(local) != 1 or (
+        local[0].get("version") != CANDIDATE_VERSION
+        or local[0].get("source") != {"editable": "."}
+    ):
+        raise ReleaseError("uv.lock identity disagrees with the DWO-04 candidate")
+    return {
+        "project_name": "nexus-nme001",
+        "candidate_version": CANDIDATE_VERSION,
+        "requires_python": "==3.12.*",
+        "pyproject_sha256": _file_record(pyproject_path)["sha256"],
+        "uv_lock_sha256": _file_record(lock_path)["sha256"],
+        "uv_lock_format_version": lock.get("version"),
+        "uv_lock_revision": lock.get("revision"),
+        "local_editable_record_count": 1,
+    }
