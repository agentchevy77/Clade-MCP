+        except (KeyError, UnicodeError, json.JSONDecodeError) as exc:
+            raise ReleaseError("candidate manifest is unreadable") from exc
+        if not isinstance(manifest, dict) or not isinstance(
+            manifest.get("files"), dict
+        ):
