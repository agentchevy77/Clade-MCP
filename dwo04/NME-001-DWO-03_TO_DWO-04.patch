+    """Require every issued/support-abstained row to have one successful fit."""
+
+    final_mode = prediction_evaluation_block is not None
+    if final_mode and (
+        type(prediction_evaluation_block) is not str
+        or prediction_evaluation_block != "FINAL"
+    ):
