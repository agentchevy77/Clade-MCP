+def test_conditional_sensitivity_has_no_authority_or_temporal_claim() -> None:
+    result = technical_event_session_incidence_sensitivity(
+        technical_origin_rows=9,
+        technical_event_sessions=tuple(
+            date.fromisoformat(value) for value in EXPECTED_TECHNICAL_EVENT_SESSIONS
+        ),
+        outer_test_sessions=84,
+    )
+
+    assert result.estimand == TECHNICAL_EVENT_SESSION_INCIDENCE
+    assert result.method == CONDITIONAL_IID_BINOMIAL_SENSITIVITY_METHOD
+    assert result.lower == pytest.approx(0.05017738898650497)
+    assert result.upper == pytest.approx(0.19367005954466723)
+    assert result.ordered_session_identities_sha256 == (
+        EXPECTED_TECHNICAL_EVENT_SESSION_IDENTITIES_SHA256
+    )
+    assert result.unconditional_temporal_coverage_claim == "NONE"
+    assert result.acquisition_clearance_vote is False
+    assert result.interpretation_vote is False
+    assert result.promotion_vote is False
+    assert result.authority_vote is False
+
+    with pytest.raises(
+        CapacityReconciliationError,
+        match="TWO_SIDED_95 sensitivity requires confidence_level=0.95",
+    ):
+        technical_event_session_incidence_sensitivity(
+            technical_origin_rows=9,
+            technical_event_sessions=tuple(
+                date.fromisoformat(value)
+                for value in EXPECTED_TECHNICAL_EVENT_SESSIONS
+            ),
+            outer_test_sessions=84,
+            confidence_level=0.90,
+        )
+
