+def _verify_preserved_dwo03_payloads(archive: zipfile.ZipFile) -> None:
+    package_payload = archive.read(DWO03_PACKAGE_ARCHIVE_PATH)
+    try:
+        nested_context = zipfile.ZipFile(io.BytesIO(package_payload))
+    except zipfile.BadZipFile as exc:  # pragma: no cover - exact hash is pinned
+        raise ReleaseError("preserved DWO-03 candidate is not a readable ZIP") from exc
+    with nested_context as nested:
+        nested_names = nested.namelist()
+        if (
+            len(nested_names) != len(set(nested_names))
+            or any(_forbidden_member(name) for name in nested_names)
+            or any(info.flag_bits & 0x1 for info in nested.infolist())
+        ):
+            raise ReleaseError("preserved DWO-03 candidate archive is unsafe")
+        paired_members = {
+            DWO03_EMBEDDED_MANIFEST_ARCHIVE_PATH,
+            DWO03_HERMETIC_JUNIT_ARCHIVE_PATH,
+            DWO03_LICENSED_JUNIT_ARCHIVE_PATH,
+        }
+        for name in paired_members:
+            if nested.read(name) != archive.read(name):
+                raise ReleaseError(
+                    f"preserved DWO-03 evidence disagrees with candidate bytes: {name}"
+                )
+    try:
+        external_payload = archive.read(DWO03_EXTERNAL_MANIFEST_ARCHIVE_PATH)
+        receipt_payload = archive.read(DWO03_RECEIPT_ARCHIVE_PATH)
+        external = json.loads(external_payload.decode("utf-8"))
+        receipt = json.loads(receipt_payload.decode("utf-8"))
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise ReleaseError("preserved DWO-03 sidecars are unreadable") from exc
+    if (
+        not isinstance(external, dict)
+        or not isinstance(receipt, dict)
+        or external_payload != canonical_json_bytes(external)
+        or receipt_payload != canonical_json_bytes(receipt)
+    ):
+        raise ReleaseError("preserved DWO-03 sidecars are not canonical JSON")
+    package_record = {
+        "filename": "NME-001-DWO-03_UNREVIEWED_RESEARCH_CANDIDATE.zip",
+        "sha256": DWO03_CANDIDATE_PACKAGE_SHA256,
+        "size_bytes": 744_862,
+    }
+    if external.get("candidate_package") != package_record or receipt.get(
+        "candidate_package"
+    ) != package_record:
+        raise ReleaseError("preserved DWO-03 sidecars do not bind the candidate")
+    if receipt.get("candidate_manifest_sidecar") != {
+        "filename": "NME-001-DWO-03_CANDIDATE_MANIFEST.json",
+        "sha256": DWO03_EXTERNAL_MANIFEST_SHA256,
+        "size_bytes": 1_951,
+    }:
+        raise ReleaseError("preserved DWO-03 receipt does not bind its manifest")
