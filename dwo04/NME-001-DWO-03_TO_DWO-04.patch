+def canonical_candidate_patch_bytes(project: str | Path) -> bytes:
+    """Regenerate the unique complete DWO-03-to-DWO-04 scoped patch bytes."""
+
+    root = Path(project).absolute()
+    baseline_payload = _read_regular_file(
+        root / DWO03_PACKAGE_ARCHIVE_PATH,
+        purpose="canonical candidate-patch baseline",
+    )
+    if (
+        len(baseline_payload) != 744_862
+        or _sha256_bytes(baseline_payload) != DWO03_CANDIDATE_PACKAGE_SHA256
+    ):
+        raise ReleaseError("canonical candidate-patch baseline is not exact DWO-03")
+    target_entries = _candidate_source_entries(root)
+    with tempfile.TemporaryDirectory(
+        prefix="nme001-dwo04-canonical-patch-"
+    ) as temporary:
+        baseline = Path(temporary) / "baseline"
+        baseline.mkdir()
+        try:
+            with zipfile.ZipFile(io.BytesIO(baseline_payload)) as archive:
+                archive.extractall(baseline)
+        except zipfile.BadZipFile as exc:  # pragma: no cover - exact hash is pinned
+            raise ReleaseError("canonical candidate-patch baseline is unreadable") from exc
+        _run_git_bytes(
+            ["git", "init", "--quiet"],
+            cwd=baseline,
+            purpose="initialize canonical candidate-patch repository",
+        )
+        for key, value in (
+            ("user.name", "NME001 deterministic release"),
+            ("user.email", "nme001-release.invalid"),
+            ("core.autocrlf", "false"),
+            ("core.filemode", "false"),
+            ("core.hooksPath", os.devnull),
+            ("core.quotePath", "true"),
+        ):
+            _run_git_bytes(
+                ["git", "config", key, value],
+                cwd=baseline,
+                purpose="configure canonical candidate-patch repository",
+            )
+        _run_git_bytes(
+            ["git", "add", "-f", "-A"],
+            cwd=baseline,
+            purpose="stage exact DWO-03 candidate baseline",
+        )
+        _run_git_bytes(
+            [
+                "git",
+                "commit",
+                "--quiet",
+                "--no-gpg-sign",
+                "--no-verify",
+                "-m",
+                "exact DWO-03 baseline",
+            ],
+            cwd=baseline,
+            purpose="commit exact DWO-03 candidate baseline",
+        )
+        for relative in _CANDIDATE_SNAPSHOT_PATHS:
+            target = baseline / relative
+            if target.is_symlink():
+                raise ReleaseError("exact DWO-03 scoped baseline contains a symlink")
+            if target.is_dir():
+                shutil.rmtree(target)
+            elif target.exists():
+                target.unlink()
+        for name, source in target_entries.items():
+            target = baseline / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(source, target)
+        _run_git_bytes(
+            ["git", "add", "-f", "-A", "--", *_CANDIDATE_SNAPSHOT_PATHS],
+            cwd=baseline,
+            purpose="stage complete DWO-04 scoped target",
+        )
+        patch = _run_git_bytes(
+            [
+                "git",
+                "diff",
+                "--cached",
+                "--binary",
+                "--full-index",
+                "--no-ext-diff",
+                "--no-renames",
+                "--no-color",
+                "--unified=3",
+                "--src-prefix=a/",
+                "--dst-prefix=b/",
+                "HEAD",
+                "--",
+                *_CANDIDATE_SNAPSHOT_PATHS,
+            ],
+            cwd=baseline,
+            purpose="regenerate complete canonical DWO-04 candidate patch",
+        )
+    if not patch.startswith(b"diff --git ") or not patch.endswith(b"\n"):
+        raise ReleaseError("canonical DWO-04 candidate patch is empty or malformed")
+    return patch
+
+
+def write_canonical_candidate_patch(
+    *,
+    project_root: str | Path,
+    output_path: str | Path,
+) -> dict[str, object]:
+    root = Path(project_root).absolute()
+    output = Path(output_path).absolute()
+    if output != root / CANDIDATE_DIFF_ARCHIVE_PATH:
+        raise ReleaseError(
+            f"candidate patch output must be {CANDIDATE_DIFF_ARCHIVE_PATH}"
+        )
+    if output.exists() or output.is_symlink():
+        raise ReleaseError("candidate patch output must be absent")
+    payload = canonical_candidate_patch_bytes(root)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_bytes(payload)
+    output.chmod(0o644)
+    return {
+        "status": "PASS",
+        "path": CANDIDATE_DIFF_ARCHIVE_PATH,
+        "size_bytes": len(payload),
+        "sha256": _sha256_bytes(payload),
+    }
+
