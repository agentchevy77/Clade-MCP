+def package_candidate(**kwargs: object) -> dict[str, object]:
+    """Supply the mandatory two-case licensed PASS input for package unit tests."""
+
+    output = Path(kwargs["output_path"])
+    output.parent.mkdir(parents=True, exist_ok=True)
+    if "licensed_junit_path" not in kwargs:
+        kwargs["licensed_junit_path"] = _junit(
+            output.parent / f".{output.name}.licensed-input.xml",
+            names=("test_hermetic", "test_licensed"),
+        )
+    return _release_package_candidate(**kwargs)  # type: ignore[arg-type]
