+    "forged_fold",
+    [True, 0, -1, 1.0, 1.2, "0", "-1", "1.0", "01", "+1"],
+)
+def test_direct_reconciliation_rejects_coercible_or_noncanonical_fold(
+    forged_fold: object,
+) -> None:
